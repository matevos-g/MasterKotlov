<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-950 text-slate-100">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MasterKotlov Admin - Կառավարման Պանել</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Noto+Sans+Armenian:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="/supabase-config.js"></script>
		<style>
			body { font-family: 'Outfit', 'Noto Sans Armenian', sans-serif; }
			.tab-btn.active { border-color: #3b82f6; color: #60a5fa; background-color: rgba(59, 130, 246, 0.1); }
		</style>
	</head>
	<body class="min-h-full flex flex-col">
		<!-- Top Bar -->
		<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-900/90 backdrop-blur-md">
			<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
				<div class="flex items-center gap-3">
					<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 font-bold text-white shadow-md shadow-blue-500/20">
						MK
					</div>
					<div>
						<h1 class="text-lg font-bold text-white leading-tight">MasterKotlov</h1>
						<p class="text-xs text-slate-400">Ադմինիստրատորի Պանել</p>
					</div>
				</div>

				<div class="flex items-center gap-4">
					<span id="user-email-badge" class="hidden text-xs text-slate-400 sm:inline-block font-mono bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700/50">...</span>
					<a href="/" target="_blank" class="flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-white transition bg-slate-800 hover:bg-slate-700 px-3 py-2 rounded-xl">
						<span>Կայք</span>
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
						</svg>
					</a>
					<button id="logout-btn" type="button" class="rounded-xl border border-red-500/30 bg-red-500/10 px-3.5 py-2 text-xs font-semibold text-red-400 hover:bg-red-500/20 hover:text-red-300 transition">
						Ելք
					</button>
				</div>
			</div>
		</header>

		<!-- Main Content Area -->
		<main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 lg:px-8">
			<!-- Stats Widgets -->
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-lg">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ապրանքներ</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500/10 text-blue-400">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
						</span>
					</div>
					<div class="mt-3 text-3xl font-bold text-white" id="stat-products-count">-</div>
					<p class="mt-1 text-xs text-slate-500">Ակտիվ տեսականի</p>
				</div>

				<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-lg">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Նոր Հայտեր</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-400">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
						</span>
					</div>
					<div class="mt-3 text-3xl font-bold text-amber-400" id="stat-new-orders-count">-</div>
					<p class="mt-1 text-xs text-slate-500">Չմշակված պատվերներ</p>
				</div>

				<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-lg">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ընթացքի Մեջ</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-400">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						</span>
					</div>
					<div class="mt-3 text-3xl font-bold text-indigo-400" id="stat-inprogress-orders-count">-</div>
					<p class="mt-1 text-xs text-slate-500">Սպասարկվող հայտեր</p>
				</div>

				<div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 shadow-lg">
					<div class="flex items-center justify-between">
						<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ավարտված</span>
						<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-400">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						</span>
					</div>
					<div class="mt-3 text-3xl font-bold text-emerald-400" id="stat-completed-orders-count">-</div>
					<p class="mt-1 text-xs text-slate-500">Կատարված պատվերներ</p>
				</div>
			</div>

			<!-- Tabs Navigation -->
			<div class="mt-8 flex border-b border-slate-800 gap-2">
				<button id="tab-orders-btn" type="button" class="tab-btn active flex items-center gap-2 border-b-2 px-4 py-3 text-sm font-semibold transition hover:text-blue-400">
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
					<span>Սպասարկման Հայտեր / Պատվերներ</span>
				</button>
				<button id="tab-products-btn" type="button" class="tab-btn flex items-center gap-2 border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-slate-400 transition hover:text-blue-400">
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
					<span>Ապրանքների Կառավարում</span>
				</button>
			</div>

			<!-- TAB 1: ORDERS / SERVICE REQUESTS -->
			<section id="section-orders" class="mt-6 space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<h2 class="text-xl font-bold text-white">Մուտքային Հայտեր</h2>
					<div class="flex items-center gap-2">
						<select id="orders-status-filter" class="rounded-xl border border-slate-800 bg-slate-900 px-3.5 py-2 text-xs font-semibold text-slate-300 outline-none focus:border-blue-500">
							<option value="all">Բոլորը</option>
							<option value="new">Նոր</option>
							<option value="in_progress">Ընթացքի մեջ</option>
							<option value="completed">Ավարտված</option>
							<option value="cancelled">Չեղարկված</option>
						</select>
						<button id="refresh-orders-btn" type="button" class="rounded-xl bg-slate-800 p-2 text-slate-400 hover:text-white transition">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
						</button>
					</div>
				</div>

				<div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl">
					<table class="w-full text-left text-sm text-slate-300">
						<thead class="bg-slate-900/80 text-xs font-semibold uppercase text-slate-400 border-b border-slate-800">
							<tr>
								<th class="px-5 py-3.5">Ամսաթիվ</th>
								<th class="px-5 py-3.5">Հաճախորդ</th>
								<th class="px-5 py-3.5">Հեռախոս</th>
								<th class="px-5 py-3.5">Ապրանք / Խնդիր</th>
								<th class="px-5 py-3.5">Կարգավիճակ</th>
								<th class="px-5 py-3.5 text-right">Գործողություն</th>
							</tr>
						</thead>
						<tbody id="orders-table-body" class="divide-y divide-slate-800/60">
							<tr><td colspan="6" class="p-6 text-center text-slate-500">Բեռնվում է...</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- TAB 2: PRODUCTS MANAGEMENT -->
			<section id="section-products" class="hidden mt-6 space-y-4">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<h2 class="text-xl font-bold text-white">Ապրանքներ</h2>
					<button id="add-product-btn" type="button" class="flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white shadow-lg shadow-blue-600/30 hover:bg-blue-500 transition">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
						<span>Ավելացնել Ապրանք</span>
					</button>
				</div>

				<div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow-xl">
					<table class="w-full text-left text-sm text-slate-300">
						<thead class="bg-slate-900/80 text-xs font-semibold uppercase text-slate-400 border-b border-slate-800">
							<tr>
								<th class="px-5 py-3.5">Նկար</th>
								<th class="px-5 py-3.5">Անվանում</th>
								<th class="px-5 py-3.5">Գին</th>
								<th class="px-5 py-3.5">Թոփ?</th>
								<th class="px-5 py-3.5 text-right">Գործողություն</th>
							</tr>
						</thead>
						<tbody id="products-table-body" class="divide-y divide-slate-800/60">
							<tr><td colspan="5" class="p-6 text-center text-slate-500">Բեռնվում է...</td></tr>
						</tbody>
					</table>
				</div>
			</section>
		</main>

		<!-- PRODUCT EDIT / ADD MODAL -->
		<div id="product-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/70 backdrop-blur-sm">
			<div class="flex min-h-screen items-center justify-center p-4">
				<div class="relative w-full max-w-lg rounded-3xl border border-slate-800 bg-slate-900 p-6 shadow-2xl sm:p-8">
					<button id="close-product-modal" type="button" class="absolute right-4 top-4 text-slate-400 hover:text-white">
						<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
					</button>
					<h3 id="product-modal-title" class="text-xl font-bold text-white mb-6">Ավելացնել Ապրանք</h3>

					<form id="product-form" class="space-y-4">
						<input type="hidden" id="prod-id" />
						<div>
							<label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Անվանում *</label>
							<input type="text" id="prod-name" required class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 text-sm text-white outline-none focus:border-blue-500" />
						</div>
						<div>
							<label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Գին *</label>
							<input type="text" id="prod-price" required placeholder="25000 դրամ" class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 text-sm text-white outline-none focus:border-blue-500" />
						</div>
						<div>
							<label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Համառոտ Նկարագրություն *</label>
							<textarea id="prod-desk" rows="2" required class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 text-sm text-white outline-none focus:border-blue-500 resize-none"></textarea>
						</div>
						<div>
							<label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Նկարի URL-ներ (ստորակետով բաժանված) *</label>
							<input type="text" id="prod-images" placeholder="/parts/1/photo_1.jpg, https://..." class="w-full rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 text-sm text-white outline-none focus:border-blue-500" />
						</div>
						<div class="flex items-center gap-2 pt-1">
							<input type="checkbox" id="prod-top" class="h-4 w-4 rounded border-slate-700 bg-slate-800 text-blue-600 focus:ring-blue-500" />
							<label for="prod-top" class="text-sm font-semibold text-slate-300">Ցուցադրել Գլխավոր Էջում (Top Product)</label>
						</div>

						<div id="prod-form-error" class="hidden rounded-xl bg-red-500/10 p-3 text-xs text-red-400 border border-red-500/20"></div>

						<button type="submit" id="save-product-btn" class="w-full rounded-xl bg-blue-600 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/30 hover:bg-blue-500 transition">
							Պահպանել
						</button>
					</form>
				</div>
			</div>
		</div>

		<script>
			let allOrders = [];
			let allProducts = [];

			// Auth check
			async function initAuth() {
				if (!window.supabaseClient) {
					alert('Supabase-ը կարգավորված չէ supabase-config.js ֆայլում։');
					window.location.href = '/admin/login/';
					return;
				}

				const { data: { session } } = await window.supabaseClient.auth.getSession();
				if (!session) {
					window.location.href = '/admin/login/';
					return;
				}

				const userEmail = session.user.email || '';
				const usernameDisplay = userEmail.endsWith('@masterkotlov.am') ? userEmail.replace('@masterkotlov.am', '') : userEmail;
				document.getElementById('user-email-badge').textContent = usernameDisplay;
				loadData();
			}

			const tabOrdersBtn = document.getElementById('tab-orders-btn');
			const tabProductsBtn = document.getElementById('tab-products-btn');
			const sectionOrders = document.getElementById('section-orders');
			const sectionProducts = document.getElementById('section-products');

			tabOrdersBtn.addEventListener('click', () => {
				tabOrdersBtn.classList.add('active');
				tabProductsBtn.classList.remove('active');
				sectionOrders.classList.remove('hidden');
				sectionProducts.classList.add('hidden');
			});

			tabProductsBtn.addEventListener('click', () => {
				tabProductsBtn.classList.add('active');
				tabOrdersBtn.classList.remove('active');
				sectionProducts.classList.remove('hidden');
				sectionOrders.classList.add('hidden');
			});

			async function loadData() {
				await Promise.all([fetchOrders(), fetchProducts()]);
			}

			async function fetchOrders() {
				try {
					const { data, error } = await window.supabaseClient
						.from('service_requests')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error) {
						allOrders = data || [];
						renderOrders();
						updateStats();
					}
				} catch (err) {
					console.error('Failed to fetch orders:', err);
				}
			}

			async function fetchProducts() {
				try {
					const { data, error } = await window.supabaseClient
						.from('products')
						.select('*')
						.order('id', { ascending: true });

					if (!error && data && data.length) {
						allProducts = data;
					} else {
						// Fallback fetch
						const res = await fetch('/api/products.json');
						if (res.ok) allProducts = await res.json();
					}
					renderProducts();
					updateStats();
				} catch (err) {
					console.error('Failed to fetch products:', err);
				}
			}

			function updateStats() {
				document.getElementById('stat-products-count').textContent = allProducts.length;
				document.getElementById('stat-new-orders-count').textContent = allOrders.filter(o => o.status === 'new').length;
				document.getElementById('stat-inprogress-orders-count').textContent = allOrders.filter(o => o.status === 'in_progress').length;
				document.getElementById('stat-completed-orders-count').textContent = allOrders.filter(o => o.status === 'completed').length;
			}

			function renderOrders() {
				const filter = document.getElementById('orders-status-filter').value;
				const tbody = document.getElementById('orders-table-body');
				const filtered = filter === 'all' ? allOrders : allOrders.filter(o => o.status === filter);

				if (!filtered.length) {
					tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-500">Հայտեր չեն գտնվել</td></tr>`;
					return;
				}

				tbody.innerHTML = filtered.map(o => {
					const dateStr = new Date(o.created_at).toLocaleDateString('hy-AM', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
					const statusBadges = {
						new: '<span class="rounded-lg bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-400 border border-amber-500/20">Նոր</span>',
						in_progress: '<span class="rounded-lg bg-indigo-500/10 px-2.5 py-1 text-xs font-semibold text-indigo-400 border border-indigo-500/20">Ընթացքի մեջ</span>',
						completed: '<span class="rounded-lg bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/20">Ավարտված</span>',
						cancelled: '<span class="rounded-lg bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-400 border border-red-500/20">Չեղարկված</span>'
					};

					return `
						<tr class="hover:bg-slate-800/40 transition">
							<td class="px-5 py-4 whitespace-nowrap text-xs text-slate-400">${dateStr}</td>
							<td class="px-5 py-4 font-semibold text-white">${escapeHtml(o.first_name || '')} ${escapeHtml(o.last_name || '')}</td>
							<td class="px-5 py-4 text-xs font-mono text-blue-400"><a href="tel:${escapeHtml(o.phone)}">${escapeHtml(o.phone)}</a></td>
							<td class="px-5 py-4 max-w-xs">
								${o.product_name ? `<span class="inline-block mb-1 text-xs font-semibold text-blue-300 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20">${escapeHtml(o.product_name)}</span><br/>` : ''}
								<span class="text-xs text-slate-300 line-clamp-2">${escapeHtml(o.problem_description || '')}</span>
							</td>
							<td class="px-5 py-4 whitespace-nowrap">${statusBadges[o.status] || o.status}</td>
							<td class="px-5 py-4 whitespace-nowrap text-right space-x-2">
								<select onchange="updateOrderStatus('${o.id}', this.value)" class="rounded-lg border border-slate-700 bg-slate-800 px-2 py-1 text-xs text-slate-200 outline-none">
									<option value="new" ${o.status === 'new' ? 'selected' : ''}>Նոր</option>
									<option value="in_progress" ${o.status === 'in_progress' ? 'selected' : ''}>Ընթացքի մեջ</option>
									<option value="completed" ${o.status === 'completed' ? 'selected' : ''}>Ավարտված</option>
									<option value="cancelled" ${o.status === 'cancelled' ? 'selected' : ''}>Չեղարկված</option>
								</select>
							</td>
						</tr>
					`;
				}).join('');
			}

			function renderProducts() {
				const tbody = document.getElementById('products-table-body');
				if (!allProducts.length) {
					tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-500">Ապրանքներ չկան</td></tr>`;
					return;
				}

				tbody.innerHTML = allProducts.map(p => `
					<tr class="hover:bg-slate-800/40 transition">
						<td class="px-5 py-3">
							<img src="${escapeHtml(p.image || (p.images && p.images[0]) || '/images/products/placeholder.jpg')}" class="h-12 w-12 rounded-xl object-cover border border-slate-700" />
						</td>
						<td class="px-5 py-3 font-semibold text-white">${escapeHtml(p.name)}</td>
						<td class="px-5 py-3 text-sm text-slate-300">${escapeHtml(p.price)}</td>
						<td class="px-5 py-3">
							${p.top ? '<span class="text-xs bg-emerald-500/10 text-emerald-400 font-semibold px-2.5 py-1 rounded-lg border border-emerald-500/20">Այո</span>' : '<span class="text-xs text-slate-500">Ոչ</span>'}
						</td>
						<td class="px-5 py-3 text-right space-x-2">
							<button onclick="editProduct(${p.id})" class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-semibold text-blue-400 hover:bg-slate-700 transition">Խմբագրել</button>
							<button onclick="deleteProduct(${p.id})" class="rounded-lg bg-red-500/10 px-3 py-1.5 text-xs font-semibold text-red-400 hover:bg-red-500/20 transition">Ջնջել</button>
						</td>
					</tr>
				`).join('');
			}

			async function updateOrderStatus(orderId, newStatus) {
				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.update({ status: newStatus })
						.eq('id', orderId);

					if (!error) fetchOrders();
				} catch (err) {
					alert('Կարգավիճակի փոփոխումը ձախողվեց');
				}
			}

			function editProduct(id) {
				const prod = allProducts.find(p => p.id === id);
				if (!prod) return;
				document.getElementById('prod-id').value = prod.id;
				document.getElementById('prod-name').value = prod.name;
				document.getElementById('prod-price').value = prod.price;
				document.getElementById('prod-desk').value = prod.desk;
				document.getElementById('prod-images').value = (prod.images || []).join(', ');
				document.getElementById('prod-top').checked = Boolean(prod.top);
				document.getElementById('product-modal-title').textContent = 'Խմբագրել Ապրանքը';
				document.getElementById('product-modal').classList.remove('hidden');
			}

			async function deleteProduct(id) {
				if (!confirm('Վստա՞հ եք, որ ցանկանում եք ջնջել այս ապրանքը:')) return;
				try {
					const { error } = await window.supabaseClient.from('products').delete().eq('id', id);
					if (!error) fetchProducts();
				} catch (err) {
					alert('Ջնջումը ձախողվեց');
				}
			}

			document.getElementById('add-product-btn').addEventListener('click', () => {
				document.getElementById('prod-id').value = '';
				document.getElementById('product-form').reset();
				document.getElementById('product-modal-title').textContent = 'Ավելացնել Ապրանք';
				document.getElementById('product-modal').classList.remove('hidden');
			});

			document.getElementById('close-product-modal').addEventListener('click', () => {
				document.getElementById('product-modal').classList.add('hidden');
			});

			document.getElementById('product-form').addEventListener('submit', async (e) => {
				e.preventDefault();
				const id = document.getElementById('prod-id').value;
				const imagesStr = document.getElementById('prod-images').value.trim();
				const images = imagesStr ? imagesStr.split(',').map(s => s.trim()).filter(Boolean) : [];

				const payload = {
					name: document.getElementById('prod-name').value.trim(),
					price: document.getElementById('prod-price').value.trim(),
					desk: document.getElementById('prod-desk').value.trim(),
					images,
					top: document.getElementById('prod-top').checked
				};

				try {
					if (id) {
						await window.supabaseClient.from('products').update(payload).eq('id', id);
					} else {
						await window.supabaseClient.from('products').insert([payload]);
					}
					document.getElementById('product-modal').classList.add('hidden');
					fetchProducts();
				} catch (err) {
					alert('Սխալ պահպանման ընթացքում');
				}
			});

			document.getElementById('orders-status-filter').addEventListener('change', renderOrders);
			document.getElementById('refresh-orders-btn').addEventListener('click', fetchOrders);
			document.getElementById('logout-btn').addEventListener('click', async () => {
				await window.supabaseClient.auth.signOut();
				window.location.href = '/admin/login/';
			});

			function escapeHtml(str) {
				return String(str || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
			}

			initAuth();
		</script>
	</body>
</html>
