	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MasterKotlov Admin Router</title>
		<script>
			(function() {
				const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
				if (isMobile) {
					window.location.href = '/admin/mobile/';
				} else {
					window.location.href = '/admin/web/';
				}
			})();
		</script>
	</head>
	<body style="font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f8fafc; color: #64748b;">
