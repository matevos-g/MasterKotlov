<!DOCTYPE html>
<html lang="hy">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<title>MasterKotlov Admin Router</title>
		<!-- PWA Manifest & iOS Standalone Meta Tags -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="MasterKotlov" />
		<link rel="apple-touch-icon" href="/images/icon.svg" />
		<meta name="theme-color" content="#2563eb" />
		<script>
			(function() {
				const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
				if (isMobile) {
					window.location.replace('/admin/mobile/');
				} else {
					window.location.replace('/admin/web/');
				}
			})();
		</script>
	</head>
	<body style="font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f8fafc; color: #64748b;">
		<p>Վերահասցեավորում...</p>
	</body>
</html>
