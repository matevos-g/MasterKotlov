<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-50 text-slate-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MasterKotlov - Կառավարման Համակարգ</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Armenian:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="/supabase-config.js"></script>
		<style>
			body { font-family: 'Inter', 'Noto Sans Armenian', sans-serif; }
			.nav-btn.active { color: #2563eb; border-bottom: 2px solid #2563eb; font-weight: 600; }
			.order-tab.active { background-color: #ffffff; color: #0f172a; font-weight: 600; shadow: 0 1px 2px rgba(0,0,0,0.05); }
		</style>
	</head>
	<body class="min-h-full flex flex-col bg-slate-50">
		<!-- Top Navigation Header -->
		<header class="sticky top-0 z-30 border-b border-slate-200 bg-white">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-4 sm:px-6">
				<div class="flex items-center gap-8">
					<div class="py-4">
						<span class="text-base font-bold text-slate-900 tracking-tight">MasterKotlov</span>
						<span class="ml-2 text-xs font-semibold text-slate-400">WEB ADMIN</span>
					</div>

					<!-- 4 Main Navigation Pages -->
					<nav class="hidden sm:flex items-center gap-1">
						<button id="nav-page-orders" type="button" class="nav-btn active px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Պատվերներ
						</button>
						<button id="nav-page-finance" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Ֆինանսներ
						</button>
						<button id="nav-page-products" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Ապրանքներ
						</button>
						<button id="nav-page-users" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Օգտատերեր
						</button>
					</nav>
				</div>

				<div class="flex items-center gap-3">
					<span id="admin-user-badge" class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">admin</span>
					<button id="logout-btn" type="button" class="text-xs font-medium text-slate-600 hover:text-red-600 border border-slate-200 hover:border-red-200 hover:bg-red-50 px-3 py-1.5 rounded-lg transition">
						Ելք
					</button>
				</div>
			</div>

			<!-- Mobile Main Nav Tabs -->
			<div class="flex sm:hidden border-t border-slate-100 overflow-x-auto px-2">
				<button id="mobile-nav-orders" class="nav-btn active flex-1 py-2.5 text-xs text-center font-medium">Պատվերներ</button>
				<button id="mobile-nav-finance" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">Ֆինանսներ</button>
				<button id="mobile-nav-products" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">Ապրանքներ</button>
				<button id="mobile-nav-users" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">Օգտատերեր</button>
			</div>
		</header>

		<!-- Main Container -->
		<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">

			<!-- ========================================== -->
			<!-- PAGE 1: ORDERS (ՊԱՏՎԵՐՆԵՐ)                  -->
			<!-- ========================================== -->
			<section id="page-orders" class="space-y-4">
				<!-- 4 Armenian Sub-tabs -->
				<div class="flex items-center justify-between border-b border-slate-200 pb-3">
					<div class="flex rounded-xl bg-slate-200/60 p-1 text-xs">
						<button id="tab-order-pending" type="button" class="order-tab active rounded-lg px-3.5 py-1.5 text-slate-600 transition">
							Սպասող (<span id="count-pending">0</span>)
						</button>
						<button id="tab-order-inprogress" type="button" class="order-tab rounded-lg px-3.5 py-1.5 text-slate-600 transition">
							Ընթացքի մեջ (<span id="count-inprogress">0</span>)
						</button>
						<button id="tab-order-completed" type="button" class="order-tab rounded-lg px-3.5 py-1.5 text-slate-600 transition">
							Ավարտված (<span id="count-completed">0</span>)
						</button>
						<button id="tab-order-cancelled" type="button" class="order-tab rounded-lg px-3.5 py-1.5 text-slate-600 transition">
							Չեղարկված (<span id="count-cancelled">0</span>)
						</button>
					</div>

					<button id="refresh-orders-btn" class="text-xs font-medium text-slate-500 hover:text-slate-900 bg-white border border-slate-200 rounded-lg px-3 py-1.5 shadow-sm transition">
						Թարմացնել
					</button>
				</div>

				<!-- Orders Table -->
				<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
					<table class="w-full text-left text-xs sm:text-sm">
						<thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase border-b border-slate-200">
							<tr>
								<th class="px-4 py-3">Անուն</th>
								<th class="px-4 py-3">Ամսաթիվ</th>
								<th class="px-4 py-3">Հեռախոս</th>
								<th class="px-4 py-3">Կարգավիճակ</th>
								<th class="px-4 py-3 text-right">Գործողություն</th>
							</tr>
						</thead>
						<tbody id="orders-tbody" class="divide-y divide-slate-100">
							<tr><td colspan="5" class="p-6 text-center text-slate-400">Բեռնվում է...</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 2: FINANCE (ՖԻՆԱՆՍՆԵՐ)                  -->
			<!-- ========================================== -->
			<section id="page-finance" class="hidden space-y-6">
				<!-- Filter Controls & Big Earnings Display -->
				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
					<div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4">
						<div>
							<h2 class="text-lg font-bold text-slate-900">Ֆինանսական Ամփոփում</h2>
							<p class="text-xs text-slate-500">Եկամուտների հաշվառման մատյան</p>
						</div>

						<div class="flex items-center gap-2">
							<label class="text-xs text-slate-500 font-medium">Ժամանակահատված:</label>
							<select id="finance-range-select" class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 outline-none focus:border-blue-600">
								<option value="current_month">Այս Ամիս</option>
								<option value="last_month">Անցյալ Ամիս</option>
								<option value="current_year">Այս Տարի</option>
								<option value="all">Ամբողջ Ժամանակահատվածը</option>
							</select>
						</div>
					</div>

					<div class="mt-6">
						<span class="text-xs font-semibold uppercase text-slate-400 tracking-wider">Ընդհանուր Եկամուտ</span>
						<div class="mt-1 text-3xl font-extrabold text-slate-900 tracking-tight" id="total-earnings-display">
							0 Դրամ
						</div>
					</div>
				</div>

				<!-- Recent Ledger Info Table -->
				<div class="space-y-3">
					<h3 class="text-sm font-semibold text-slate-900">Վերջին Գործարքները</h3>
					<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
						<table class="w-full text-left text-xs sm:text-sm">
							<thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase border-b border-slate-200">
								<tr>
									<th class="px-4 py-3">Ամսաթիվ</th>
									<th class="px-4 py-3">Հաճախորդ</th>
									<th class="px-4 py-3">Նկարագրություն / Պատվեր</th>
									<th class="px-4 py-3 text-right">Գումար</th>
								</tr>
							</thead>
							<tbody id="ledger-tbody" class="divide-y divide-slate-100">
								<tr><td colspan="4" class="p-6 text-center text-slate-400">Գործարքներ չկան</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 3: PRODUCTS (ԱՊՐԱՆՔՆԵՐ)                 -->
			<!-- ========================================== -->
			<section id="page-products" class="hidden space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-bold text-slate-900">Ապրանքների Տեսականի</h2>
					<a href="/admin/web/products/new/" class="rounded-lg bg-blue-600 px-3.5 py-2 text-xs font-medium text-white shadow-sm hover:bg-blue-700 transition">
						+ Ավելացնել Ապրանք
					</a>

				</div>

				<div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
					<table class="w-full text-left text-xs sm:text-sm">
						<thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase border-b border-slate-200">
							<tr>
								<th class="px-4 py-3">Նկար</th>
								<th class="px-4 py-3">Անվանում</th>
								<th class="px-4 py-3">Գին</th>
								<th class="px-4 py-3">Թոփ?</th>
								<th class="px-4 py-3 text-right">Գործողություն</th>
							</tr>
						</thead>
						<tbody id="products-tbody" class="divide-y divide-slate-100">
							<tr><td colspan="5" class="p-6 text-center text-slate-400">Բեռնվում է...</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 4: USERS (ՕԳՏԱՏԵՐԵՐ)                   -->
			<!-- ========================================== -->
			<section id="page-users" class="hidden space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-lg font-bold text-slate-900">Ադմինիստրատորներ</h2>
				</div>

				<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm max-w-lg space-y-4">
					<div class="flex items-center justify-between border-b border-slate-100 pb-3">
						<div>
							<div class="text-sm font-semibold text-slate-900" id="current-user-email">admin@masterkotlov.am</div>
							<span class="text-xs text-emerald-600 font-medium">● Ակտիվ Ադմինիստրատոր</span>
						</div>
					</div>
					<p class="text-xs text-slate-500 leading-relaxed">
						Supabase Auth համակարգով ադմինիստրատորների ավելացումը կատարվում է Supabase Dashboard-ից։
					</p>
				</div>
			</section>

		</main>

		<!-- ========================================== -->
		<!-- MODAL 1: ORDER DETAILS MODAL               -->
		<!-- ========================================== -->
		<div id="modal-order-details" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<div class="flex items-center justify-between border-b border-slate-100 pb-3">
					<h3 class="text-base font-bold text-slate-900">Պատվերի Մանրամասներ</h3>
					<button onclick="closeModal('modal-order-details')" class="text-slate-400 hover:text-slate-700 text-sm">✕</button>
				</div>

				<div class="space-y-3 text-xs sm:text-sm">
					<div>
						<span class="text-xs font-medium text-slate-400 uppercase">Հաճախորդ</span>
						<div id="detail-client-name" class="font-semibold text-slate-900"></div>
					</div>
					<div>
						<span class="text-xs font-medium text-slate-400 uppercase">Հեռախոս</span>
						<div id="detail-client-phone" class="font-mono text-blue-600"></div>
					</div>
					<div id="detail-product-box" class="hidden">
						<span class="text-xs font-medium text-slate-400 uppercase">Ապրանք</span>
						<div id="detail-product-name" class="font-medium text-slate-800 bg-slate-50 p-2 rounded-lg border border-slate-100 mt-1"></div>
					</div>
					<div>
						<span class="text-xs font-medium text-slate-400 uppercase">Խնդրի Նկարագրություն</span>
						<div id="detail-problem-text" class="mt-1 rounded-lg bg-slate-50 p-3 text-slate-700 leading-relaxed border border-slate-100 whitespace-pre-wrap"></div>
					</div>
					<div>
						<span class="text-xs font-medium text-slate-400 uppercase">Կարգավիճակ</span>
						<div id="detail-status-badge" class="mt-1"></div>
					</div>
				</div>

				<div id="detail-modal-actions" class="flex justify-end gap-2 pt-3 border-t border-slate-100">
					<!-- Action buttons injected dynamically -->
				</div>
			</div>
		</div>

		<!-- ========================================== -->
		<!-- MODAL 2: EARNINGS AMOUNT ENTRY MODAL       -->
		<!-- ========================================== -->
		<div id="modal-earnings" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<h3 class="text-base font-bold text-slate-900">Ավարտել Պատվերը</h3>
				<p class="text-xs text-slate-500">Մուտքագրեք այս պատվերից ստացված վերջնական գումարը (Դրամ)՝ ֆինանսական մատյանում գրանցելու համար։</p>

				<form id="form-earnings" class="space-y-4">
					<input type="hidden" id="earnings-order-id" />
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Վաստակած Գումար (Դրամ) *</label>
						<input type="number" id="earnings-amount" min="0" step="1000" required placeholder="25000" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div class="flex justify-end gap-2 pt-2">
						<button type="button" onclick="closeModal('modal-earnings')" class="rounded-lg bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200">Չեղարկել</button>
						<button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-medium text-white hover:bg-blue-700 shadow-sm">Հաստատել և Ավարտել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- ========================================== -->
		<!-- MODAL 3: ARE YOU SURE? CONFIRMATION PROMPT -->
		<!-- ========================================== -->
		<div id="modal-confirm" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4 text-center">
				<div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-red-100 text-red-600 text-lg font-bold">
					!
				</div>
				<h3 class="text-base font-bold text-slate-900" id="confirm-modal-title">Վստա՞հ եք:</h3>
				<p class="text-xs text-slate-500" id="confirm-modal-desc">Այս գործողությունը չի կարող չեղարկվել։</p>

				<div class="flex justify-center gap-3 pt-2">
					<button type="button" onclick="closeModal('modal-confirm')" class="rounded-lg bg-slate-100 px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200">Ոչ, Չեղարկել</button>
					<button id="confirm-action-btn" type="button" class="rounded-lg bg-red-600 px-4 py-2 text-xs font-medium text-white hover:bg-red-700 shadow-sm">Այո, Հաստատել</button>
				</div>
			</div>
		</div>

		<!-- ========================================== -->
		<!-- MODAL 4: PRODUCT EDIT / ADD MODAL          -->
		<!-- ========================================== -->
		<div id="modal-product" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<div class="flex items-center justify-between border-b border-slate-100 pb-3">
					<h3 id="product-modal-title" class="text-base font-bold text-slate-900">Ավելացնել Ապրանք</h3>
					<button onclick="closeModal('modal-product')" class="text-slate-400 hover:text-slate-700 text-sm">✕</button>
				</div>

				<form id="form-product" class="space-y-3">
					<input type="hidden" id="prod-id" />
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Անվանում *</label>
						<input type="text" id="prod-name" required class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Գին *</label>
						<input type="text" id="prod-price" required placeholder="25000 դրամ" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Նկարագրություն *</label>
						<textarea id="prod-desk" rows="2" required class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600 resize-none"></textarea>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Նկարների URL-ներ (ստորակետով բաժանված)</label>
						<input type="text" id="prod-images" placeholder="/parts/1/photo_1.jpg, /parts/1/photo_2.jpg" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div class="flex items-center gap-2 pt-1">
						<input type="checkbox" id="prod-top" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
						<label for="prod-top" class="text-xs font-medium text-slate-700">Ցուցադրել Գլխավոր Էջում (Top Product)</label>
					</div>

					<div class="flex justify-end gap-2 pt-3 border-t border-slate-100">
						<button type="button" onclick="closeModal('modal-product')" class="rounded-lg bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200">Չեղարկել</button>
						<button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-medium text-white hover:bg-blue-700 shadow-sm">Պահպանել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- CLIENT JS SCRIPT -->
		<script>
			let allOrders = [];
			let allProducts = [];
			let allLedger = [];
			let currentOrderTab = 'new';
			let confirmCallback = null;

			// Auth check
			async function initAuth() {
				if (!window.supabaseClient) {
					window.location.href = '/admin/web/login/';
					return;
				}
				const { data: { session } } = await window.supabaseClient.auth.getSession();
				if (!session) {
					window.location.href = '/admin/web/login/';
					return;
				}
				const userEmail = session.user.email || '';
				const usernameDisplay = userEmail.endsWith('@masterkotlov.am') ? userEmail.replace('@masterkotlov.am', '') : userEmail;
				document.getElementById('admin-user-badge').textContent = usernameDisplay;
				document.getElementById('current-user-email').textContent = session.user.email;
				loadAllData();
			}

			// Main Page Switching (Orders, Finance, Products, Users)
			const pages = ['orders', 'finance', 'products', 'users'];
			function switchPage(activePage) {
				pages.forEach(p => {
					const el = document.getElementById(`page-${p}`);
					const btn = document.getElementById(`nav-page-${p}`);
					const mobBtn = document.getElementById(`mobile-nav-${p}`);
					if (p === activePage) {
						el.classList.remove('hidden');
						btn?.classList.add('active');
						mobBtn?.classList.add('active');
					} else {
						el.classList.add('hidden');
						btn?.classList.remove('active');
						mobBtn?.classList.remove('active');
					}
				});
			}

			pages.forEach(p => {
				document.getElementById(`nav-page-${p}`)?.addEventListener('click', () => switchPage(p));
				document.getElementById(`mobile-nav-${p}`)?.addEventListener('click', () => switchPage(p));
			});

			// Order Sub-tabs (Pending, In Progress, Completed, Cancelled)
			const orderTabsMap = {
				'pending': 'new',
				'inprogress': 'in_progress',
				'completed': 'completed',
				'cancelled': 'cancelled'
			};

			Object.keys(orderTabsMap).forEach(key => {
				document.getElementById(`tab-order-${key}`)?.addEventListener('click', () => {
					Object.keys(orderTabsMap).forEach(k => {
						document.getElementById(`tab-order-${k}`).classList.remove('active');
					});
					document.getElementById(`tab-order-${key}`).classList.add('active');
					currentOrderTab = orderTabsMap[key];
					renderOrdersTable();
				});
			});

			// Fetch Data
			async function loadAllData() {
				await Promise.all([fetchOrders(), fetchProducts(), fetchLedger()]);
			}

			async function fetchOrders() {
				try {
					const { data, error } = await window.supabaseClient
						.from('service_requests')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data) {
						allOrders = data;
						updateOrderCounts();
						renderOrdersTable();
					}
				} catch (err) {
					console.error('Fetch orders error:', err);
				}
			}

			async function fetchProducts() {
				try {
					const { data, error } = await window.supabaseClient
						.from('products')
						.select('*')
						.order('id', { ascending: true });

					if (!error && data && data.length) {
						allProducts = data;
					} else {
						const res = await fetch('/api/products.json');
						if (res.ok) allProducts = await res.json();
					}
					renderProductsTable();
				} catch (err) {
					console.error('Fetch products error:', err);
				}
			}

			async function fetchLedger() {
				try {
					const { data, error } = await window.supabaseClient
						.from('finance_ledger')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error) {
						allLedger = data || [];
						renderFinancePage();
					}
				} catch (err) {
					console.error('Fetch ledger error:', err);
				}
			}

			function updateOrderCounts() {
				document.getElementById('count-pending').textContent = allOrders.filter(o => o.status === 'new').length;
				document.getElementById('count-inprogress').textContent = allOrders.filter(o => o.status === 'in_progress').length;
				document.getElementById('count-completed').textContent = allOrders.filter(o => o.status === 'completed').length;
				document.getElementById('count-cancelled').textContent = allOrders.filter(o => o.status === 'cancelled').length;
			}

			function renderOrdersTable() {
				const tbody = document.getElementById('orders-tbody');
				const filtered = allOrders.filter(o => o.status === currentOrderTab);

				if (!filtered.length) {
					tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">Այս բաժնում պատվերներ չկան</td></tr>`;
					return;
				}

				tbody.innerHTML = filtered.map(o => {
					const dateStr = new Date(o.created_at).toLocaleDateString('hy-AM', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
					const statusBadge = getStatusBadgeHTML(o.status);

					let actionButtonsHTML = '';
					if (o.status === 'new') {
						actionButtonsHTML = `
							<button onclick="event.stopPropagation(); changeOrderStatus('${o.id}', 'in_progress')" class="rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 border border-blue-200 px-2.5 py-1 text-xs font-medium">Ընթացքի մեջ</button>
							<button onclick="event.stopPropagation(); promptConfirm('Չեղարկե՞լ պատվերը:', () => changeOrderStatus('${o.id}', 'cancelled'))" class="rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-2 py-1 text-xs font-medium">Չեղարկել</button>
						`;
					} else if (o.status === 'in_progress') {
						actionButtonsHTML = `
							<button onclick="event.stopPropagation(); openEarningsModal('${o.id}')" class="rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 px-2.5 py-1 text-xs font-semibold">Ավարտել</button>
							<button onclick="event.stopPropagation(); promptConfirm('Չեղարկե՞լ պատվերը:', () => changeOrderStatus('${o.id}', 'cancelled'))" class="rounded-lg bg-red-50 text-red-600 hover:bg-red-100 border border-red-200 px-2 py-1 text-xs font-medium">Չեղարկել</button>
						`;
					} else {
						actionButtonsHTML = `<span class="text-xs text-slate-400 font-medium">Դիտել</span>`;
					}

					return `
						<tr onclick="openOrderDetailsModal('${o.id}')" class="hover:bg-slate-50 cursor-pointer transition">
							<td class="px-4 py-3 font-semibold text-slate-900">${escapeHtml(o.first_name || '')} ${escapeHtml(o.last_name || '')}</td>
							<td class="px-4 py-3 text-xs text-slate-500">${dateStr}</td>
							<td class="px-4 py-3 text-xs font-mono text-blue-600"><a href="tel:${escapeHtml(o.phone)}">${escapeHtml(o.phone)}</a></td>
							<td class="px-4 py-3">${statusBadge}</td>
							<td class="px-4 py-3 text-right space-x-1">${actionButtonsHTML}</td>
						</tr>
					`;
				}).join('');
			}

			function getStatusBadgeHTML(status) {
				const badges = {
					new: '<span class="rounded-md bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 border border-amber-200">Սպասող</span>',
					in_progress: '<span class="rounded-md bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700 border border-blue-200">Ընթացքի մեջ</span>',
					completed: '<span class="rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">Ավարտված</span>',
					cancelled: '<span class="rounded-md bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 border border-red-200">Չեղարկված</span>'
				};
				return badges[status] || status;
			}

			// Order Details Modal
			function openOrderDetailsModal(orderId) {
				const o = allOrders.find(item => item.id === orderId);
				if (!o) return;

				document.getElementById('detail-client-name').textContent = `${o.first_name || ''} ${o.last_name || ''}`;
				document.getElementById('detail-client-phone').textContent = o.phone;
				document.getElementById('detail-problem-text').textContent = o.problem_description || 'Նկարագրություն առկա չէ';
				document.getElementById('detail-status-badge').innerHTML = getStatusBadgeHTML(o.status);

				const prodBox = document.getElementById('detail-product-box');
				if (o.product_name) {
					document.getElementById('detail-product-name').textContent = o.product_name;
					prodBox.classList.remove('hidden');
				} else {
					prodBox.classList.add('hidden');
				}

				const actionsContainer = document.getElementById('detail-modal-actions');
				if (o.status === 'new') {
					actionsContainer.innerHTML = `
						<button onclick="promptConfirm('Չեղարկե՞լ պատվերը:', () => { changeOrderStatus('${o.id}', 'cancelled'); closeModal('modal-order-details'); })" class="rounded-lg bg-red-50 text-red-600 border border-red-200 px-3 py-1.5 text-xs font-medium hover:bg-red-100">Չեղարկել</button>
						<button onclick="changeOrderStatus('${o.id}', 'in_progress'); closeModal('modal-order-details');" class="rounded-lg bg-blue-600 text-white px-4 py-1.5 text-xs font-medium hover:bg-blue-700 shadow-sm">Ընթացքի մեջ</button>
					`;
				} else if (o.status === 'in_progress') {
					actionsContainer.innerHTML = `
						<button onclick="promptConfirm('Չեղարկե՞լ պատվերը:', () => { changeOrderStatus('${o.id}', 'cancelled'); closeModal('modal-order-details'); })" class="rounded-lg bg-red-50 text-red-600 border border-red-200 px-3 py-1.5 text-xs font-medium hover:bg-red-100">Չեղարկել</button>
						<button onclick="closeModal('modal-order-details'); openEarningsModal('${o.id}');" class="rounded-lg bg-emerald-600 text-white px-4 py-1.5 text-xs font-medium hover:bg-emerald-700 shadow-sm">Ավարտել Պատվերը</button>
					`;
				} else {
					actionsContainer.innerHTML = `<button onclick="closeModal('modal-order-details')" class="rounded-lg bg-slate-100 text-slate-700 px-4 py-1.5 text-xs font-medium hover:bg-slate-200">Փակել</button>`;
				}

				document.getElementById('modal-order-details').classList.remove('hidden');
			}

			// Change Order Status directly
			async function changeOrderStatus(orderId, newStatus) {
				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.update({ status: newStatus })
						.eq('id', orderId);

					if (!error) {
						fetchOrders();
					}
				} catch (err) {
					console.error('Update status error:', err);
				}
			}

			// Open Earnings Entry Modal
			function openEarningsModal(orderId) {
				document.getElementById('earnings-order-id').value = orderId;
				document.getElementById('earnings-amount').value = '';
				document.getElementById('modal-earnings').classList.remove('hidden');
			}

			// Submit Earnings Form -> Creates Finance Ledger Entry + Marks Order Completed
			document.getElementById('form-earnings').addEventListener('submit', async (e) => {
				e.preventDefault();
				const orderId = document.getElementById('earnings-order-id').value;
				const amount = Number(document.getElementById('earnings-amount').value);
				const order = allOrders.find(o => o.id === orderId);

				try {
					// 1. Mark order completed
					await window.supabaseClient
						.from('service_requests')
						.update({ status: 'completed' })
						.eq('id', orderId);

					// 2. Add entry to finance_ledger
					await window.supabaseClient
						.from('finance_ledger')
						.insert([{
							order_id: orderId,
							amount: amount,
							client_name: order ? `${order.first_name || ''} ${order.last_name || ''}`.trim() : 'Հաճախորդ',
							notes: order ? (order.product_name || order.problem_description || '') : ''
						}]);

					closeModal('modal-earnings');
					fetchOrders();
					fetchLedger();
				} catch (err) {
					alert('Սխալ պատվերը ավարտելիս');
				}
			});

			// Reusable "Are You Sure?" Confirmation Modal
			function promptConfirm(title, onConfirm) {
				document.getElementById('confirm-modal-title').textContent = title || 'Վստա՞հ եք:';
				confirmCallback = onConfirm;
				document.getElementById('modal-confirm').classList.remove('hidden');
			}

			document.getElementById('confirm-action-btn').addEventListener('click', () => {
				if (confirmCallback) confirmCallback();
				closeModal('modal-confirm');
			});

			// Finance Page Logic
			function renderFinancePage() {
				const range = document.getElementById('finance-range-select').value;
				const now = new Date();
				let filteredLedger = allLedger;

				if (range === 'current_month') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
					});
				} else if (range === 'last_month') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);
						return d.getMonth() === lastMonth.getMonth() && d.getFullYear() === lastMonth.getFullYear();
					});
				} else if (range === 'current_year') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getFullYear() === now.getFullYear();
					});
				}

				const total = filteredLedger.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
				document.getElementById('total-earnings-display').textContent = `${total.toLocaleString('hy-AM')} Դրամ`;

				const tbody = document.getElementById('ledger-tbody');
				if (!filteredLedger.length) {
					tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-slate-400">Գործարքներ չկան</td></tr>`;
					return;
				}

				tbody.innerHTML = filteredLedger.map(l => {
					const dateStr = new Date(l.created_at).toLocaleDateString('hy-AM', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
					return `
						<tr class="hover:bg-slate-50 transition">
							<td class="px-4 py-3 text-xs text-slate-500">${dateStr}</td>
							<td class="px-4 py-3 font-semibold text-slate-900">${escapeHtml(l.client_name || '')}</td>
							<td class="px-4 py-3 text-xs text-slate-600 line-clamp-1">${escapeHtml(l.notes || '')}</td>
							<td class="px-4 py-3 text-right font-bold text-emerald-600">+${Number(l.amount).toLocaleString('hy-AM')} Դրամ</td>
						</tr>
					`;
				}).join('');
			}

			document.getElementById('finance-range-select').addEventListener('change', renderFinancePage);

			// Products Table
			function renderProductsTable() {
				const tbody = document.getElementById('products-tbody');
				if (!allProducts.length) {
					tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">Ապրանքներ չկան</td></tr>`;
					return;
				}

				tbody.innerHTML = allProducts.map(p => `
					<tr class="hover:bg-slate-50 transition">
						<td class="px-4 py-2.5">
							<img src="${escapeHtml(p.image || (p.images && p.images[0]) || '/images/products/placeholder.jpg')}" class="h-10 w-10 rounded-lg object-cover border border-slate-200" />
						</td>
						<td class="px-4 py-2.5 font-semibold text-slate-900">${escapeHtml(p.name)}</td>
						<td class="px-4 py-2.5 text-slate-700">${escapeHtml(p.price)}</td>
						<td class="px-4 py-2.5">
							${p.top ? '<span class="text-xs bg-emerald-50 text-emerald-700 font-semibold px-2 py-0.5 rounded border border-emerald-200">Այո</span>' : '<span class="text-xs text-slate-400">Ոչ</span>'}
						</td>
						<td class="px-4 py-2.5 text-right space-x-1">
							<a href="/admin/web/products/${p.id}/" class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200 inline-block">Խմբագրել</a>
							<button onclick="promptConfirm('Ջնջե՞լ այս ապրանքը:', () => deleteProduct(${p.id}))" class="rounded-lg bg-red-50 px-2.5 py-1 text-xs font-medium text-red-600 border border-red-200 hover:bg-red-100">Ջնջել</button>
						</td>
					</tr>
				`).join('');
			}

			async function deleteProduct(id) {
				try {
					const { error } = await window.supabaseClient.from('products').delete().eq('id', id);
					if (!error) fetchProducts();
				} catch (err) {
					alert('Ջնջումը ձախողվեց');
				}
			}

			function closeModal(id) {
				document.getElementById(id)?.classList.add('hidden');
			}


			document.getElementById('refresh-orders-btn')?.addEventListener('click', fetchOrders);
			document.getElementById('logout-btn')?.addEventListener('click', async () => {
				await window.supabaseClient.auth.signOut();
				window.location.href = '/admin/web/login/';
			});

			function escapeHtml(str) {
				return String(str || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c));
			}

			initAuth();
		</script>
	</body>
</html>
