<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-50 text-slate-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<title>MasterKotlov - Կառավարման Համակարգ</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Armenian:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
		<script src="/supabase-config.js"></script>
		<!-- PWA Meta Tags -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="MasterKotlov" />
		<link rel="apple-touch-icon" href="/images/icon.svg" />
		<meta name="theme-color" content="#2563eb" />
		<style>
			body { font-family: 'Inter', 'Noto Sans Armenian', sans-serif; }
			.nav-btn.active { color: #2563eb; border-bottom: 2px solid #2563eb; font-weight: 600; }
		</style>
	</head>
	<body class="min-h-full flex flex-col bg-slate-50">
		<!-- Top Navigation Header -->
		<header class="sticky top-0 z-30 border-b border-slate-200 bg-white">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-4 sm:px-6">
				<div class="flex items-center gap-8">
					<div class="py-4 flex items-center gap-2">
						<span class="text-base font-extrabold text-slate-900 tracking-tight">MasterKotlov</span>
						<span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md border border-blue-100">PWA ADMIN</span>
					</div>

					<!-- 5 Main Navigation Pages -->
					<nav class="hidden sm:flex items-center gap-1">
						<button id="nav-page-orders" type="button" class="nav-btn active px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Պատվերներ
						</button>
						<button id="nav-page-finance" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Ֆինանսներ
						</button>
						<button id="nav-page-products" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Ապրանքներ
						</button>
						<button id="nav-page-users" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							Օգտատերեր
						</button>
						<button id="nav-page-cms" type="button" class="nav-btn px-4 py-4 text-sm font-medium text-slate-600 hover:text-slate-900 transition">
							CMS / Կարգավորումներ
						</button>
					</nav>
				</div>

				<div class="flex items-center gap-3">
					<span id="admin-user-badge" class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200">admin</span>
					<button id="logout-btn" type="button" class="text-xs font-medium text-slate-600 hover:text-red-600 border border-slate-200 hover:border-red-200 hover:bg-red-50 px-3 py-1.5 rounded-lg transition">
						Ելք
					</button>
				</div>
			</div>

			<!-- Mobile Main Nav Tabs -->
			<div class="flex sm:hidden border-t border-slate-100 overflow-x-auto px-2">
				<button id="mobile-nav-orders" class="nav-btn active flex-1 py-2.5 text-xs text-center font-medium">Պատվերներ</button>
				<button id="mobile-nav-finance" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">Ֆինանսներ</button>
				<button id="mobile-nav-products" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">Ապրանքներ</button>
				<button id="mobile-nav-users" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">Օգտատերեր</button>
				<button id="mobile-nav-cms" class="nav-btn flex-1 py-2.5 text-xs text-center font-medium">CMS</button>
			</div>
		</header>

		<!-- Main Container -->
		<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">

			<!-- ========================================== -->
			<!-- PAGE 1: ORDERS (ՊԱՏՎԵՐՆԵՐ)                  -->
			<!-- ========================================== -->
			<section id="page-orders" class="space-y-4">
				<!-- Top Bar: ONLY Status Picker Dropdown + '+' Add Order Button -->
				<div class="flex items-center justify-between gap-3 border-b border-slate-200 pb-3">
					<select id="order-status-select" class="flex-1 max-w-xs rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-800 outline-none focus:border-blue-600 shadow-xs transition cursor-pointer">
						<option value="new">Սպասող</option>
						<option value="in_progress">Ընթացքի մեջ</option>
						<option value="completed">Ավարտված</option>
						<option value="cancelled">Չեղարկված</option>
					</select>

					<button id="add-order-btn" type="button" class="h-10 w-10 shrink-0 flex items-center justify-center rounded-xl bg-blue-600 text-white font-extrabold text-2xl shadow-sm hover:bg-blue-700 active:scale-95 transition" title="Ավելացնել Պատվեր">
						+
					</button>
				</div>

				<!-- Grid List: 1 item per row container -->
				<div id="orders-grid-list" class="space-y-3">
					<div class="p-8 text-center text-slate-400 text-xs">Բեռնվում է...</div>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 2: FINANCE (ՖԻՆԱՆՍՆԵՐ)                  -->
			<!-- ========================================== -->
			<section id="page-finance" class="hidden space-y-8">
				<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm text-center space-y-6">
					<div class="flex items-center justify-center gap-2">
						<label class="text-xs text-slate-500 font-semibold">Ժամանակահատված:</label>
						<select id="finance-range-select" class="rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 text-xs font-bold text-slate-800 outline-none focus:border-blue-600">
							<option value="current_month">Այս Ամիս</option>
							<option value="last_month">Անցյալ Ամիս</option>
							<option value="current_year">Այս Տարի</option>
							<option value="all">Ամբողջ Ժամանակահատվածը</option>
						</select>
					</div>

					<!-- Big Number at Center -->
					<div class="py-4">
						<span class="text-xs font-bold uppercase tracking-widest text-slate-400">Ընդհանուր Եկամուտ</span>
						<div class="mt-2 text-4xl sm:text-5xl font-extrabold text-blue-600 tracking-tight" id="total-earnings-display">
							0 Դրամ
						</div>
					</div>

					<!-- Bar Chart Canvas -->
					<div class="pt-6 border-t border-slate-100 max-w-3xl mx-auto">
						<div class="flex items-center justify-between mb-3 text-left">
							<span class="text-xs font-semibold uppercase text-slate-400 tracking-wider">Եկամուտների Գրաֆիկ</span>
							<span id="chart-subtitle" class="text-xs font-medium text-slate-500"></span>
						</div>
						<div class="h-64 w-full relative">
							<canvas id="finance-chart"></canvas>
						</div>
					</div>
				</div>

				<!-- Down Below: Last 10 Transactions -->
				<div class="space-y-4">
					<h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Վերջին 10 Գործարքները</h3>
					<div id="ledger-grid-list" class="space-y-2.5">
						<div class="p-6 text-center text-slate-400 text-xs">Գործարքներ չկան</div>
					</div>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 3: PRODUCTS (ԱՊՐԱՆՔՆԵՐ)                 -->
			<!-- ========================================== -->
			<section id="page-products" class="hidden space-y-4">
				<div class="flex items-center justify-between border-b border-slate-200 pb-3">
					<h2 class="text-lg font-bold text-slate-900">Ապրանքների Տեսականի</h2>
					<a href="/admin/web/products/new/" class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-blue-700 transition">
						+ Ավելացնել Ապրանք
					</a>
				</div>

				<div id="products-grid-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
					<div class="col-span-full p-8 text-center text-slate-400 text-xs">Բեռնվում է...</div>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 4: USERS (ՕԳՏԱՏԵՐԵՐ)                   -->
			<!-- ========================================== -->
			<section id="page-users" class="hidden space-y-4">
				<div class="flex items-center justify-between border-b border-slate-200 pb-3">
					<h2 class="text-lg font-bold text-slate-900">Ադմինիստրատորներ</h2>
					<button id="add-user-btn" type="button" class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-blue-700 transition">
						+ Ավելացնել Ադմին
					</button>
				</div>

				<div id="users-grid-list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div class="col-span-full p-8 text-center text-slate-400 text-xs">Բեռնվում է...</div>
				</div>
			</section>

			<!-- ========================================== -->
			<!-- PAGE 5: CMS (ԿԱՅՔԻ ԿԱՐԳԱՎՈՐՈՒՄՆԵՐ)         -->
			<!-- ========================================== -->
			<section id="page-cms" class="hidden space-y-6">
				<div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-4">
					<div>
						<h2 class="text-xl font-bold text-slate-900">Կայքի Կարգավորումներ (CMS)</h2>
						<p class="text-xs text-slate-500">Փոխեք բրենդի անունը, կոնտակտները, հերոսական հատվածը, ծառայությունները և բոլոր հղումները։</p>
					</div>
					<button id="cms-save-btn" type="button" onclick="saveCmsSettings()" class="rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-sm hover:bg-blue-700 active:scale-95 transition">
						Պահպանել Փոփոխությունները
					</button>
				</div>

				<div id="cms-alert" class="hidden rounded-xl bg-green-50 p-4 text-xs font-semibold text-green-700 border border-green-200">
					Կարգավորումները հաջողությամբ պահպանվեցին։
				</div>

				<form id="form-cms-settings" class="space-y-6">
					<!-- Card 1: Brand & Navigation -->
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
						<h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
							<span>🏷️</span> Բրենդ և Մենյուի Կարգավորումներ
						</h3>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Բրենդի Անվանում *</label>
								<input type="text" id="cms-brandName" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Ենթավերնագիր</label>
								<input type="text" id="cms-brandSubtext" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">«Ամրագրել» Կոճակի Տեքստ</label>
								<input type="text" id="cms-bookButtonText" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
						</div>
						<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Մենյու Հղում 1</label>
								<input type="text" id="cms-navLink1" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Մենյու Հղում 2</label>
								<input type="text" id="cms-navLink2" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Մենյու Հղում 3</label>
								<input type="text" id="cms-navLink3" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Մենյու Հղում 4</label>
								<input type="text" id="cms-navLink4" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:border-blue-600" />
							</div>
						</div>
					</div>

					<!-- Card 2: Contacts & Social Media -->
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
						<h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
							<span>📞</span> Կոնտակտային Տվյալներ և Սոց. Ցանցեր
						</h3>
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Հեռախոսահամար</label>
								<input type="text" id="cms-phone" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Էլ. Փոստ</label>
								<input type="text" id="cms-email" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Հասցե</label>
								<input type="text" id="cms-address" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Աշխատանքային Ժամեր</label>
								<input type="text" id="cms-workingHours" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Telegram URL</label>
								<input type="text" id="cms-telegramUrl" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-xs outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">WhatsApp URL</label>
								<input type="text" id="cms-whatsappUrl" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-xs outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Instagram URL</label>
								<input type="text" id="cms-instagramUrl" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-xs outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Facebook URL</label>
								<input type="text" id="cms-facebookUrl" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-xs outline-none focus:border-blue-600" />
							</div>
						</div>
					</div>

					<!-- Card 3: Hero Section -->
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
						<h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
							<span>🚀</span> Գլխավոր (Hero) Հատված
						</h3>
						<div>
							<label class="block text-xs font-semibold text-slate-700 mb-1">Գլխավոր Վերնագիր</label>
							<input type="text" id="cms-heroTitle" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-700 mb-1">Գլխավոր Նկարագրություն</label>
							<textarea id="cms-heroSubtitle" rows="2" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600 resize-none"></textarea>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Կոճակ 1 Տեքստ</label>
								<input type="text" id="cms-heroCtaText" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Կոճակ 2 Տեքստ</label>
								<input type="text" id="cms-heroSecondaryCtaText" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Նկարի URL</label>
								<input type="text" id="cms-heroImageUrl" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
						</div>
					</div>

					<!-- Card 4: Services Section -->
					<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
						<h3 class="text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
							<span>🛠️</span> Ծառայություններ
						</h3>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Ծառայությունների Վերնագիր</label>
								<input type="text" id="cms-servicesTitle" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-slate-700 mb-1">Ծառայությունների Ենթավերնագիր</label>
								<input type="text" id="cms-servicesSubtitle" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm outline-none focus:border-blue-600" />
							</div>
						</div>

						<!-- Service 1, 2, 3 -->
						<div class="space-y-4 pt-2">
							<div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
								<span class="text-xs font-bold text-blue-600 uppercase">Ծառայություն 1</span>
								<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
