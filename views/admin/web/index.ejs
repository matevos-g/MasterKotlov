		<!-- CLIENT JS SCRIPT -->
		<script>
			let allOrders = [];
			let allProducts = [];
			let allLedger = [];
			let allAdminUsers = [];
			let currentOrderTab = 'new';
			let confirmCallback = null;
			let currentSessionUser = null;

			// Service Worker PWA registration
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').then(reg => {
						console.log('PWA ServiceWorker registered successfully:', reg);
					}).catch(err => {
						console.log('ServiceWorker registration error:', err);
					});
				});
			}

			function escapeHtml(str) {
				if (!str) return '';
				return String(str)
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#039;');
			}

			// Auth check
			async function initAuth() {
				if (!window.supabaseClient) {
					window.location.href = '/admin/web/login/';
					return;
				}
				const { data: { session } } = await window.supabaseClient.auth.getSession();
				if (!session) {
					window.location.href = '/admin/web/login/';
					return;
				}
				currentSessionUser = session.user;
				const userEmail = currentSessionUser.email || '';
				const usernameDisplay = userEmail.endsWith('@masterkotlov.am') ? userEmail.replace('@masterkotlov.am', '') : userEmail;
				document.getElementById('admin-user-badge').textContent = usernameDisplay;
				
				loadAllData();
			}

			// Main Page Switching
			const pages = ['orders', 'finance', 'products', 'users', 'cms'];
			function switchPage(activePage) {
				pages.forEach(p => {
					const el = document.getElementById(`page-${p}`);
					const btn = document.getElementById(`nav-page-${p}`);
					const mobBtn = document.getElementById(`mobile-nav-${p}`);
					if (p === activePage) {
						el.classList.remove('hidden');
						btn?.classList.add('active');
						mobBtn?.classList.add('active');
					} else {
						el.classList.add('hidden');
						btn?.classList.remove('active');
						mobBtn?.classList.remove('active');
					}
				});
			}

			pages.forEach(p => {
				document.getElementById(`nav-page-${p}`)?.addEventListener('click', () => switchPage(p));
				document.getElementById(`mobile-nav-${p}`)?.addEventListener('click', () => switchPage(p));
			});

			// Order Status Select Change
			document.getElementById('order-status-select')?.addEventListener('change', (e) => {
				currentOrderTab = e.target.value;
				renderOrdersGridList();
			});

			// Fetch Data
			async function loadAllData() {
				await Promise.all([fetchOrders(), fetchProducts(), fetchLedger(), fetchUsers(), loadCmsConfig()]);
			}

			async function fetchOrders() {
				try {
					const { data, error } = await window.supabaseClient
						.from('service_requests')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data) {
						allOrders = data;
						renderOrdersGridList();
					}
				} catch (err) {
					console.error('Fetch orders error:', err);
				}
			}

			async function fetchProducts() {
				try {
					const { data, error } = await window.supabaseClient
						.from('products')
						.select('*')
						.order('id', { ascending: true });

					if (!error && data && data.length) {
						allProducts = data;
					} else {
						const res = await fetch('/api/products.json');
						if (res.ok) allProducts = await res.json();
					}
					renderProductsGridList();
				} catch (err) {
					console.error('Fetch products error:', err);
				}
			}

			async function fetchLedger() {
				try {
					const { data, error } = await window.supabaseClient
						.from('finance_ledger')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error) {
						allLedger = data || [];
						renderFinancePage();
					}
				} catch (err) {
					console.error('Fetch ledger error:', err);
				}
			}

			function getStatusBadgeHTML(status) {
				const badges = {
					new: '<span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 border border-amber-200">Սպասող</span>',
					in_progress: '<span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-200">Ընթացքի մեջ</span>',
					completed: '<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200">Ավարտված</span>',
					cancelled: '<span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 border border-red-200">Չեղարկված</span>'
				};
				return badges[status] || status;
			}

			// 1. Orders Grid List (1 item per row container)
			function renderOrdersGridList() {
				const container = document.getElementById('orders-grid-list');
				if (!container) return;

				const filtered = allOrders.filter(o => o.status === currentOrderTab);

				if (!filtered.length) {
					container.innerHTML = `
						<div class="rounded-2xl border border-dashed border-slate-200 p-12 text-center bg-white">
							<p class="text-sm font-medium text-slate-500">Այս բաժնում պատվերներ չկան</p>
						</div>
					`;
					return;
				}

				container.innerHTML = filtered.map(o => {
					const d = new Date(o.created_at);
					const dateStr = d.toLocaleDateString('hy-AM', { 
						year: 'numeric', month: '2-digit', day: '2-digit', 
						hour: '2-digit', minute: '2-digit', hour12: false 
					});
					const statusBadge = getStatusBadgeHTML(o.status);
					const fullName = `${escapeHtml(o.first_name || '')} ${escapeHtml(o.last_name || '')}`.trim() || 'Հաճախորդ';

					return `
						<div onclick="openOrderDetailsDrawer('${o.id}')" class="group relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs hover:shadow-md hover:border-blue-300 transition cursor-pointer">
							<div class="space-y-1.5">
								<div class="flex items-center gap-3">
									<span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition">${fullName}</span>
									${statusBadge}
								</div>
								<div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-500">
									<span class="flex items-center gap-1">
										<span>📅</span> ${dateStr}
									</span>
									<span class="flex items-center gap-1 font-mono text-blue-600 font-semibold">
										<span>📞</span> ${escapeHtml(o.phone || '')}
									</span>
								</div>
							</div>
							<div class="flex items-center gap-2 self-end sm:self-center">
								<span class="text-xs font-bold text-blue-600 group-hover:translate-x-1 transition-transform flex items-center gap-1">
									<span>Մանրամասներ</span>
									<span>→</span>
								</span>
							</div>
						</div>
					`;
				}).join('');
			}

			// Open Order Details Drawer from the Side
			function openOrderDetailsDrawer(orderId) {
				const o = allOrders.find(item => item.id === orderId);
				if (!o) return;

				const d = new Date(o.created_at);
				const dateStr = d.toLocaleDateString('hy-AM', {
					year: 'numeric', month: '2-digit', day: '2-digit',
					hour: '2-digit', minute: '2-digit', hour12: false
				});

				const fullName = `${o.first_name || ''} ${o.last_name || ''}`.trim() || 'Հաճախորդ';
				const cleanPhone = (o.phone || '').replace(/\s+/g, '');

				document.getElementById('detail-client-name').textContent = fullName;
				document.getElementById('detail-client-date').textContent = dateStr;
				document.getElementById('detail-client-phone').textContent = o.phone || '';
				document.getElementById('detail-problem-text').textContent = o.problem_description || 'Նկարագրություն առկա չէ';
				document.getElementById('detail-status-badge').innerHTML = getStatusBadgeHTML(o.status);

				const prodBox = document.getElementById('detail-product-box');
				if (o.product_name) {
					document.getElementById('detail-product-name').textContent = o.product_name;
					prodBox.classList.remove('hidden');
				} else {
					prodBox.classList.add('hidden');
				}

				const actionsContainer = document.getElementById('detail-drawer-actions');
				
				// 3 Armenian Buttons: Call Customer, Continue/Start/Complete, Cancel
				let continueBtnHTML = '';
				if (o.status === 'new') {
					continueBtnHTML = `<button onclick="changeOrderStatus('${o.id}', 'in_progress'); closeDrawer('drawer-order-details');" class="w-full rounded-xl bg-blue-600 py-3.5 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>▶</span> <span>Սկսել / Շարունակել</span></button>`;
				} else if (o.status === 'in_progress') {
					continueBtnHTML = `<button onclick="closeDrawer('drawer-order-details'); openEarningsModal('${o.id}');" class="w-full rounded-xl bg-blue-600 py-3.5 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>✓</span> <span>Ավարտել Պատվերը</span></button>`;
				} else if (o.status === 'completed') {
					continueBtnHTML = `<button disabled class="w-full rounded-xl bg-slate-100 py-3.5 text-sm font-semibold text-slate-400 cursor-not-allowed">Պատվերն Ավարտված է</button>`;
				} else {
					continueBtnHTML = `<button disabled class="w-full rounded-xl bg-slate-100 py-3.5 text-sm font-semibold text-slate-400 cursor-not-allowed">Պատվերը Չեղարկված է</button>`;
				}

				let cancelBtnHTML = '';
				if (o.status !== 'cancelled' && o.status !== 'completed') {
					cancelBtnHTML = `<button onclick="promptConfirm('Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:', () => { changeOrderStatus('${o.id}', 'cancelled'); closeDrawer('drawer-order-details'); })" class="w-full rounded-xl bg-red-50 border border-red-200 py-3.5 text-sm font-bold text-red-600 hover:bg-red-100 active:scale-95 transition flex items-center justify-center gap-2"><span>✕</span> <span>Չեղարկել Պատվերը</span></button>`;
				} else {
					cancelBtnHTML = `<button onclick="closeDrawer('drawer-order-details')" class="w-full rounded-xl bg-slate-100 py-3.5 text-sm font-semibold text-slate-700 hover:bg-slate-200 transition">Փակել</button>`;
				}

				actionsContainer.innerHTML = `
					<a href="tel:${cleanPhone}" class="w-full text-center rounded-xl bg-emerald-600 py-3.5 text-sm font-bold text-white shadow-md hover:bg-emerald-700 active:scale-95 transition flex items-center justify-center gap-2">
						<span>📞</span> <span>Զանգահարել Հաճախորդին</span>
					</a>
					${continueBtnHTML}
					${cancelBtnHTML}
				`;

				document.getElementById('drawer-order-details').classList.remove('hidden');
			}

			function closeDrawer(id) {
				document.getElementById(id)?.classList.add('hidden');
			}

			function closeModal(id) {
				document.getElementById(id)?.classList.add('hidden');
			}

			async function changeOrderStatus(orderId, newStatus) {
				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.update({ status: newStatus })
						.eq('id', orderId);

					if (!error) {
						fetchOrders();
					}
				} catch (err) {
					console.error('Update status error:', err);
				}
			}

			function openEarningsModal(orderId) {
				document.getElementById('earnings-order-id').value = orderId;
				document.getElementById('earnings-amount').value = '';
				document.getElementById('modal-earnings').classList.remove('hidden');
			}

			document.getElementById('form-earnings').addEventListener('submit', async (e) => {
				e.preventDefault();
				const orderId = document.getElementById('earnings-order-id').value;
				const amount = Number(document.getElementById('earnings-amount').value);
				const order = allOrders.find(o => o.id === orderId);

				try {
					await window.supabaseClient
						.from('service_requests')
						.update({ status: 'completed' })
						.eq('id', orderId);

					await window.supabaseClient
						.from('finance_ledger')
						.insert([{
							order_id: orderId,
							amount: amount,
							client_name: order ? `${order.first_name || ''} ${order.last_name || ''}`.trim() : 'Հաճախորդ',
							notes: order ? (order.product_name || order.problem_description || '') : ''
						}]);

					closeModal('modal-earnings');
					fetchOrders();
					fetchLedger();
				} catch (err) {
					alert('Սխալ պատվերը ավարտելիս');
				}
			});

			function promptConfirm(title, onConfirm) {
				document.getElementById('confirm-modal-title').textContent = title || 'Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:';
				confirmCallback = onConfirm;
				document.getElementById('modal-confirm').classList.remove('hidden');
			}

			document.getElementById('confirm-action-btn').addEventListener('click', () => {
				if (confirmCallback) confirmCallback();
				closeModal('modal-confirm');
			});

			// Finance Page Logic & Bar Chart Diagram
			let financeChartInstance = null;

			function renderFinanceChart(labels, dataValues, subtitleText) {
				const subtitleEl = document.getElementById('chart-subtitle');
				if (subtitleEl) subtitleEl.textContent = subtitleText;

				const canvas = document.getElementById('finance-chart');
				if (!canvas || !window.Chart) return;
				const ctx = canvas.getContext('2d');

				if (financeChartInstance) {
					financeChartInstance.destroy();
				}

				financeChartInstance = new Chart(ctx, {
					type: 'bar',
					data: {
						labels: labels,
						datasets: [{
							label: 'Եկամուտ (Դրամ)',
							data: dataValues,
							backgroundColor: 'rgba(37, 99, 235, 0.85)',
							hoverBackgroundColor: 'rgba(29, 78, 216, 1)',
							borderRadius: 6,
							borderSkipped: false,
							maxBarThickness: 32
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { display: false },
							tooltip: {
								backgroundColor: '#0f172a',
								titleFont: { size: 12, family: 'Inter, Noto Sans Armenian' },
								bodyFont: { size: 12, family: 'Inter, Noto Sans Armenian' },
								padding: 10,
								displayColors: false,
								callbacks: {
									label: function(context) {
										const val = context.raw || 0;
										return ` Եկամուտ: ${val.toLocaleString('hy-AM')} Դրամ`;
									}
								}
							}
						},
						scales: {
							x: {
								grid: { display: false },
								ticks: { font: { size: 11, family: 'Inter, Noto Sans Armenian' }, color: '#64748b' }
							},
							y: {
								grid: { color: '#f1f5f9' },
								ticks: {
									font: { size: 11, family: 'Inter, Noto Sans Armenian' },
									color: '#64748b',
									callback: function(val) {
										if (val >= 1000) return (val / 1000) + ' հզ';
										return val;
									}
								}
							}
						}
					}
				});
			}

			function renderFinancePage() {
				const range = document.getElementById('finance-range-select').value;
				const now = new Date();
				let filteredLedger = allLedger;

				if (range === 'current_month') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
					});
				} else if (range === 'last_month') {
					const lastMonthDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === lastMonthDate.getMonth() && d.getFullYear() === lastMonthDate.getFullYear();
					});
				} else if (range === 'current_year') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getFullYear() === now.getFullYear();
					});
				}

				const total = filteredLedger.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
				document.getElementById('total-earnings-display').textContent = `${total.toLocaleString('hy-AM')} Դրամ`;

				// Last 10 Transactions Down Below
				const ledgerContainer = document.getElementById('ledger-grid-list');
				const last10 = filteredLedger.slice(0, 10);

				if (!last10.length) {
					ledgerContainer.innerHTML = `<div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400 text-xs bg-white">Գործարքներ չկան</div>`;
				} else {
					ledgerContainer.innerHTML = last10.map(l => {
						const d = new Date(l.created_at);
						const dateStr = d.toLocaleDateString('hy-AM', { 
							year: 'numeric', month: '2-digit', day: '2-digit', 
							hour: '2-digit', minute: '2-digit', hour12: false 
						});
						const notesStr = l.notes ? `<p class="text-xs text-slate-500 mt-1">${escapeHtml(l.notes)}</p>` : '';

						return `
							<div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-xs hover:border-slate-300 transition">
								<div>
									<h4 class="text-sm font-bold text-slate-900">${escapeHtml(l.client_name || 'Հաճախորդ')}</h4>
									<p class="text-xs font-medium text-slate-400 mt-0.5">📅 ${dateStr}</p>
									${notesStr}
								</div>
								<div class="text-right">
									<span class="text-sm sm:text-base font-extrabold text-emerald-600">+${Number(l.amount).toLocaleString('hy-AM')} Դրամ</span>
								</div>
							</div>
						`;
					}).join('');
				}

				// Build Chart Data & Aggregation
				const armMonths = ['Հնվ', 'Փտր', 'Մրտ', 'Ապր', 'Մյս', 'Հնս', 'Հլս', 'Օգս', 'Սեպ', 'Հոկ', 'Նոյ', 'Դեկ'];
				let labels = [];
				let dataValues = [];
				let subtitleText = '';

				if (range === 'current_month') {
					const year = now.getFullYear();
					const month = now.getMonth();
					const daysInMonth = new Date(year, month + 1, 0).getDate();
					subtitleText = `Օրական եկամուտ (${armMonths[month]} ${year})`;

					for (let day = 1; day <= daysInMonth; day++) {
						labels.push(`${armMonths[month]} ${day}`);
						const daySum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year && d.getMonth() === month && d.getDate() === day) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(daySum);
					}
				} else if (range === 'last_month') {
					const lastMonthDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
					const year = lastMonthDate.getFullYear();
					const month = lastMonthDate.getMonth();
					const daysInMonth = new Date(year, month + 1, 0).getDate();
					subtitleText = `Օրական եկամուտ (${armMonths[month]} ${year})`;

					for (let day = 1; day <= daysInMonth; day++) {
						labels.push(`${armMonths[month]} ${day}`);
						const daySum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year && d.getMonth() === month && d.getDate() === day) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(daySum);
					}
				} else if (range === 'current_year') {
					const year = now.getFullYear();
					subtitleText = `Ամսական եկամուտ (${year})`;

					for (let month = 0; month < 12; month++) {
						labels.push(armMonths[month]);
						const monthSum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year && d.getMonth() === month) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(monthSum);
					}
				} else if (range === 'all') {
					subtitleText = 'Տարեկան եկամուտ (Ընդհանուր)';
					const yearsSet = new Set(allLedger.map(l => new Date(l.created_at).getFullYear()));
					yearsSet.add(now.getFullYear());
					const sortedYears = Array.from(yearsSet).sort((a, b) => a - b);

					sortedYears.forEach(year => {
						labels.push(String(year));
						const yearSum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(yearSum);
					});
				}

				renderFinanceChart(labels, dataValues, subtitleText);
			}

			document.getElementById('finance-range-select').addEventListener('change', renderFinancePage);

			// Products Grid Cards
			function renderProductsGridList() {
				const container = document.getElementById('products-grid-list');
				if (!container) return;

				if (!allProducts.length) {
					container.innerHTML = `<div class="col-span-full p-12 text-center text-slate-400 text-sm">Ապրանքներ չկան</div>`;
					return;
				}

				container.innerHTML = allProducts.map(p => {
					const imgSrc = escapeHtml(p.image || (p.images && p.images[0]) || '/images/products/placeholder.jpg');
					const priceDisplay = p.price ? (p.price.includes('դրամ') ? p.price : (p.price + ' դրամ')) : '';
					const topBadge = p.top ? '<span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 border border-emerald-200">Top</span>' : '';

					return `
						<div class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-xs hover:shadow-md hover:border-slate-300 transition">
							<div class="space-y-3">
								<div class="relative aspect-square w-full overflow-hidden rounded-xl bg-slate-100 border border-slate-100">
									<img src="${imgSrc}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" />
									<div class="absolute top-2 right-2 flex gap-1">
										${topBadge}
									</div>
								</div>
								<div>
									<h3 class="text-sm font-bold text-slate-900 line-clamp-1">${escapeHtml(p.name || '')}</h3>
									<p class="text-xs text-slate-500 line-clamp-2 mt-0.5">${escapeHtml(p.desk || p.description || '')}</p>
								</div>
							</div>

							<div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
								<span class="text-xs font-extrabold text-blue-600">${escapeHtml(priceDisplay)}</span>
								<div class="flex items-center gap-1.5">
									<a href="/admin/web/products/${p.id}/" class="rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 transition">Խմբագրել</a>
									<button onclick="promptConfirm('Ջնջե՞լ այս ապրանքը:', () => deleteProduct(${p.id}))" class="rounded-xl bg-red-50 border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition">Ջնջել</button>
								</div>
							</div>
						</div>
					`;
				}).join('');
			}

			async function deleteProduct(id) {
				try {
					const { error } = await window.supabaseClient.from('products').delete().eq('id', id);
					if (!error) fetchProducts();
				} catch (err) {
					alert('Ջնջումը ձախողվեց');
				}
			}

			// Admin Users Cards List
			async function fetchUsers() {
				try {
					const { data, error } = await window.supabaseClient
						.from('admin_users')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data && data.length) {
						allAdminUsers = data;
					} else {
						const email = currentSessionUser ? (currentSessionUser.email || '') : '';
						const uname = email.endsWith('@masterkotlov.am') ? email.replace('@masterkotlov.am', '') : (email || 'admin');
						allAdminUsers = [{
							id: 'default-1',
							name: 'Գոռ',
							username: uname,
							email: email || 'admin@masterkotlov.am',
							status: 'active'
						}];
					}
					renderUsersGridList();
				} catch (err) {
					console.error('Fetch users error:', err);
					renderUsersGridList();
				}
			}

			function renderUsersGridList() {
				const container = document.getElementById('users-grid-list');
				if (!container) return;

				if (!allAdminUsers.length) {
					container.innerHTML = `<div class="col-span-full p-12 text-center text-slate-400 text-sm">Օգտատերեր չկան</div>`;
					return;
				}

				container.innerHTML = allAdminUsers.map(u => {
					const displayName = escapeHtml(u.name || u.username || 'Ադմին');
					const username = escapeHtml(u.username || '');

					return `
						<div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-xs hover:shadow-md transition space-y-4">
							<div class="flex items-center gap-3">
								<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 font-bold text-base border border-blue-100">
									${displayName.charAt(0).toUpperCase()}
								</div>
								<div>
									<h3 class="text-sm font-bold text-slate-900">${displayName}</h3>
									<p class="text-xs text-slate-500 font-mono">@${username}</p>
								</div>
							</div>

							<div class="flex flex-wrap items-center justify-between border-t border-slate-100 pt-3 gap-2">
								<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-200">Ակտիվ Ադմին</span>
								<div class="flex items-center gap-1.5">
									<button onclick="openEditUserModal('${u.id}', '${displayName}', '${username}')" class="rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 transition">Խմբագրել</button>
									<button onclick="openResetPasswordModal('${u.id}', '${username}')" class="rounded-xl bg-amber-50 border border-amber-200 px-3 py-1.5 text-xs font-semibold text-amber-700 hover:bg-amber-100 transition">Գաղտնաբառ</button>
									<button onclick="promptConfirm('Վստա՞հ եք, որ ցանկանում եք ջնջել այս օգտատիրոջը:', () => deleteUser('${u.id}'))" class="rounded-xl bg-red-50 border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition">Ջնջել</button>
								</div>
							</div>
						</div>
					`;
				}).join('');
			}

			// Add Admin User Action
			document.getElementById('add-user-btn')?.addEventListener('click', () => {
				document.getElementById('new-user-fullname').value = '';
				document.getElementById('new-user-username').value = '';
				document.getElementById('new-user-pass').value = '';
				document.getElementById('modal-add-user').classList.remove('hidden');
			});

			document.getElementById('form-add-user')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const fullname = document.getElementById('new-user-fullname').value.trim();
				let uname = document.getElementById('new-user-username').value.trim();
				const pass = document.getElementById('new-user-pass').value.trim();

				let email = uname;
				if (!email.includes('@')) {
					email = `${email.toLowerCase()}@masterkotlov.am`;
				}

				try {
					await window.supabaseClient.from('admin_users').insert([{
						name: fullname,
						username: uname,
						email: email,
						status: 'active'
					}]);

					await window.supabaseClient.auth.signUp({ email, password: pass }).catch(() => {});

					alert(`Ադմին օգտատերը (${fullname} - ${uname}) հաջողությամբ ավելացվեց։`);
					closeModal('modal-add-user');
					fetchUsers();
				} catch (err) {
					alert('Օգտատիրոջ ավելացման սխալ: ' + (err.message || err));
				}
			});

			// Edit Admin User Action
			function openEditUserModal(id, name, username) {
				document.getElementById('edit-user-id').value = id;
				document.getElementById('edit-user-fullname').value = name;
				document.getElementById('edit-user-username').value = username;
				document.getElementById('modal-edit-user').classList.remove('hidden');
			}

			document.getElementById('form-edit-user')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const id = document.getElementById('edit-user-id').value;
				const fullname = document.getElementById('edit-user-fullname').value.trim();
				const username = document.getElementById('edit-user-username').value.trim();

				let email = username;
				if (!email.includes('@')) {
					email = `${email.toLowerCase()}@masterkotlov.am`;
				}

				try {
					await window.supabaseClient.from('admin_users').update({
						name: fullname,
						username: username,
						email: email
					}).eq('id', id);

					alert('Օգտատիրոջ տվյալները հաջողությամբ թարմացվեցին։');
					closeModal('modal-edit-user');
					fetchUsers();
				} catch (err) {
					alert('Տվյալների թարմացման սխալ: ' + (err.message || err));
				}
			});

			// Delete Admin User Action
			async function deleteUser(id) {
				try {
					const { error } = await window.supabaseClient.from('admin_users').delete().eq('id', id);
					if (!error) {
						fetchUsers();
					} else {
						allAdminUsers = allAdminUsers.filter(u => u.id !== id);
						renderUsersGridList();
					}
				} catch (err) {
					alert('Ջնջումը ձախողվեց');
				}
			}

			// Reset Password Action
			function openResetPasswordModal(id, username) {
				document.getElementById('reset-new-pass').value = '';
				document.getElementById('modal-reset-pass').classList.remove('hidden');
			}

			document.getElementById('form-reset-pass')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const newPassword = document.getElementById('reset-new-pass').value.trim();

				try {
					const { data, error } = await window.supabaseClient.auth.updateUser({ password: newPassword });
					if (error) throw error;

					alert('Գաղտնաբառը հաջողությամբ թարմացվեց։');
					closeModal('modal-reset-pass');
				} catch (err) {
					alert('Գաղտնաբառի փոփոխման սխալ: ' + (err.message || err));
				}
			});

			// Add Manual Order Drawer Action
			document.getElementById('add-order-btn')?.addEventListener('click', () => {
				const prodSelect = document.getElementById('new-order-product');
				if (prodSelect) {
					prodSelect.innerHTML = '<option value="">-- Առանց ապրանքի --</option>' +
						allProducts.map(p => `<option value="${p.id}" data-name="${escapeHtml(p.name)}">${escapeHtml(p.name)}</option>`).join('');
				}

				document.getElementById('new-order-firstname').value = '';
				document.getElementById('new-order-lastname').value = '';
				document.getElementById('new-order-phone').value = '';
				document.getElementById('new-order-problem').value = '';
				document.getElementById('drawer-add-order').classList.remove('hidden');
			});

			document.getElementById('form-add-order-drawer')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const firstname = document.getElementById('new-order-firstname').value.trim();
				const lastname = document.getElementById('new-order-lastname').value.trim();
				const phone = document.getElementById('new-order-phone').value.trim();
				const problem = document.getElementById('new-order-problem').value.trim();

				const prodSelect = document.getElementById('new-order-product');
				const selectedOpt = prodSelect ? prodSelect.selectedOptions[0] : null;
				const productId = selectedOpt && selectedOpt.value ? Number(selectedOpt.value) : null;
				const productName = selectedOpt && selectedOpt.value ? selectedOpt.getAttribute('data-name') : null;

				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.insert([{
							first_name: firstname,
							last_name: lastname,
							phone: phone,
							problem_description: problem,
							product_id: productId,
							product_name: productName,
							status: 'new'
						}]);

					if (error) throw error;

					alert('Պատվերը հաջողությամբ ավելացվեց։');
					closeDrawer('drawer-add-order');
					fetchOrders();
				} catch (err) {
					alert('Պատվերի ավելացման սխալ: ' + (err.message || err));
				}
			});

			document.getElementById('logout-btn')?.addEventListener('click', async () => {
				await window.supabaseClient.auth.signOut();
				window.location.href = '/admin/web/login/';
			});

			const cmsFields = [
				'brandName', 'brandSubtext', 'bookButtonText', 'navLink1', 'navLink2', 'navLink3', 'navLink4',
				'phone', 'email', 'address', 'workingHours', 'telegramUrl', 'whatsappUrl', 'instagramUrl', 'facebookUrl',
				'heroTitle', 'heroSubtitle', 'heroCtaText', 'heroSecondaryCtaText', 'heroImageUrl',
				'servicesTitle', 'servicesSubtitle',
				'service1Title', 'service1Desc', 'service1Image',
				'service2Title', 'service2Desc', 'service2Image',
				'service3Title', 'service3Desc', 'service3Image',
				'footerDesc', 'copyrightText'
			];

			async function loadCmsConfig() {
				try {
					let cfg = null;
					if (window.supabaseClient) {
						try {
							const { data } = await window.supabaseClient.from('site_settings').select('*').eq('id', 'default').single();
							if (data && data.config) cfg = data.config;
						} catch (e) {}
					}
					if (!cfg) {
						const res = await fetch('/admin/api/config');
						if (res.ok) cfg = await res.json();
					}
					if (!cfg) {
						const res = await fetch('/api/config.json');
						if (res.ok) cfg = await res.json();
					}
					if (cfg) {
						cmsFields.forEach(f => {
							const el = document.getElementById(`cms-${f}`);
							if (el && cfg[f] !== undefined) el.value = cfg[f];
						});
					}
				} catch (err) {
					console.warn('Failed loading CMS config:', err);
				}
			}

			async function saveCmsSettings() {
				const alertEl = document.getElementById('cms-alert');
				alertEl?.classList.add('hidden');
				const payload = {};
				cmsFields.forEach(f => {
					const el = document.getElementById(`cms-${f}`);
					if (el) payload[f] = el.value.trim();
				});

				try {
					const res = await fetch('/admin/api/config', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload)
					});

					if (window.supabaseClient) {
						try {
							await window.supabaseClient.from('site_settings').upsert([{ id: 'default', config: payload, updated_at: new Date().toISOString() }]);
						} catch (e) {}
					}

					if (alertEl) {
						alertEl.textContent = 'Կարգավորումները հաջողությամբ պահպանվեցին։';
						alertEl.classList.remove('hidden');
						setTimeout(() => alertEl.classList.add('hidden'), 4000);
					}
				} catch (err) {
					alert('Սխալ պահպանելիս: ' + (err.message || err));
				}
			}

			initAuth();
		</script>
	</body>
</html>
