					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 mb-1">Դերը *</label>
						<select id="new-user-role" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 bg-white">
							<option value="Administrator">Ադմինիստրատոր (Admin)</option>
							<option value="Manager">Մենեջեր (Manager)</option>
							<option value="Staff">Աշխատակից (Staff)</option>
						</select>
					</div>
					<div class="flex justify-end gap-2 pt-2">
						<button type="button" onclick="closeModal('modal-add-user')" class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200">Չեղարկել</button>
						<button type="submit" class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-medium text-white hover:bg-blue-700 shadow-sm">Ավելացնել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- CLIENT JS SCRIPT -->
		<script>
			let allOrders = [];
			let allProducts = [];
			let allLedger = [];
			let currentOrderTab = 'new';
			let confirmCallback = null;
			let currentSessionUser = null;

			// Service Worker PWA registration
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}

			function openSlidePage(id) {
				const el = document.getElementById(id);
				if (el) {
					el.classList.remove('translate-x-full');
					el.classList.add('translate-x-0');
				}
			}

			function closeSlidePage(id) {
				const el = document.getElementById(id);
				if (el) {
					el.classList.remove('translate-x-0');
					el.classList.add('translate-x-full');
				}
			}

			function escapeHtml(str) {
				if (!str) return '';
				return String(str)
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#039;');
			}

			async function initAuth() {
				if (!window.supabaseClient) {
					window.location.href = '/admin/web/login/';
					return;
				}
				const { data: { session } } = await window.supabaseClient.auth.getSession();
				if (!session) {
					window.location.href = '/admin/web/login/';
					return;
				}
				currentSessionUser = session.user;
				const userEmail = currentSessionUser.email || '';
				const usernameDisplay = userEmail.endsWith('@masterkotlov.am') ? userEmail.replace('@masterkotlov.am', '') : userEmail;
				document.getElementById('admin-user-badge').textContent = usernameDisplay;
				
				loadAllData();
			}

			const pages = ['orders', 'finance', 'products', 'users', 'cms'];
			function switchPage(activePage) {
				pages.forEach(p => {
					const el = document.getElementById(`page-${p}`);
					const btn = document.getElementById(`nav-page-${p}`);
					const mobBtn = document.getElementById(`mobile-nav-${p}`);
					if (p === activePage) {
						el?.classList.remove('hidden');
						btn?.classList.add('active');
						mobBtn?.classList.add('active');
						if (p === 'users') renderUsersTable();
					} else {
						el?.classList.add('hidden');
						btn?.classList.remove('active');
						mobBtn?.classList.remove('active');
					}
				});
			}

			pages.forEach(p => {
				document.getElementById(`nav-page-${p}`)?.addEventListener('click', () => switchPage(p));
				document.getElementById(`mobile-nav-${p}`)?.addEventListener('click', () => switchPage(p));
			});

			document.getElementById('mobile-nav-logout')?.addEventListener('click', handleLogout);
			document.getElementById('logout-btn')?.addEventListener('click', handleLogout);

			async function handleLogout() {
				if (window.supabaseClient) await window.supabaseClient.auth.signOut();
				window.location.replace('/admin/web/login/');
			}

			document.getElementById('order-status-select')?.addEventListener('change', (e) => {
				currentOrderTab = e.target.value;
				renderOrdersGridList();
			});

			async function loadAllData() {
				await Promise.all([fetchOrders(), fetchProducts(), fetchLedger(), loadCmsConfig()]);
			}

			async function fetchOrders() {
				try {
					const { data, error } = await window.supabaseClient
						.from('service_requests')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data) {
						allOrders = data;
						renderOrdersGridList();
					}
				} catch (err) {
					console.error('Fetch orders error:', err);
				}
			}

			async function fetchProducts() {
				try {
					const { data, error } = await window.supabaseClient
						.from('products')
						.select('*')
						.order('id', { ascending: true });

					if (!error && data && data.length) {
						allProducts = data;
					} else {
						const res = await fetch('/api/products.json');
						if (res.ok) allProducts = await res.json();
					}
					renderProductsGridList();
				} catch (err) {
					console.error('Fetch products error:', err);
				}
			}

			async function fetchLedger() {
				try {
					const { data, error } = await window.supabaseClient
						.from('finance_ledger')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error) {
						allLedger = data || [];
						renderFinancePage();
					}
				} catch (err) {
					console.error('Fetch ledger error:', err);
				}
			}

			function getStatusBadgeHTML(status) {
				const badges = {
					new: '<span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 border border-amber-200">Սպասող</span>',
					in_progress: '<span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-200">Ընթացքի մեջ</span>',
					completed: '<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200">Ավարտված</span>',
					cancelled: '<span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 border border-red-200">Չեղարկված</span>'
				};
				return badges[status] || status;
			}

			function renderOrdersGridList() {
				const container = document.getElementById('orders-grid-list');
				if (!container) return;

				const filtered = allOrders.filter(o => o.status === currentOrderTab);

				if (!filtered.length) {
					container.innerHTML = `
						<div class="rounded-2xl border border-dashed border-slate-200 p-12 text-center bg-white">
							<p class="text-sm font-medium text-slate-500">Այս բաժնում պատվերներ չկան</p>
						</div>
					`;
					return;
				}

				container.innerHTML = filtered.map(o => {
					const d = new Date(o.created_at);
					const dateStr = d.toLocaleDateString('hy-AM', { 
						year: 'numeric', month: '2-digit', day: '2-digit', 
						hour: '2-digit', minute: '2-digit', hour12: false 
					});
					const statusBadge = getStatusBadgeHTML(o.status);
					const fullName = `${escapeHtml(o.first_name || '')} ${escapeHtml(o.last_name || '')}`.trim() || 'Հաճախորդ';

					return `
						<div onclick="openOrderDetailsSlide('${o.id}')" class="group relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs hover:shadow-md hover:border-blue-300 transition cursor-pointer">
							<div class="space-y-1.5">
								<div class="flex items-center gap-3">
									<span class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition">${fullName}</span>
									${statusBadge}
								</div>
								<div class="flex flex-wrap items-center gap-4 text-xs font-medium text-slate-500">
									<span class="flex items-center gap-1">📅 ${dateStr}</span>
									<span class="flex items-center gap-1 font-mono text-blue-600 font-semibold">📞 ${escapeHtml(o.phone || '')}</span>
								</div>
							</div>
							<div class="flex items-center gap-2 self-end sm:self-center">
								<span class="text-xs font-bold text-blue-600 group-hover:translate-x-1 transition-transform flex items-center gap-1">
									<span>Մանրամասներ</span>
									<span>→</span>
								</span>
							</div>
						</div>
					`;
				}).join('');
			}

			function openOrderDetailsSlide(orderId) {
				const o = allOrders.find(item => item.id === orderId);
				if (!o) return;

				const d = new Date(o.created_at);
				const dateStr = d.toLocaleDateString('hy-AM', {
					year: 'numeric', month: '2-digit', day: '2-digit',
					hour: '2-digit', minute: '2-digit', hour12: false
				});

				const fullName = `${o.first_name || ''} ${o.last_name || ''}`.trim() || 'Հաճախորդ';
				const cleanPhone = (o.phone || '').replace(/\s+/g, '');

				document.getElementById('detail-client-name').textContent = fullName;
				document.getElementById('detail-client-date').textContent = dateStr;
				document.getElementById('detail-client-phone').textContent = o.phone || '';
				document.getElementById('detail-problem-text').textContent = o.problem_description || 'Նկարագրություն առկա չէ';
				document.getElementById('detail-status-badge').innerHTML = getStatusBadgeHTML(o.status);

				const prodBox = document.getElementById('detail-product-box');
				if (o.product_name) {
					document.getElementById('detail-product-name').textContent = o.product_name;
					prodBox.classList.remove('hidden');
				} else {
					prodBox.classList.add('hidden');
				}

				const actionsContainer = document.getElementById('detail-drawer-actions');
				
				let continueBtnHTML = '';
				if (o.status === 'new') {
					continueBtnHTML = `<button onclick="changeOrderStatus('${o.id}', 'in_progress'); closeSlidePage('slide-page-order-details');" class="w-full rounded-2xl bg-blue-600 py-3.5 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>▶</span> <span>Սկսել / Շարունակել</span></button>`;
				} else if (o.status === 'in_progress') {
					continueBtnHTML = `<button onclick="closeSlidePage('slide-page-order-details'); openEarningsModal('${o.id}');" class="w-full rounded-2xl bg-blue-600 py-3.5 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>✓</span> <span>Ավարտել Պատվերը</span></button>`;
				} else if (o.status === 'completed') {
					continueBtnHTML = `<button disabled class="w-full rounded-2xl bg-slate-100 py-3.5 text-sm font-semibold text-slate-400 cursor-not-allowed">Պատվերն Ավարտված է</button>`;
				} else {
					continueBtnHTML = `<button disabled class="w-full rounded-2xl bg-slate-100 py-3.5 text-sm font-semibold text-slate-400 cursor-not-allowed">Պատվերը Չեղարկված է</button>`;
				}

				let cancelBtnHTML = '';
				if (o.status !== 'cancelled' && o.status !== 'completed') {
					cancelBtnHTML = `<button onclick="promptConfirm('Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:', () => { changeOrderStatus('${o.id}', 'cancelled'); closeSlidePage('slide-page-order-details'); })" class="w-full rounded-2xl bg-red-50 border border-red-200 py-3.5 text-sm font-bold text-red-600 hover:bg-red-100 active:scale-95 transition flex items-center justify-center gap-2"><span>✕</span> <span>Չեղարկել Պատվերը</span></button>`;
				} else {
					cancelBtnHTML = `<button onclick="closeSlidePage('slide-page-order-details')" class="w-full rounded-2xl bg-slate-100 py-3.5 text-sm font-semibold text-slate-700 hover:bg-slate-200 transition">Փակել</button>`;
				}

				actionsContainer.innerHTML = `
					<a href="tel:${cleanPhone}" class="w-full text-center rounded-2xl bg-emerald-600 py-3.5 text-sm font-bold text-white shadow-md hover:bg-emerald-700 active:scale-95 transition flex items-center justify-center gap-2">
						<span>📞</span> <span>Զանգահարել Հաճախորդին</span>
					</a>
					${continueBtnHTML}
					${cancelBtnHTML}
				`;

				openSlidePage('slide-page-order-details');
			}

			function closeModal(id) {
				document.getElementById(id)?.classList.add('hidden');
			}

			async function changeOrderStatus(orderId, newStatus) {
				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.update({ status: newStatus })
						.eq('id', orderId);

					if (!error) fetchOrders();
				} catch (err) {
					console.error('Update status error:', err);
				}
			}

			function openEarningsModal(orderId) {
				document.getElementById('earnings-order-id').value = orderId;
				document.getElementById('earnings-amount').value = '';
				document.getElementById('modal-earnings').classList.remove('hidden');
			}

			document.getElementById('form-earnings').addEventListener('submit', async (e) => {
				e.preventDefault();
				const orderId = document.getElementById('earnings-order-id').value;
				const amount = Number(document.getElementById('earnings-amount').value);
				const order = allOrders.find(o => o.id === orderId);

				try {
					await window.supabaseClient.from('service_requests').update({ status: 'completed' }).eq('id', orderId);
					await window.supabaseClient.from('finance_ledger').insert([{
						order_id: orderId,
						amount: amount,
						client_name: order ? `${order.first_name || ''} ${order.last_name || ''}`.trim() : 'Հաճախորդ',
						notes: order ? (order.product_name || order.problem_description || '') : ''
					}]);

					closeModal('modal-earnings');
					fetchOrders();
					fetchLedger();
				} catch (err) {
					alert('Սխալ պատվերը ավարտելիս');
				}
			});

			function promptConfirm(title, onConfirm) {
				document.getElementById('confirm-modal-title').textContent = title || 'Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:';
				confirmCallback = onConfirm;
				document.getElementById('modal-confirm').classList.remove('hidden');
			}

			document.getElementById('confirm-action-btn').addEventListener('click', () => {
				if (confirmCallback) confirmCallback();
				closeModal('modal-confirm');
			});

			// Finance Page Logic (NO Diagram, JUST Big Number + Month Filter + Last Transactions)
			function renderFinancePage() {
				const range = document.getElementById('finance-range-select').value;
				const now = new Date();
				let filteredLedger = allLedger;

				if (range === 'current_month') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
					});
				} else if (range === 'last_month') {
					const lastMonthDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === lastMonthDate.getMonth() && d.getFullYear() === lastMonthDate.getFullYear();
					});
				} else if (range === 'current_year') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getFullYear() === now.getFullYear();
					});
				}

				const total = filteredLedger.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
				document.getElementById('total-earnings-display').textContent = `${total.toLocaleString('hy-AM')} Դրամ`;

				// Last 10 Transactions Down Below
				const ledgerContainer = document.getElementById('ledger-grid-list');
				const last10 = filteredLedger.slice(0, 10);

				if (!last10.length) {
					ledgerContainer.innerHTML = `<div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400 text-xs bg-white">Գործարքներ չկան</div>`;
				} else {
					ledgerContainer.innerHTML = last10.map(l => {
						const d = new Date(l.created_at);
						const dateStr = d.toLocaleDateString('hy-AM', { 
							year: 'numeric', month: '2-digit', day: '2-digit', 
							hour: '2-digit', minute: '2-digit', hour12: false 
						});
						const notesStr = l.notes ? `<p class="text-xs text-slate-500 mt-1">${escapeHtml(l.notes)}</p>` : '';

						return `
							<div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-xs hover:border-slate-300 transition">
								<div>
									<h4 class="text-sm font-bold text-slate-900">${escapeHtml(l.client_name || 'Հաճախորդ')}</h4>
									<p class="text-xs font-medium text-slate-400 mt-0.5">📅 ${dateStr}</p>
									${notesStr}
								</div>
								<div class="text-right">
									<span class="text-sm sm:text-base font-extrabold text-emerald-600">+${Number(l.amount).toLocaleString('hy-AM')} Դրամ</span>
								</div>
							</div>
						`;
					}).join('');
				}
			}

			document.getElementById('finance-range-select').addEventListener('change', renderFinancePage);

			// Products Grid Cards
			function renderProductsGridList() {
				const container = document.getElementById('products-grid-list');
				if (!container) return;

				if (!allProducts.length) {
					container.innerHTML = `<div class="col-span-full p-12 text-center text-slate-400 text-sm">Ապրանքներ չկան</div>`;
					return;
				}

				container.innerHTML = allProducts.map(p => {
					const imgSrc = escapeHtml(p.image || (p.images && p.images[0]) || '/images/products/placeholder.jpg');
					const priceDisplay = p.price ? (p.price.includes('դրամ') ? p.price : (p.price + ' դրամ')) : '';
					const topBadge = p.top ? '<span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 border border-emerald-200">Top</span>' : '';

					return `
						<div class="group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-xs hover:shadow-md hover:border-slate-300 transition">
							<div class="space-y-3">
								<div class="relative aspect-square w-full overflow-hidden rounded-xl bg-slate-100 border border-slate-100">
									<img src="${imgSrc}" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" />
									<div class="absolute top-2 right-2 flex gap-1">
										${topBadge}
									</div>
								</div>
								<div>
									<h3 class="text-sm font-bold text-slate-900 line-clamp-1">${escapeHtml(p.name || '')}</h3>
									<p class="text-xs text-slate-500 line-clamp-2 mt-0.5">${escapeHtml(p.desk || p.description || '')}</p>
								</div>
							</div>

							<div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
								<span class="text-xs font-extrabold text-blue-600">${escapeHtml(priceDisplay)}</span>
								<div class="flex items-center gap-1.5">
									<a href="/admin/web/products/${p.id}/" class="rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200 transition">Խմբագրել</a>
									<button onclick="promptConfirm('Ջնջե՞լ այս ապրանքը:', () => deleteProduct(${p.id}))" class="rounded-xl bg-red-50 border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition">Ջնջել</button>
								</div>
							</div>
						</div>
					`;
				}).join('');
			}

			async function deleteProduct(id) {
				try {
					const { error } = await window.supabaseClient.from('products').delete().eq('id', id);
					if (!error) fetchProducts();
				} catch (err) {
					alert('Ջնջումը ձախողվեց');
				}
			}

			// Add Manual Order Drawer Action
			document.getElementById('add-order-btn')?.addEventListener('click', () => {
				const prodSelect = document.getElementById('new-order-product');
				if (prodSelect) {
					prodSelect.innerHTML = '<option value="">-- Առանց ապրանքի --</option>' +
						allProducts.map(p => `<option value="${p.id}" data-name="${escapeHtml(p.name)}">${escapeHtml(p.name)}</option>`).join('');
				}

				document.getElementById('new-order-firstname').value = '';
				document.getElementById('new-order-lastname').value = '';
				document.getElementById('new-order-phone').value = '';
				document.getElementById('new-order-problem').value = '';
				openSlidePage('slide-page-add-order');
			});

			document.getElementById('form-add-order-drawer')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const firstname = document.getElementById('new-order-firstname').value.trim();
				const lastname = document.getElementById('new-order-lastname').value.trim();
				const phone = document.getElementById('new-order-phone').value.trim();
				const problem = document.getElementById('new-order-problem').value.trim();

				const prodSelect = document.getElementById('new-order-product');
				const selectedOpt = prodSelect ? prodSelect.selectedOptions[0] : null;
				const productId = selectedOpt && selectedOpt.value ? Number(selectedOpt.value) : null;
				const productName = selectedOpt && selectedOpt.value ? selectedOpt.getAttribute('data-name') : null;

				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.insert([{
							first_name: firstname,
							last_name: lastname,
							phone: phone,
							problem_description: problem,
							product_id: productId,
							product_name: productName,
							status: 'new'
						}]);

					if (error) throw error;

					alert('Պատվերը հաջողությամբ ավելացվեց։');
					closeSlidePage('slide-page-add-order');
					fetchOrders();
				} catch (err) {
					alert('Պատվերի ավելացման սխալ: ' + (err.message || err));
				}
			});

			// Users Management (Web Admin ONLY)
			let defaultUsers = [
				{ id: '1', username: 'admin', email: 'admin@masterkotlov.am', role: 'Administrator', status: 'Ակտիվ', created_at: new Date().toISOString() },
				{ id: '2', username: 'master', email: 'master@masterkotlov.am', role: 'Staff', status: 'Ակտիվ', created_at: new Date().toISOString() }
			];

			function renderUsersTable() {
				const body = document.getElementById('users-table-body');
				if (!body) return;

				body.innerHTML = defaultUsers.map(u => `
					<tr class="hover:bg-slate-50 transition">
						<td class="px-5 py-4 font-bold text-slate-900">${escapeHtml(u.username)} <span class="text-xs text-slate-400 font-normal">(${escapeHtml(u.email)})</span></td>
						<td class="px-5 py-4"><span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700 border border-blue-100">${escapeHtml(u.role)}</span></td>
						<td class="px-5 py-4"><span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 border border-emerald-100">${escapeHtml(u.status)}</span></td>
						<td class="px-5 py-4 text-right">
							<button onclick="deleteUser('${u.id}')" class="text-xs font-bold text-red-600 hover:text-red-800 transition">Ջնջել</button>
						</td>
					</tr>
				`).join('');
			}

			function openAddUserModal() {
				document.getElementById('modal-add-user')?.classList.remove('hidden');
			}

			function deleteUser(id) {
				if (confirm('Վստա՞հ եք, որ ցանկանում եք ջնջել այս օգտատիրոջը:')) {
					defaultUsers = defaultUsers.filter(u => u.id !== id);
					renderUsersTable();
				}
			}

			document.getElementById('form-add-user')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const username = document.getElementById('new-user-name').value.trim();
				const pass = document.getElementById('new-user-pass').value.trim();
				const role = document.getElementById('new-user-role').value;

				if (!username || !pass) return;

				const email = username.includes('@') ? username : `${username.toLowerCase()}@masterkotlov.am`;
				const newUser = {
					id: 'usr-' + Date.now(),
					username,
					email,
					role,
					status: 'Ակտիվ',
					created_at: new Date().toISOString()
				};

				defaultUsers.push(newUser);
				renderUsersTable();
				closeModal('modal-add-user');
				alert('Օգտատերը հաջողությամբ ավելացվեց։');
			});

			const cmsFields = [
				'brandName', 'brandSubtext', 'bookButtonText', 'navLink1', 'navLink2', 'navLink3', 'navLink4',
				'phone', 'email', 'address', 'workingHours', 'telegramUrl', 'whatsappUrl', 'instagramUrl', 'facebookUrl',
				'heroTitle', 'heroSubtitle', 'heroCtaText', 'heroSecondaryCtaText', 'heroImageUrl',
				'productsTitle', 'productsSubtitle',
				'servicesTitle', 'servicesSubtitle',
				'service1Title', 'service1Desc', 'service1Image',
				'service2Title', 'service2Desc', 'service2Image',
				'service3Title', 'service3Desc', 'service3Image',
				'partsTitle', 'partsSubtitle',
				'footerDesc', 'footerContactsTitle', 'footerServicesTitle', 'footerServicesDesc', 'copyrightText',
				'modalTitle', 'modalSubtitle', 'modalSubmitBtnText'
			];

			async function loadCmsConfig() {
				try {
					let cfg = null;
					if (window.supabaseClient) {
						try {
							const { data } = await window.supabaseClient.from('site_settings').select('*').eq('id', 'default').single();
							if (data && data.config) cfg = data.config;
						} catch (e) {}
					}
					if (!cfg) {
						const res = await fetch('/admin/api/config');
						if (res.ok) cfg = await res.json();
					}
					if (!cfg) {
						const res = await fetch('/api/config.json');
						if (res.ok) cfg = await res.json();
					}
					if (cfg) {
						cmsFields.forEach(f => {
							const el = document.getElementById(`cms-${f}`);
							if (el && cfg[f] !== undefined) el.value = cfg[f];
						});
					}
				} catch (err) {
					console.warn('Failed loading CMS config:', err);
				}
			}

			async function saveCmsSettings() {
				const alertEl = document.getElementById('cms-alert');
				alertEl?.classList.add('hidden');
				const payload = {};
				cmsFields.forEach(f => {
					const el = document.getElementById(`cms-${f}`);
					if (el) payload[f] = el.value.trim();
				});

				try {
					const res = await fetch('/admin/api/config', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload)
					});

					if (window.supabaseClient) {
						try {
							await window.supabaseClient.from('site_settings').upsert([{ id: 'default', config: payload, updated_at: new Date().toISOString() }]);
						} catch (e) {}
					}

					if (alertEl) {
						alertEl.textContent = 'Կարգավորումները հաջողությամբ պահպանվեցին։';
						alertEl.classList.remove('hidden');
						setTimeout(() => alertEl.classList.add('hidden'), 4000);
					}
				} catch (err) {
					alert('Սխալ պահպանելիս: ' + (err.message || err));
				}
			}

			initAuth();
		</script>
	</body>
</html>
