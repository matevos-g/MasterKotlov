<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-50">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MasterKotlov</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Armenian:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="/supabase-config.js"></script>
		<!-- PWA Manifest & iOS Standalone Meta Tags -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="MasterKotlov" />
		<link rel="apple-touch-icon" href="/images/icon.svg" />
		<meta name="theme-color" content="#2563eb" />
		<script>
			if (('standalone' in window.navigator) && window.navigator.standalone) {
				document.addEventListener('click', function(e) {
					let node = e.target;
					while (node && node.nodeName !== 'A' && node !== document.body) {
						node = node.parentNode;
					}
					if (node && node.nodeName === 'A' && node.getAttribute('href') && !node.getAttribute('target')) {
						e.preventDefault();
						window.location.replace(node.getAttribute('href'));
					}
				}, false);
			}
		</script>
		<style>
			body { font-family: 'Inter', 'Noto Sans Armenian', sans-serif; }
		</style>
	</head>
	<body class="flex h-full items-center justify-center p-4">
		<div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
			<div class="text-center mb-6">
				<h1 class="text-2xl font-bold text-slate-900 tracking-tight">MasterKotlov</h1>
			</div>

			<form id="admin-login-form" class="space-y-4">
				<div id="login-error" class="hidden rounded-lg bg-red-50 p-3 text-xs font-medium text-red-600 border border-red-100"></div>

				<div>
					<label for="username" class="block text-xs font-medium text-slate-700">Օգտանուն</label>
					<input id="username" name="username" type="text" autocomplete="username" required placeholder="admin" class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-blue-600 focus:ring-1 focus:ring-blue-600" />
				</div>

				<div>
					<label for="password" class="block text-xs font-medium text-slate-700">Գաղտնաբառ</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required placeholder="••••••••" class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-900 placeholder-slate-400 outline-none transition focus:border-blue-600 focus:ring-1 focus:ring-blue-600" />
				</div>

				<button type="submit" id="login-btn" class="w-full rounded-lg bg-blue-600 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 active:scale-[0.99] transition">
					Մուտք Գործել
				</button>
			</form>
		</div>

		<script>
			async function checkSession() {
				if (window.supabaseClient) {
					const { data: { session } } = await window.supabaseClient.auth.getSession();
					if (session) {
						window.location.replace('/admin/web/');
					}
				}
			}
			checkSession();

			const form = document.getElementById('admin-login-form');
			const loginError = document.getElementById('login-error');
			const loginBtn = document.getElementById('login-btn');

			function getArmenianAuthErrorMessage(err) {
				if (!err) return 'Սխալ մուտքային տվյալներ։';
				const msg = String(err.message || err).toLowerCase();

				if (msg.includes('invalid login credentials') || msg.includes('invalid_credentials')) {
					return 'Սխալ օգտանուն կամ գաղտնաբառ։';
				}
				if (msg.includes('user not found')) {
					return 'Այս օգտանունով օգտատեր չի գտնվել։';
				}
				if (msg.includes('email not confirmed')) {
					return 'Էլ․ փոստը հաստատված չէ։';
				}
				if (msg.includes('too many requests') || msg.includes('rate limit')) {
					return 'Չափազանց շատ փորձեր։ Խնդրում ենք սպասել 1 րոպե։';
				}
				if (msg.includes('network') || msg.includes('fetch')) {
					return 'Կապի սխալ։ Խնդրում ենք ստուգել ինտերնետ կապը։';
				}
				return 'Սխալ մուտքային տվյալներ։ Խնդրում ենք ստուգել տվյալները։';
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				loginError.classList.add('hidden');
				let userInput = document.getElementById('username').value.trim();
				const password = document.getElementById('password').value.trim();

				let email = userInput;
				if (!email.includes('@')) {
					email = `${email.toLowerCase()}@masterkotlov.am`;
				}

				loginBtn.disabled = true;
				loginBtn.innerText = 'Ստուգվում է...';

				try {
					if (!window.supabaseClient) {
						throw new Error('Supabase-ը կարգավորված չէ։ Խնդրում ենք լրացնել supabase-config.js ֆայլը։');
					}

					const { data, error } = await window.supabaseClient.auth.signInWithPassword({ email, password });
					if (error) throw error;
					
					window.location.replace('/admin/web/');
				} catch (err) {
					loginError.textContent = getArmenianAuthErrorMessage(err);
					loginError.classList.remove('hidden');
				} finally {
					loginBtn.disabled = false;
					loginBtn.innerText = 'Մուտք Գործել';
				}
			});
		</script>
	</body>
</html>
