<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-50 text-slate-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<title>MasterKotlov - Mobile Admin</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Armenian:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
		<script src="/supabase-config.js"></script>
		<!-- PWA Manifest & iOS Meta -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="MasterKotlov" />
		<link rel="apple-touch-icon" href="/images/icon.svg" />
		<meta name="theme-color" content="#2563eb" />
		<style>
			body { font-family: 'Inter', 'Noto Sans Armenian', sans-serif; }
			.mobile-nav-item.active { color: #2563eb; }
			.mobile-nav-item.active svg { stroke: #2563eb; fill: rgba(37, 99, 235, 0.1); }
		</style>
	</head>
	<body class="min-h-full flex flex-col bg-slate-50 selection:bg-blue-100">
		
		<!-- ========================================== -->
		<!-- TOP SAFE AREA HEADER                       -->
		<!-- ========================================== -->
		<header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/95 backdrop-blur-md px-4 pb-3" style="padding-top: max(12px, env(safe-area-inset-top));">
			<div class="flex items-center justify-between">
				<div>
					<h1 id="mobile-header-title" class="text-base font-extrabold text-slate-900 tracking-tight">Պատվերներ</h1>
					<span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">MasterKotlov Mobile PWA</span>
				</div>

				<div class="flex items-center gap-2">
					<button id="notif-perm-btn" type="button" onclick="requestNotificationPermission()" title="Ծանուցումներ" class="relative text-slate-500 hover:text-blue-600 p-1.5 rounded-lg border border-slate-200 hover:bg-blue-50 transition">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
						</svg>
						<span id="notif-badge-dot" class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
					</button>
					<span id="mobile-user-badge" class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200">admin</span>
					<button id="logout-btn" type="button" title="Ելք" class="text-slate-500 hover:text-red-600 p-1.5 rounded-lg border border-slate-200 hover:bg-red-50 transition">
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
						</svg>
					</button>
				</div>
			</div>
		</header>

		<!-- ========================================== -->
		<!-- MAIN CONTENT AREA                          -->
		<!-- ========================================== -->
		<main class="w-full flex-1 px-4 pt-4 pb-28">

			<!-- PAGE 1: ORDERS (ՊԱՏՎԵՐՆԵՐ) -->
			<section id="page-orders" class="space-y-4">
				<!-- Top Bar: ONLY Status Picker Dropdown + '+' Add Order Button -->
				<div class="flex items-center justify-between gap-3 pb-3 border-b border-slate-200">
					<select id="order-status-select" class="flex-1 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-800 outline-none focus:border-blue-600 shadow-xs transition cursor-pointer">
						<option value="new">Սպասող</option>
						<option value="in_progress">Ընթացքի մեջ</option>
						<option value="completed">Ավարտված</option>
						<option value="cancelled">Չեղարկված</option>
					</select>

					<button id="add-order-btn" type="button" class="h-10 w-10 shrink-0 flex items-center justify-center rounded-xl bg-blue-600 text-white font-extrabold text-2xl shadow-sm hover:bg-blue-700 active:scale-95 transition" title="Ավելացնել Պատվեր">
						+
					</button>
				</div>

				<!-- Orders Cards Grid List for Mobile (1 item per row) -->
				<div id="orders-list-mobile" class="space-y-3">
					<div class="p-6 text-center text-slate-400 text-xs">Բեռնվում է...</div>
				</div>
			</section>

			<!-- PAGE 2: FINANCE (ՖԻՆԱՆՍՆԵՐ) -->
			<section id="page-finance" class="hidden space-y-5">
				<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm space-y-4">
					<div class="flex items-center justify-between border-b border-slate-100 pb-3">
						<div>
							<h2 class="text-base font-bold text-slate-900">Ֆինանսական Ամփոփում</h2>
							<p class="text-[11px] text-slate-500">Եկամուտների մատյան</p>
						</div>

						<select id="finance-range-select" class="rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-700 outline-none focus:border-blue-600">
							<option value="current_month">Այս Ամիս</option>
							<option value="last_month">Անցյալ Ամիս</option>
							<option value="current_year">Այս Տարի</option>
							<option value="all">Ամբողջ Ժամանակահատվածը</option>
						</select>
					</div>

					<div class="text-center py-2">
						<span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Ընդհանուր Եկամուտ</span>
						<div class="mt-0.5 text-3xl font-extrabold text-blue-600 tracking-tight" id="total-earnings-display">
							0 Դրամ
						</div>
					</div>

					<!-- Bar Chart Canvas -->
					<div class="pt-4 border-t border-slate-100">
						<div class="flex items-center justify-between mb-2">
							<span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Գրաֆիկ</span>
							<span id="chart-subtitle" class="text-[11px] font-medium text-slate-500"></span>
						</div>
						<div class="h-56 w-full relative">
							<canvas id="finance-chart"></canvas>
						</div>
					</div>
				</div>

				<div class="space-y-2.5">
					<h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Վերջին 10 Գործարքները</h3>
					<div id="ledger-list-mobile" class="space-y-2">
						<div class="p-6 text-center text-slate-400 text-xs">Գործարքներ չկան</div>
					</div>
				</div>
			</section>

			<!-- PAGE 3: PRODUCTS (ԱՊՐԱՆՔՆԵՐ) -->
			<section id="page-products" class="hidden space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-base font-bold text-slate-900">Ապրանքներ</h2>
					<a href="/admin/mobile/products/new/" class="rounded-xl bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 transition">
						+ Ավելացնել
					</a>
				</div>

				<div id="products-list-mobile" class="grid grid-cols-1 gap-3">
					<div class="p-6 text-center text-slate-400 text-xs">Բեռնվում է...</div>
				</div>
			</section>

			<!-- PAGE 4: USERS (ՕԳՏԱՏԵՐԵՐ) -->
			<section id="page-users" class="hidden space-y-4">
				<div class="flex items-center justify-between">
					<h2 class="text-base font-bold text-slate-900">Ադմինիստրատորներ</h2>
					<button id="add-user-btn" type="button" class="rounded-xl bg-blue-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 transition">
						+ Ավելացնել Ադմին
					</button>
				</div>

				<div id="users-list-mobile" class="space-y-2.5">
					<div class="p-6 text-center text-slate-400 text-xs">Բեռնվում է...</div>
				</div>
			</section>

		</main>

		<!-- ========================================== -->
		<!-- BOTTOM APP NAVBAR WITH 4 ICONS             -->
		<!-- ========================================== -->
		<nav class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/80 shadow-lg" style="padding-bottom: max(6px, env(safe-area-inset-bottom));">
			<div class="grid grid-cols-4 items-center h-16 max-w-md mx-auto px-2">
				<!-- Tab 1: Orders -->
				<button id="mobile-nav-orders" type="button" class="mobile-nav-item active flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
					</svg>
					<span class="text-[10px] font-medium tracking-tight">Պատվերներ</span>
				</button>

				<!-- Tab 2: Finance -->
				<button id="mobile-nav-finance" type="button" class="mobile-nav-item flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<span class="text-[10px] font-medium tracking-tight">Ֆինանսներ</span>
				</button>

				<!-- Tab 3: Products -->
				<button id="mobile-nav-products" type="button" class="mobile-nav-item flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
					</svg>
					<span class="text-[10px] font-medium tracking-tight">Ապրանքներ</span>
				</button>

				<!-- Tab 4: Users -->
				<button id="mobile-nav-users" type="button" class="mobile-nav-item flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
					</svg>
					<span class="text-[10px] font-medium tracking-tight">Օգտատերեր</span>
				</button>
			</div>
		</nav>

		<!-- ========================================== -->
		<!-- DRAWER 1: ORDER DETAILS SLIDE-OVER DRAWER  -->
		<!-- ========================================== -->
		<div id="drawer-order-details" class="fixed inset-0 z-50 hidden">
			<div onclick="closeDrawer('drawer-order-details')" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity"></div>
			<div class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white shadow-2xl border-l border-slate-200 flex flex-col justify-between overflow-hidden">
				
				<div class="flex-1 overflow-y-auto p-6 space-y-5">
					<div class="flex items-center justify-between border-b border-slate-100 pb-3">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-400">Պատվերի Մանրամասներ</span>
						<button onclick="closeDrawer('drawer-order-details')" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition">✕</button>
					</div>

					<div class="space-y-4">
						<div>
							<span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Հաճախորդ</span>
							<h2 id="detail-client-name" class="text-xl font-extrabold text-slate-900 tracking-tight"></h2>
						</div>

						<div class="grid grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100">
							<div>
								<span class="text-[11px] font-medium text-slate-400 block mb-0.5">Ամսաթիվ / Ժամ</span>
								<div id="detail-client-date" class="text-xs font-semibold text-slate-800"></div>
							</div>
							<div>
								<span class="text-[11px] font-medium text-slate-400 block mb-0.5">Հեռախոսահամար</span>
								<div id="detail-client-phone" class="text-xs font-semibold font-mono text-blue-600"></div>
							</div>
						</div>

						<div id="detail-product-box" class="hidden">
							<span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Ընտրված Ապրանք</span>
							<div id="detail-product-name" class="p-3 rounded-xl bg-blue-50/60 border border-blue-100 text-xs font-bold text-blue-900"></div>
						</div>

						<div>
							<span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Խնդրի Նկարագրություն</span>
							<div id="detail-problem-text" class="p-3.5 rounded-xl bg-slate-50 border border-slate-100 text-xs leading-relaxed text-slate-700 whitespace-pre-wrap"></div>
						</div>

						<div>
							<span class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1">Կարգավիճակ</span>
							<div id="detail-status-badge"></div>
						</div>
					</div>
				</div>

				<!-- Bottom 3 Armenian Buttons -->
				<div id="detail-drawer-actions" class="border-t border-slate-200 bg-slate-50 p-4 flex flex-col gap-2.5">
					<!-- Injected dynamically -->
				</div>
			</div>
		</div>

		<!-- ========================================== -->
		<!-- DRAWER 2: ADD NEW ORDER SLIDE-OVER DRAWER  -->
		<!-- ========================================== -->
		<div id="drawer-add-order" class="fixed inset-0 z-50 hidden">
			<div onclick="closeDrawer('drawer-add-order')" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity"></div>
			<div class="fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white shadow-2xl border-l border-slate-200 flex flex-col justify-between overflow-hidden">
				
				<div class="flex-1 overflow-y-auto p-6 space-y-5">
					<div class="flex items-center justify-between border-b border-slate-100 pb-3">
						<h2 class="text-lg font-extrabold text-slate-900">Ավելացնել Նոր Պատվեր</h2>
						<button onclick="closeDrawer('drawer-add-order')" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition">✕</button>
					</div>

					<form id="form-add-order-drawer" class="space-y-4">
						<div>
							<label class="block text-xs font-bold uppercase text-slate-600 mb-1">Անուն *</label>
							<input type="text" id="new-order-firstname" required placeholder="Արմեն" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 transition" />
						</div>

						<div>
							<label class="block text-xs font-bold uppercase text-slate-600 mb-1">Ազգանուն *</label>
							<input type="text" id="new-order-lastname" required placeholder="Սարգսյան" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 transition" />
						</div>

						<div>
							<label class="block text-xs font-bold uppercase text-slate-600 mb-1">Հեռախոսահամար *</label>
							<input type="tel" id="new-order-phone" required placeholder="099123456" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm font-mono text-slate-900 outline-none focus:border-blue-600 transition" />
						</div>

						<div>
							<label class="block text-xs font-bold uppercase text-slate-600 mb-1">Ապրանք (Ընտրովի)</label>
							<select id="new-order-product" class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 bg-white transition">
								<option value="">-- Առանց ապրանքի --</option>
							</select>
						</div>

						<div>
							<label class="block text-xs font-bold uppercase text-slate-600 mb-1">Խնդրի Նկարագրություն *</label>
							<textarea id="new-order-problem" rows="3" required placeholder="Նկարագրեք պատվերը..." class="w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 resize-none transition"></textarea>
						</div>

						<div class="pt-2">
							<button type="submit" class="w-full rounded-xl bg-blue-600 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition">
								Հաստատել և Ավելացնել Պատվերը
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- ========================================== -->
		<!-- MODAL 2: EARNINGS AMOUNT ENTRY MODAL       -->
		<!-- ========================================== -->
		<div id="modal-earnings" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<h3 class="text-base font-bold text-slate-900">Ավարտել Պատվերը</h3>
				<p class="text-xs text-slate-500">Մուտքագրեք այս պատվերից ստացված վերջնական գումարը (Դրամ)։</p>

				<form id="form-earnings" class="space-y-4">
					<input type="hidden" id="earnings-order-id" />
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Վաստակած Գումար (Դրամ) *</label>
						<input type="number" id="earnings-amount" min="0" step="1000" required placeholder="25000" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div class="flex justify-end gap-2 pt-2">
						<button type="button" onclick="closeModal('modal-earnings')" class="rounded-lg bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700">Չեղարկել</button>
						<button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-medium text-white hover:bg-blue-700 shadow-sm">Հաստատել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- ========================================== -->
		<!-- MODAL 3: ARE YOU SURE? CONFIRMATION PROMPT -->
		<!-- ========================================== -->
		<div id="modal-confirm" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4 text-center">
				<h3 class="text-base font-bold text-slate-900" id="confirm-modal-title">Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:</h3>
				<p class="text-xs text-slate-500" id="confirm-modal-desc">Այս գործողությունը չի կարող չեղարկվել։</p>
				<div class="flex justify-center gap-3 pt-2">
					<button type="button" onclick="closeModal('modal-confirm')" class="rounded-lg bg-slate-100 px-4 py-2 text-xs font-medium text-slate-700">Ոչ, Չեղարկել</button>
					<button id="confirm-action-btn" type="button" class="rounded-lg bg-red-600 px-4 py-2 text-xs font-medium text-white shadow-sm">Այո, Հաստատել</button>
				</div>
			</div>
		</div>

		<!-- MODAL 4: ADD ADMIN USER MODAL -->
		<div id="modal-add-user" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<h3 class="text-base font-bold text-slate-900">Ավելացնել Նոր Ադմին</h3>
				<form id="form-add-user" class="space-y-3">
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Անուն *</label>
						<input type="text" id="new-user-fullname" required placeholder="Գոռ" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Օգտանուն *</label>
						<input type="text" id="new-user-username" required placeholder="admin" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Գաղտնաբառ *</label>
						<input type="password" id="new-user-pass" required placeholder="••••••••" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div class="flex justify-end gap-2 pt-2">
						<button type="button" onclick="closeModal('modal-add-user')" class="rounded-lg bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700">Չեղարկել</button>
						<button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-medium text-white shadow-sm">Ավելացնել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- MODAL 4.5: EDIT ADMIN USER MODAL -->
		<div id="modal-edit-user" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<h3 class="text-base font-bold text-slate-900">Խմբագրել Ադմինին</h3>
				<form id="form-edit-user" class="space-y-3">
					<input type="hidden" id="edit-user-id" />
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Անուն *</label>
						<input type="text" id="edit-user-fullname" required placeholder="Գոռ" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Օգտանուն *</label>
						<input type="text" id="edit-user-username" required placeholder="admin" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div class="flex justify-end gap-2 pt-2">
						<button type="button" onclick="closeModal('modal-edit-user')" class="rounded-lg bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700">Չեղարկել</button>
						<button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-medium text-white shadow-sm">Պահպանել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- MODAL 5: RESET PASSWORD MODAL -->
		<div id="modal-reset-pass" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4">
				<h3 class="text-base font-bold text-slate-900">Փոխել Գաղտնաբառը</h3>
				<form id="form-reset-pass" class="space-y-3">
					<div>
						<label class="block text-xs font-medium text-slate-700 mb-1">Նոր Գաղտնաբառ *</label>
						<input type="password" id="reset-new-pass" required placeholder="••••••••" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-900 outline-none focus:border-blue-600" />
					</div>
					<div class="flex justify-end gap-2 pt-2">
						<button type="button" onclick="closeModal('modal-reset-pass')" class="rounded-lg bg-slate-100 px-3.5 py-2 text-xs font-medium text-slate-700">Չեղարկել</button>
						<button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-xs font-medium text-white shadow-sm">Պահպանել</button>
					</div>
				</form>
			</div>
		</div>

		<!-- CLIENT JS SCRIPT -->
		<script>
			let allOrders = [];
			let allProducts = [];
			let allLedger = [];
			let allAdminUsers = [];
			let currentOrderTab = 'new';
			let confirmCallback = null;
			let currentSessionUser = null;
			let financeChartInstance = null;

			// Notification & PWA State
			let isInitialOrdersLoad = true;
			const knownOrderIds = new Set();

			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').then(reg => {
						console.log('PWA ServiceWorker ready:', reg);
					}).catch(err => console.warn('SW reg failed:', err));
				});
			}

			const pageTitles = {
				orders: 'Պատվերներ',
				finance: 'Ֆինանսներ',
				products: 'Ապրանքներ',
				users: 'Օգտատերեր'
			};

			function escapeHtml(str) {
				if (!str) return '';
				return String(str)
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#039;');
			}

			async function initAuth() {
				if (!window.supabaseClient) {
					window.location.href = '/admin/mobile/login/';
					return;
				}
				const { data: { session } } = await window.supabaseClient.auth.getSession();
				if (!session) {
					window.location.href = '/admin/mobile/login/';
					return;
				}
				currentSessionUser = session.user;
				const userEmail = currentSessionUser.email || '';
				const usernameDisplay = userEmail.endsWith('@masterkotlov.am') ? userEmail.replace('@masterkotlov.am', '') : userEmail;
				document.getElementById('mobile-user-badge').textContent = usernameDisplay;
				
				updateNotifBellState();
				loadAllData();
				setupSupabaseRealtime();
			}

			const pages = ['orders', 'finance', 'products', 'users'];
			function switchPage(activePage) {
				pages.forEach(p => {
					const el = document.getElementById(`page-${p}`);
					const mobBtn = document.getElementById(`mobile-nav-${p}`);
					if (p === activePage) {
						el.classList.remove('hidden');
						mobBtn?.classList.add('active');
					} else {
						el.classList.add('hidden');
						mobBtn?.classList.remove('active');
					}
				});
				document.getElementById('mobile-header-title').textContent = pageTitles[activePage] || 'MasterKotlov';
			}

			pages.forEach(p => {
				document.getElementById(`mobile-nav-${p}`)?.addEventListener('click', () => switchPage(p));
			});

			// Order Status Selector change handler
			document.getElementById('order-status-select')?.addEventListener('change', (e) => {
				currentOrderTab = e.target.value;
				renderOrdersList();
			});

			async function loadAllData() {
				await Promise.all([fetchOrders(), fetchProducts(), fetchLedger(), fetchUsers()]);
			}

			async function fetchOrders() {
				try {
					const { data, error } = await window.supabaseClient
						.from('service_requests')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data) {
						processIncomingOrders(data);
						allOrders = data;
						renderOrdersList();
					}
				} catch (err) {
					console.error('Fetch orders error:', err);
				}
			}

			function processIncomingOrders(orders) {
				if (isInitialOrdersLoad) {
					orders.forEach(o => knownOrderIds.add(o.id));
					isInitialOrdersLoad = false;
					return;
				}

				orders.forEach(o => {
					if (!knownOrderIds.has(o.id)) {
						knownOrderIds.add(o.id);
						if (o.status === 'new') {
							triggerArmenianPushNotification(o);
						}
					}
				});
			}

			function triggerArmenianPushNotification(order) {
				const clientName = `${order.first_name || ''} ${order.last_name || ''}`.trim() || 'Հաճախորդ';
				const phone = order.phone || '';
				const title = '🔔 Նոր Պատվեր!';
				const body = `Ստացվել է նոր պատվեր MasterKotlov-ում:\n${clientName} - ${phone}`;

				if (navigator.vibrate) {
					navigator.vibrate([200, 100, 200]);
				}

				if ('Notification' in window && Notification.permission === 'granted') {
					if (navigator.serviceWorker && navigator.serviceWorker.ready) {
						navigator.serviceWorker.ready.then(reg => {
							reg.showNotification(title, {
								body: body,
								icon: '/images/icon.svg',
								badge: '/images/icon.svg',
								vibrate: [200, 100, 200],
								data: { url: '/admin/mobile/' },
								tag: 'order-' + order.id,
								renotify: true
							});
						});
					} else {
						new Notification(title, {
							body: body,
							icon: '/images/icon.svg',
							data: { url: '/admin/mobile/' }
						});
					}
				}
			}

			async function requestNotificationPermission() {
				if (!('Notification' in window)) {
					alert('Ձեր սարքը կամ բրաուզերը չի աջակցում ծանուցումներ։');
					return;
				}
				const perm = await Notification.requestPermission();
				updateNotifBellState(perm);
				if (perm === 'granted') {
					if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
					triggerArmenianPushNotification({
						id: 'test-' + Date.now(),
						first_name: 'Ծանուցումները',
						last_name: 'Միացված են',
						phone: 'MasterKotlov',
						status: 'new'
					});
				} else if (perm === 'denied') {
					alert('Ծանուցումները արգելափակված են։ Խնդրում ենք թույլատրել դրանք բրաուզերի կարգավորումներում։');
				}
			}

			function updateNotifBellState(perm) {
				const dot = document.getElementById('notif-badge-dot');
				if (dot) {
					const currentPerm = perm || (('Notification' in window) ? Notification.permission : 'default');
					if (currentPerm === 'granted') {
						dot.className = 'absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-500';
					} else if (currentPerm === 'denied') {
						dot.className = 'absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-red-500';
					} else {
						dot.className = 'absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-500 animate-pulse';
					}
				}
			}

			function setupSupabaseRealtime() {
				if (window.supabaseClient) {
					try {
						window.supabaseClient
							.channel('public:service_requests_mobile')
							.on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'service_requests' }, payload => {
								const newOrder = payload.new;
								if (newOrder) {
									if (!knownOrderIds.has(newOrder.id)) {
										knownOrderIds.add(newOrder.id);
										triggerArmenianPushNotification(newOrder);
										fetchOrders();
									}
								}
							})
							.subscribe();
					} catch (e) {
						console.warn('Realtime subscription error:', e);
					}
				}
			}

			async function fetchProducts() {
				try {
					const { data, error } = await window.supabaseClient
						.from('products')
						.select('*')
						.order('id', { ascending: true });

					if (!error && data && data.length) {
						allProducts = data;
					} else {
						const res = await fetch('/api/products.json');
						if (res.ok) allProducts = await res.json();
					}
					renderProductsList();
				} catch (err) {
					console.error('Fetch products error:', err);
				}
			}

			async function fetchLedger() {
				try {
					const { data, error } = await window.supabaseClient
						.from('finance_ledger')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error) {
						allLedger = data || [];
						renderFinancePage();
					}
				} catch (err) {
					console.error('Fetch ledger error:', err);
				}
			}

			async function fetchUsers() {
				try {
					const { data, error } = await window.supabaseClient
						.from('admin_users')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data && data.length) {
						allAdminUsers = data;
					} else {
						const email = currentSessionUser ? (currentSessionUser.email || '') : '';
						const uname = email.endsWith('@masterkotlov.am') ? email.replace('@masterkotlov.am', '') : (email || 'admin');
						allAdminUsers = [{
							id: 'default-1',
							name: 'Գոռ',
							username: uname,
							email: email || 'admin@masterkotlov.am',
							status: 'active'
						}];
					}
					renderUsersList();
				} catch (err) {
					console.error('Fetch users error:', err);
					renderUsersList();
				}
			}

			function getStatusBadgeHTML(status) {
				const badges = {
					new: '<span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 border border-amber-200">Սպասող</span>',
					in_progress: '<span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-200">Ընթացքի մեջ</span>',
					completed: '<span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200">Ավարտված</span>',
					cancelled: '<span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 border border-red-200">Չեղարկված</span>'
				};
				return badges[status] || status;
			}

			function renderOrdersList() {
				const container = document.getElementById('orders-list-mobile');
				const filtered = allOrders.filter(o => o.status === currentOrderTab);

				if (!filtered.length) {
					container.innerHTML = `
						<div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400 text-xs bg-white">
							Այս բաժնում պատվերներ չկան
						</div>
					`;
					return;
				}

				container.innerHTML = filtered.map(o => {
					const d = new Date(o.created_at);
					const dateStr = d.toLocaleDateString('hy-AM', { 
						year: 'numeric', month: '2-digit', day: '2-digit', 
						hour: '2-digit', minute: '2-digit', hour12: false 
					});
					const statusBadge = getStatusBadgeHTML(o.status);
					const fullName = `${escapeHtml(o.first_name || '')} ${escapeHtml(o.last_name || '')}`.trim() || 'Հաճախորդ';

					return `
						<div onclick="openOrderDetailsDrawer('${o.id}')" class="group relative flex flex-col justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs hover:border-blue-300 transition cursor-pointer">
							<div class="flex items-center justify-between">
								<span class="text-sm font-bold text-slate-900">${fullName}</span>
								${statusBadge}
							</div>
							<div class="flex flex-wrap items-center justify-between gap-2 text-xs font-medium text-slate-500 pt-1 border-t border-slate-100">
								<span class="flex items-center gap-1">📅 ${dateStr}</span>
								<span class="flex items-center gap-1 font-mono text-blue-600 font-semibold">📞 ${escapeHtml(o.phone || '')}</span>
							</div>
						</div>
					`;
				}).join('');
			}

			function openOrderDetailsDrawer(orderId) {
				const o = allOrders.find(item => item.id === orderId);
				if (!o) return;

				const d = new Date(o.created_at);
				const dateStr = d.toLocaleDateString('hy-AM', {
					year: 'numeric', month: '2-digit', day: '2-digit',
					hour: '2-digit', minute: '2-digit', hour12: false
				});

				const fullName = `${o.first_name || ''} ${o.last_name || ''}`.trim() || 'Հաճախորդ';
				const cleanPhone = (o.phone || '').replace(/\s+/g, '');

				document.getElementById('detail-client-name').textContent = fullName;
				document.getElementById('detail-client-date').textContent = dateStr;
				document.getElementById('detail-client-phone').textContent = o.phone || '';
				document.getElementById('detail-problem-text').textContent = o.problem_description || 'Նկարագրություն առկա չէ';
				document.getElementById('detail-status-badge').innerHTML = getStatusBadgeHTML(o.status);

				const prodBox = document.getElementById('detail-product-box');
				if (o.product_name) {
					document.getElementById('detail-product-name').textContent = o.product_name;
					prodBox.classList.remove('hidden');
				} else {
					prodBox.classList.add('hidden');
				}

				const actionsContainer = document.getElementById('detail-drawer-actions');
				
				let continueBtnHTML = '';
				if (o.status === 'new') {
					continueBtnHTML = `<button onclick="changeOrderStatus('${o.id}', 'in_progress'); closeDrawer('drawer-order-details');" class="w-full rounded-xl bg-blue-600 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>▶</span> <span>Սկսել / Շարունակել</span></button>`;
				} else if (o.status === 'in_progress') {
					continueBtnHTML = `<button onclick="closeDrawer('drawer-order-details'); openEarningsModal('${o.id}');" class="w-full rounded-xl bg-blue-600 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>✓</span> <span>Ավարտել Պատվերը</span></button>`;
				} else if (o.status === 'completed') {
					continueBtnHTML = `<button disabled class="w-full rounded-xl bg-slate-100 py-3 text-sm font-semibold text-slate-400 cursor-not-allowed">Պատվերն Ավարտված է</button>`;
				} else {
					continueBtnHTML = `<button disabled class="w-full rounded-xl bg-slate-100 py-3 text-sm font-semibold text-slate-400 cursor-not-allowed">Պատվերը Չեղարկված է</button>`;
				}

				let cancelBtnHTML = '';
				if (o.status !== 'cancelled' && o.status !== 'completed') {
					cancelBtnHTML = `<button onclick="promptConfirm('Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:', () => { changeOrderStatus('${o.id}', 'cancelled'); closeDrawer('drawer-order-details'); })" class="w-full rounded-xl bg-red-50 border border-red-200 py-3 text-sm font-bold text-red-600 hover:bg-red-100 active:scale-95 transition flex items-center justify-center gap-2"><span>✕</span> <span>Չեղարկել Պատվերը</span></button>`;
				} else {
					cancelBtnHTML = `<button onclick="closeDrawer('drawer-order-details')" class="w-full rounded-xl bg-slate-100 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-200 transition">Փակել</button>`;
				}

				actionsContainer.innerHTML = `
					<a href="tel:${cleanPhone}" class="w-full text-center rounded-xl bg-emerald-600 py-3 text-sm font-bold text-white shadow-md hover:bg-emerald-700 active:scale-95 transition flex items-center justify-center gap-2">
						<span>📞</span> <span>Զանգահարել Հաճախորդին</span>
					</a>
					${continueBtnHTML}
					${cancelBtnHTML}
				`;

				document.getElementById('drawer-order-details').classList.remove('hidden');
			}

			function closeDrawer(id) {
				document.getElementById(id)?.classList.add('hidden');
			}

			function closeModal(id) {
				document.getElementById(id)?.classList.add('hidden');
			}

			async function changeOrderStatus(orderId, newStatus) {
				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.update({ status: newStatus })
						.eq('id', orderId);

					if (!error) fetchOrders();
				} catch (err) {
					console.error('Update status error:', err);
				}
			}

			function openEarningsModal(orderId) {
				document.getElementById('earnings-order-id').value = orderId;
				document.getElementById('earnings-amount').value = '';
				document.getElementById('modal-earnings').classList.remove('hidden');
			}

			document.getElementById('form-earnings').addEventListener('submit', async (e) => {
				e.preventDefault();
				const orderId = document.getElementById('earnings-order-id').value;
				const amount = Number(document.getElementById('earnings-amount').value);
				const order = allOrders.find(o => o.id === orderId);

				try {
					await window.supabaseClient.from('service_requests').update({ status: 'completed' }).eq('id', orderId);
					await window.supabaseClient.from('finance_ledger').insert([{
						order_id: orderId,
						amount: amount,
						client_name: order ? `${order.first_name || ''} ${order.last_name || ''}`.trim() : 'Հաճախորդ',
						notes: order ? (order.product_name || order.problem_description || '') : ''
					}]);

					closeModal('modal-earnings');
					fetchOrders();
					fetchLedger();
				} catch (err) {
					alert('Սխալ պատվերը ավարտելիս');
				}
			});

			function promptConfirm(title, onConfirm) {
				document.getElementById('confirm-modal-title').textContent = title || 'Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:';
				confirmCallback = onConfirm;
				document.getElementById('modal-confirm').classList.remove('hidden');
			}

			document.getElementById('confirm-action-btn').addEventListener('click', () => {
				if (confirmCallback) confirmCallback();
				closeModal('modal-confirm');
			});

			// Finance Logic & Bar Chart
			function renderFinanceChart(labels, dataValues, subtitleText) {
				const subtitleEl = document.getElementById('chart-subtitle');
				if (subtitleEl) subtitleEl.textContent = subtitleText;

				const canvas = document.getElementById('finance-chart');
				if (!canvas || !window.Chart) return;
				const ctx = canvas.getContext('2d');

				if (financeChartInstance) {
					financeChartInstance.destroy();
				}

				financeChartInstance = new Chart(ctx, {
					type: 'bar',
					data: {
						labels: labels,
						datasets: [{
							label: 'Եկամուտ (Դրամ)',
							data: dataValues,
							backgroundColor: 'rgba(37, 99, 235, 0.85)',
							borderRadius: 6,
							maxBarThickness: 24
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { display: false },
							tooltip: {
								callbacks: {
									label: (c) => ` Եկամուտ: ${(c.raw || 0).toLocaleString('hy-AM')} Դրամ`
								}
							}
						},
						scales: {
							x: { grid: { display: false }, ticks: { font: { size: 10 } } },
							y: {
								grid: { color: '#f1f5f9' },
								ticks: {
									font: { size: 10 },
									callback: (v) => v >= 1000 ? (v / 1000) + ' հզ' : v
								}
							}
						}
					}
				});
			}

			function renderFinancePage() {
				const range = document.getElementById('finance-range-select').value;
				const now = new Date();
				let filteredLedger = allLedger;

				if (range === 'current_month') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
					});
				} else if (range === 'last_month') {
					const lastMonthDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === lastMonthDate.getMonth() && d.getFullYear() === lastMonthDate.getFullYear();
					});
				} else if (range === 'current_year') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getFullYear() === now.getFullYear();
					});
				}

				const total = filteredLedger.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
				document.getElementById('total-earnings-display').textContent = `${total.toLocaleString('hy-AM')} Դրամ`;

				const ledgerContainer = document.getElementById('ledger-list-mobile');
				const last10 = filteredLedger.slice(0, 10);

				if (!last10.length) {
					ledgerContainer.innerHTML = `<div class="rounded-2xl border border-dashed border-slate-200 p-6 text-center text-slate-400 text-xs bg-white">Գործարքներ չկան</div>`;
				} else {
					ledgerContainer.innerHTML = last10.map(l => {
						const d = new Date(l.created_at);
						const dateStr = d.toLocaleDateString('hy-AM', { 
							year: 'numeric', month: '2-digit', day: '2-digit', 
							hour: '2-digit', minute: '2-digit', hour12: false 
						});
						const notesStr = l.notes ? `<p class="text-[11px] text-slate-500 mt-0.5">${escapeHtml(l.notes)}</p>` : '';

						return `
							<div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-3.5 shadow-xs">
								<div>
									<h4 class="text-xs font-bold text-slate-900">${escapeHtml(l.client_name || 'Հաճախորդ')}</h4>
									<p class="text-[10px] font-medium text-slate-400 mt-0.5">📅 ${dateStr}</p>
									${notesStr}
								</div>
								<div class="text-right">
									<span class="text-xs font-extrabold text-emerald-600">+${Number(l.amount).toLocaleString('hy-AM')} Դրամ</span>
								</div>
							</div>
						`;
					}).join('');
				}

				const armMonths = ['Հնվ', 'Փտր', 'Մրտ', 'Ապր', 'Մյս', 'Հնս', 'Հլս', 'Օգս', 'Սեպ', 'Հոկ', 'Նոյ', 'Դեկ'];
				let labels = [];
				let dataValues = [];
				let subtitleText = '';

				if (range === 'current_month') {
					const year = now.getFullYear();
					const month = now.getMonth();
					const daysInMonth = new Date(year, month + 1, 0).getDate();
					subtitleText = `Օրական (${armMonths[month]} ${year})`;

					for (let day = 1; day <= daysInMonth; day++) {
						labels.push(`${armMonths[month]} ${day}`);
						const daySum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year && d.getMonth() === month && d.getDate() === day) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(daySum);
					}
				} else if (range === 'last_month') {
					const lastMonthDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
					const year = lastMonthDate.getFullYear();
					const month = lastMonthDate.getMonth();
					const daysInMonth = new Date(year, month + 1, 0).getDate();
					subtitleText = `Օրական (${armMonths[month]} ${year})`;

					for (let day = 1; day <= daysInMonth; day++) {
						labels.push(`${armMonths[month]} ${day}`);
						const daySum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year && d.getMonth() === month && d.getDate() === day) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(daySum);
					}
				} else if (range === 'current_year') {
					const year = now.getFullYear();
					subtitleText = `Ամսական (${year})`;

					for (let month = 0; month < 12; month++) {
						labels.push(armMonths[month]);
						const monthSum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year && d.getMonth() === month) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(monthSum);
					}
				} else if (range === 'all') {
					subtitleText = 'Տարեկան (Ընդհանուր)';
					const yearsSet = new Set(allLedger.map(l => new Date(l.created_at).getFullYear()));
					yearsSet.add(now.getFullYear());
					const sortedYears = Array.from(yearsSet).sort((a, b) => a - b);

					sortedYears.forEach(year => {
						labels.push(String(year));
						const yearSum = allLedger.reduce((sum, l) => {
							const d = new Date(l.created_at);
							if (d.getFullYear() === year) {
								return sum + (Number(l.amount) || 0);
							}
							return sum;
						}, 0);
						dataValues.push(yearSum);
					});
				}

				renderFinanceChart(labels, dataValues, subtitleText);
			}

			document.getElementById('finance-range-select')?.addEventListener('change', renderFinancePage);

			function renderProductsList() {
				const container = document.getElementById('products-list-mobile');
				if (!container) return;

				if (!allProducts.length) {
					container.innerHTML = `<div class="p-8 text-center text-slate-400 text-xs">Ապրանքներ չկան</div>`;
					return;
				}

				container.innerHTML = allProducts.map(p => {
					const imgSrc = escapeHtml(p.image || (p.images && p.images[0]) || '/images/products/placeholder.jpg');
					const priceDisplay = p.price ? (p.price.includes('դրամ') ? p.price : (p.price + ' դրամ')) : '';

					return `
						<div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3 shadow-xs">
							<div class="flex items-center gap-3">
								<img src="${imgSrc}" class="h-12 w-12 rounded-xl object-cover border border-slate-100" />
								<div>
									<h4 class="text-xs font-bold text-slate-900">${escapeHtml(p.name || '')}</h4>
									<p class="text-[11px] font-extrabold text-blue-600 mt-0.5">${escapeHtml(priceDisplay)}</p>
								</div>
							</div>

							<div class="flex items-center gap-1.5">
								<a href="/admin/mobile/products/${p.id}/" class="rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700">Խմբագրել</a>
							</div>
						</div>
					`;
				}).join('');
			}

			function renderUsersList() {
				const container = document.getElementById('users-list-mobile');
				if (!container) return;

				if (!allAdminUsers.length) {
					container.innerHTML = `<div class="p-8 text-center text-slate-400 text-xs">Օգտատերեր չկան</div>`;
					return;
				}

				container.innerHTML = allAdminUsers.map(u => {
					const displayName = escapeHtml(u.name || u.username || 'Ադմին');
					const username = escapeHtml(u.username || '');

					return `
						<div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-3.5 shadow-xs">
							<div class="flex items-center gap-3">
								<div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600 font-bold text-xs border border-blue-100">
									${displayName.charAt(0).toUpperCase()}
								</div>
								<div>
									<h4 class="text-xs font-bold text-slate-900">${displayName}</h4>
									<p class="text-[10px] text-slate-500 font-mono">@${username}</p>
								</div>
							</div>
							<div class="flex gap-1.5">
								<button onclick="openEditUserModal('${u.id}', '${displayName}', '${username}')" class="rounded-xl bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">Խմբագրել</button>
							</div>
						</div>
					`;
				}).join('');
			}

			// Add Manual Order Drawer Action
			document.getElementById('add-order-btn')?.addEventListener('click', () => {
				const prodSelect = document.getElementById('new-order-product');
				if (prodSelect) {
					prodSelect.innerHTML = '<option value="">-- Առանց ապրանքի --</option>' +
						allProducts.map(p => `<option value="${p.id}" data-name="${escapeHtml(p.name)}">${escapeHtml(p.name)}</option>`).join('');
				}

				document.getElementById('new-order-firstname').value = '';
				document.getElementById('new-order-lastname').value = '';
				document.getElementById('new-order-phone').value = '';
				document.getElementById('new-order-problem').value = '';
				document.getElementById('drawer-add-order').classList.remove('hidden');
			});

			document.getElementById('form-add-order-drawer')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const firstname = document.getElementById('new-order-firstname').value.trim();
				const lastname = document.getElementById('new-order-lastname').value.trim();
				const phone = document.getElementById('new-order-phone').value.trim();
				const problem = document.getElementById('new-order-problem').value.trim();

				const prodSelect = document.getElementById('new-order-product');
				const selectedOpt = prodSelect ? prodSelect.selectedOptions[0] : null;
				const productId = selectedOpt && selectedOpt.value ? Number(selectedOpt.value) : null;
				const productName = selectedOpt && selectedOpt.value ? selectedOpt.getAttribute('data-name') : null;

				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.insert([{
							first_name: firstname,
							last_name: lastname,
							phone: phone,
							problem_description: problem,
							product_id: productId,
							product_name: productName,
							status: 'new'
						}]);

					if (error) throw error;

					alert('Պատվերը հաջողությամբ ավելացվեց։');
					closeDrawer('drawer-add-order');
					fetchOrders();
				} catch (err) {
					alert('Պատվերի ավելացման սխալ: ' + (err.message || err));
				}
			});

			document.getElementById('logout-btn')?.addEventListener('click', async () => {
				await window.supabaseClient.auth.signOut();
				window.location.href = '/admin/mobile/login/';
			});

			initAuth();
		</script>
	</body>
</html>
