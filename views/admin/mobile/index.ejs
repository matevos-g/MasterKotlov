<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-50 text-slate-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<title>MasterKotlov Admin</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Armenian:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="/supabase-config.js"></script>
		<!-- PWA Manifest & iOS Standalone Meta Tags -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="MasterKotlov" />
		<link rel="apple-touch-icon" href="/images/icon.svg" />
		<meta name="theme-color" content="#2563eb" />
		<style>
			html, body {
				min-height: 100vh;
				min-height: 100dvh;
				background-color: #f8fafc;
			}
			body { font-family: 'Inter', 'Noto Sans Armenian', sans-serif; }
			.mobile-nav-item.active { color: #2563eb; }
			.mobile-nav-item.active svg { stroke: #2563eb; fill: rgba(37, 99, 235, 0.1); }
		</style>
	</head>
	<body class="min-h-screen min-h-[100dvh] flex flex-col bg-slate-50 selection:bg-blue-100 overflow-x-hidden">

		<!-- ========================================== -->
		<!-- MAIN CONTENT AREA                          -->
		<!-- ========================================== -->
		<main class="w-full flex-1 px-4 pb-32" style="padding-top: max(36px, calc(env(safe-area-inset-top) + 24px));">

			<!-- NOTIFICATION PERMISSION BANNER FOR MOBILE / IOS -->
			<div id="notif-permission-banner" class="hidden mb-4 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 p-4 text-white shadow-md transition-all">
				<div class="flex items-center justify-between gap-3">
					<div class="flex items-center gap-3">
						<span class="text-2xl">🔔</span>
						<div>
							<h4 class="text-sm font-extrabold">Միացրեք Ծանուցումները</h4>
							<p class="text-xs text-amber-100 font-medium">Նոր պատվերներ ստանալիս ակնթարթային ազդանշան ստանալու համար։</p>
						</div>
					</div>
					<button onclick="enableNotificationsFromBanner()" class="shrink-0 rounded-xl bg-white px-4 py-2 text-xs font-extrabold text-amber-800 shadow-sm hover:bg-amber-50 active:scale-95 transition">
						Միացնել
					</button>
				</div>
			</div>

			<!-- PAGE 1: ORDERS (ՊԱՏՎԵՐՆԵՐ) -->
			<section id="page-orders" class="space-y-4">
				<!-- Top Bar: Status Picker Dropdown + Refresh Button + '+' SVG Add Order Button -->
				<div class="flex items-center justify-between gap-2.5 pb-3 border-b border-slate-200">
					<select id="order-status-select" class="flex-1 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-base font-bold text-slate-900 outline-none focus:border-blue-600 shadow-xs transition cursor-pointer">
						<option value="new">Սպասող</option>
						<option value="in_progress">Ընթացքի մեջ</option>
						<option value="completed">Ավարտված</option>
						<option value="cancelled">Չեղարկված</option>
					</select>

					<button id="refresh-orders-btn" type="button" onclick="refreshMobileOrders(this)" class="h-12 w-12 shrink-0 flex items-center justify-center rounded-2xl bg-white border border-slate-200 text-slate-700 shadow-xs hover:bg-slate-50 active:scale-95 transition" title="Թարմացնել">
						<svg id="refresh-icon-svg" class="h-6 w-6 stroke-[2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
						</svg>
					</button>

					<button id="add-order-btn" type="button" class="h-12 w-12 shrink-0 flex items-center justify-center rounded-2xl bg-blue-600 text-white shadow-md hover:bg-blue-700 active:scale-95 transition" title="Ավելացնել Պատվեր">
						<svg class="h-6 w-6 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
						</svg>
					</button>
				</div>

				<!-- Orders Cards Grid List for Mobile (1 item per row) -->
				<div id="orders-list-mobile" class="space-y-3">
					<div class="p-8 text-center text-slate-400 text-sm">Բեռնվում է...</div>
				</div>
			</section>

			<!-- PAGE 2: FINANCE (ՖԻՆԱՆՍՆԵՐ) -->
			<section id="page-finance" class="hidden space-y-6">
				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-5 text-center">
					<!-- NO "Ժամանակահատված:" WORD - ONLY THE MONTH SELECT DROPDOWN -->
					<div class="flex items-center justify-center border-b border-slate-100 pb-4">
						<select id="finance-range-select" class="w-full max-w-xs rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold text-slate-800 outline-none focus:border-blue-600">
							<option value="current_month">Այս Ամիս</option>
							<option value="last_month">Անցյալ Ամիս</option>
							<option value="current_year">Այս Տարի</option>
							<option value="all">Ամբողջ Ժամանակահատվածը</option>
						</select>
					</div>

					<!-- Big Number at Center ONLY (No Diagram) -->
					<div class="py-6">
						<span class="text-xs font-extrabold uppercase tracking-widest text-slate-400 block mb-2">Ընդհանուր Եկամուտ</span>
						<div class="text-4xl sm:text-5xl font-extrabold text-blue-600 tracking-tight" id="total-earnings-display">
							0 Դրամ
						</div>
					</div>
				</div>

				<div class="space-y-3">
					<h3 class="text-sm font-extrabold uppercase tracking-wider text-slate-600">Վերջին 10 Գործարքները</h3>
					<div id="ledger-list-mobile" class="space-y-2.5">
						<div class="p-8 text-center text-slate-400 text-sm">Գործարքներ չկան</div>
					</div>
				</div>
			</section>

			<!-- PAGE 3: PRODUCTS (ԱՊՐԱՆՔՆԵՐ) -->
			<section id="page-products" class="hidden space-y-4">
				<div class="flex items-center justify-between border-b border-slate-200 pb-3">
					<h2 class="text-lg font-bold text-slate-900">Ապրանքներ</h2>
					<button onclick="openNewProductSlide()" type="button" class="rounded-2xl bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 active:scale-95 transition">
						+ Ավելացնել Ապրանք
					</button>
				</div>

				<div id="products-list-mobile" class="grid grid-cols-1 gap-3">
					<div class="p-8 text-center text-slate-400 text-sm">Բեռնվում է...</div>
				</div>
			</section>

		</main>

		<!-- ========================================== -->
		<!-- BOTTOM APP NAVBAR                          -->
		<!-- ========================================== -->
		<nav class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/80 shadow-lg" style="padding-bottom: max(16px, env(safe-area-inset-bottom));">
			<div class="grid grid-cols-4 items-center h-16 max-w-md mx-auto px-2">
				<!-- Tab 1: Orders -->
				<button id="mobile-nav-orders" type="button" class="mobile-nav-item active flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
					</svg>
					<span class="text-xs font-bold tracking-tight">Պատվերներ</span>
				</button>

				<!-- Tab 2: Finance -->
				<button id="mobile-nav-finance" type="button" class="mobile-nav-item flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<span class="text-xs font-bold tracking-tight">Ֆինանսներ</span>
				</button>

				<!-- Tab 3: Products -->
				<button id="mobile-nav-products" type="button" class="mobile-nav-item flex flex-col items-center justify-center gap-1 py-1 text-slate-400 transition">
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
					</svg>
					<span class="text-xs font-bold tracking-tight">Ապրանքներ</span>
				</button>

				<!-- Tab 4: Logout -->
				<button id="mobile-nav-logout" type="button" onclick="handleLogout()" class="mobile-nav-item flex flex-col items-center justify-center gap-1 py-1 text-red-500 transition">
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
					</svg>
					<span class="text-xs font-extrabold tracking-tight">Ելք</span>
				</button>
			</div>
		</nav>

		<!-- ========================================================= -->
		<!-- iOS SWIFT STYLE RIGHT-TO-LEFT SLIDING FULL OVERLAY PAGES  -->
		<!-- ========================================================= -->

		<!-- SLIDE PAGE 1: ORDER DETAILS (ONE INFO PER ROW - BIGGER TEXT) -->
		<div id="slide-page-order-details" class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 ease-in-out bg-white overflow-y-auto flex flex-col justify-between">
			<!-- iOS Navigation Bar -->
			<div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white/95 backdrop-blur-md px-4 py-3" style="padding-top: max(24px, calc(env(safe-area-inset-top) + 16px));">
				<button onclick="closeSlidePage('slide-page-order-details')" class="flex items-center gap-1 text-base font-bold text-blue-600 hover:text-blue-700 active:scale-95 transition">
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
					</svg>
					<span>Հետ</span>
				</button>
				<span class="text-base font-extrabold text-slate-900 tracking-tight">Պատվերի Մանրամասներ</span>
				<div class="w-10"></div>
			</div>

			<!-- ONE INFO PER ROW - BIG TEXT -->
			<div class="flex-1 p-5 sm:p-6 space-y-4">
				<!-- Row 1: Customer Name -->
				<div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 block">Հաճախորդ</span>
					<h2 id="detail-client-name" class="text-2xl font-extrabold text-slate-900 tracking-tight"></h2>
				</div>

				<!-- Row 2: Date & Time -->
				<div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 block">Ամսաթիվ / Ժամ</span>
					<div id="detail-client-date" class="text-lg font-extrabold text-slate-800"></div>
				</div>

				<!-- Row 3: Phone Number -->
				<div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 block">Հեռախոսահամար</span>
					<div id="detail-client-phone" class="text-lg font-extrabold font-mono text-blue-600"></div>
				</div>

				<!-- Row 4: Selected Product (If Any) -->
				<div id="detail-product-box" class="hidden p-4 rounded-2xl bg-blue-50/80 border border-blue-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-blue-500 block">Ընտրված Ապրանք</span>
					<div id="detail-product-name" class="text-base font-extrabold text-blue-900"></div>
				</div>

				<!-- Row 5: Problem Description -->
				<div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 block">Խնդրի Նկարագրություն</span>
					<div id="detail-problem-text" class="text-base leading-relaxed font-semibold text-slate-800 whitespace-pre-wrap"></div>
				</div>

				<!-- Row 6: Status -->
				<div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 block mb-1">Կարգավիճակ</span>
					<div id="detail-status-badge"></div>
				</div>
			</div>

			<!-- Bottom 3 Armenian Buttons -->
			<div id="detail-drawer-actions" class="border-t border-slate-200 bg-slate-50 p-4 flex flex-col gap-3" style="padding-bottom: max(24px, calc(env(safe-area-inset-bottom) + 16px));">
				<!-- Injected dynamically -->
			</div>
		</div>

		<!-- SLIDE PAGE 2: ADD NEW ORDER -->
		<div id="slide-page-add-order" class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 ease-in-out bg-white overflow-y-auto flex flex-col justify-between">
			<!-- iOS Navigation Bar -->
			<div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white/95 backdrop-blur-md px-4 py-3" style="padding-top: max(24px, calc(env(safe-area-inset-top) + 16px));">
				<button onclick="closeSlidePage('slide-page-add-order')" class="flex items-center gap-1 text-base font-bold text-blue-600 hover:text-blue-700 active:scale-95 transition">
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
					</svg>
					<span>Հետ</span>
				</button>
				<span class="text-base font-extrabold text-slate-900 tracking-tight">Ավելացնել Նոր Պատվեր</span>
				<div class="w-10"></div>
			</div>

			<form id="form-add-order-drawer" class="flex-1 p-5 space-y-5" style="padding-bottom: max(32px, calc(env(safe-area-inset-bottom) + 20px));">
				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Անուն *</label>
					<input type="text" id="new-order-firstname" required placeholder="Արմեն" class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 transition" />
				</div>

				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Ազգանուն *</label>
					<input type="text" id="new-order-lastname" required placeholder="Սարգսյան" class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 transition" />
				</div>

				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Հեռախոսահամար *</label>
					<input type="tel" id="new-order-phone" required placeholder="099123456" class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base font-mono text-slate-900 outline-none focus:border-blue-600 transition" />
				</div>

				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Ապրանք (Ընտրովի)</label>
					<select id="new-order-product" class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 bg-white transition">
						<option value="">-- Առանց ապրանքի --</option>
					</select>
				</div>

				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Խնդրի Նկարագրություն *</label>
					<textarea id="new-order-problem" rows="4" required placeholder="Նկարագրեք պատվերը..." class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 resize-none transition"></textarea>
				</div>

				<div class="pt-3">
					<button type="submit" class="w-full rounded-2xl bg-blue-600 py-4 text-base font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition">
						Հաստատել և Ավելացնել Պատվերը
					</button>
				</div>
			</form>
		</div>

		<!-- SLIDE PAGE 3: PRODUCT EDIT / CREATE -->
		<div id="slide-page-product-edit" class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 ease-in-out bg-white overflow-y-auto flex flex-col justify-between">
			<!-- iOS Navigation Bar -->
			<div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white/95 backdrop-blur-md px-4 py-3" style="padding-top: max(24px, calc(env(safe-area-inset-top) + 16px));">
				<button onclick="closeSlidePage('slide-page-product-edit')" class="flex items-center gap-1 text-base font-bold text-blue-600 hover:text-blue-700 active:scale-95 transition">
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
					</svg>
					<span>Հետ</span>
				</button>
				<span class="text-base font-extrabold text-slate-900 tracking-tight" id="prod-edit-title">Խմբագրել Ապրանքը</span>
				<div class="w-10"></div>
			</div>

			<form id="form-product-edit" class="flex-1 p-5 space-y-4" style="padding-bottom: max(32px, calc(env(safe-area-inset-bottom) + 20px));">
				<input type="hidden" id="edit-prod-id" />
				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Անվանում *</label>
					<input type="text" id="edit-prod-name" required placeholder="Հոսքի սենսոր" class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 transition" />
				</div>
				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Գին *</label>
					<input type="text" id="edit-prod-price" required placeholder="18000-25000" class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 transition" />
				</div>
				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Համառոտ Նկարագրություն *</label>
					<textarea id="edit-prod-desk" rows="2" required placeholder="Վերահսկում է ջրի հոսքը..." class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 resize-none transition"></textarea>
				</div>
				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Մանրամասն Նկարագրություն</label>
					<textarea id="edit-prod-description" rows="3" placeholder="Լրացուցիչ տեղեկություններ..." class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 resize-none transition"></textarea>
				</div>
				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Նկարի URL</label>
					<input type="text" id="edit-prod-image" placeholder="/images/products/..." class="w-full rounded-2xl border border-slate-200 px-4 py-3.5 text-base text-slate-900 outline-none focus:border-blue-600 transition" />
				</div>
				<div class="flex items-center gap-2 pt-1">
					<input type="checkbox" id="edit-prod-top" class="h-5 w-5 rounded border-slate-300 text-blue-600" />
					<label for="edit-prod-top" class="text-sm font-bold text-slate-700">Top Product (Գլխավոր Էջում)</label>
				</div>

				<div class="pt-3 flex flex-col gap-3">
					<button type="submit" class="w-full rounded-2xl bg-blue-600 py-4 text-base font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition">
						Պահպանել Փոփոխությունները
					</button>
					<button id="delete-prod-btn" type="button" onclick="deleteCurrentProduct()" class="w-full rounded-2xl bg-red-50 border border-red-200 py-3.5 text-sm font-bold text-red-600 hover:bg-red-100 transition">
						Ջնջել Ապրանքը
					</button>
				</div>
			</form>
		</div>

		<!-- SLIDE PAGE 4: ENTER FINANCE / EARNINGS AMOUNT WHEN COMPLETING ORDER -->
		<div id="slide-page-earnings" class="fixed inset-0 z-50 transform translate-x-full transition-transform duration-300 ease-in-out bg-white overflow-y-auto flex flex-col justify-between">
			<!-- iOS Navigation Bar -->
			<div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-200 bg-white/95 backdrop-blur-md px-4 py-3" style="padding-top: max(24px, calc(env(safe-area-inset-top) + 16px));">
				<button onclick="closeSlidePage('slide-page-earnings')" class="flex items-center gap-1 text-base font-bold text-blue-600 hover:text-blue-700 active:scale-95 transition">
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
					</svg>
					<span>Հետ</span>
				</button>
				<span class="text-base font-extrabold text-slate-900 tracking-tight">Ավարտել Պատվերը</span>
				<div class="w-10"></div>
			</div>

			<form id="form-earnings-drawer" class="flex-1 p-5 space-y-5" style="padding-bottom: max(32px, calc(env(safe-area-inset-bottom) + 20px));">
				<input type="hidden" id="earnings-order-id" />

				<div class="p-4 rounded-2xl bg-blue-50/80 border border-blue-100 space-y-1">
					<span class="text-xs font-extrabold uppercase tracking-wider text-blue-600 block">Պատվերի Հաճախորդ</span>
					<div id="earnings-client-name" class="text-xl font-extrabold text-slate-900"></div>
				</div>

				<div>
					<label class="block text-xs font-extrabold uppercase text-slate-600 mb-1.5">Վաստակած Գումար (Դրամ) *</label>
					<input type="number" id="earnings-amount" min="0" step="1000" required placeholder="25000" class="w-full rounded-2xl border border-slate-200 px-4 py-4 text-xl font-extrabold text-slate-900 outline-none focus:border-blue-600 transition" />
					<p class="text-xs text-slate-400 mt-1.5 font-medium">Մուտքագրեք պատվերից ստացված վերջնական գումարը՝ ֆինանսների բաժնում գրանցելու համար։</p>
				</div>

				<div class="pt-4">
					<button type="submit" class="w-full rounded-2xl bg-emerald-600 py-4 text-base font-bold text-white shadow-md hover:bg-emerald-700 active:scale-95 transition">
						✓ Հաստատել և Գրանցել Ֆինանսներում
					</button>
				</div>
			</form>
		</div>


		<!-- ========================================== -->
		<!-- MODAL: ARE YOU SURE? CONFIRMATION PROMPT    -->
		<!-- ========================================== -->
		<div id="modal-confirm" class="fixed inset-0 z-50 hidden bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-xl border border-slate-200 space-y-4 text-center">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-red-100 text-red-600 text-xl font-bold">!</div>
				<h3 class="text-lg font-bold text-slate-900" id="confirm-modal-title">Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:</h3>
				<p class="text-xs text-slate-500" id="confirm-modal-desc">Այս գործողությունը չի կարող չեղարկվել։</p>
				<div class="flex justify-center gap-3 pt-2">
					<button type="button" onclick="closeModal('modal-confirm')" class="rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-semibold text-slate-700">Ոչ, Չեղարկել</button>
					<button id="confirm-action-btn" type="button" class="rounded-xl bg-red-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm">Այո, Հաստատել</button>
				</div>
			</div>
		</div>

		<!-- CLIENT JS SCRIPT -->
		<script>
			let allOrders = [];
			let allProducts = [];
			let allLedger = [];
			let currentOrderTab = 'new';
			let confirmCallback = null;
			let currentSessionUser = null;

			// Notification & PWA State
			let isInitialOrdersLoad = true;
			const knownOrderIds = new Set();

			// Prevent PWA internal links from opening external browser window
			document.addEventListener('click', function(event) {
				let target = event.target;
				while (target && target.tagName !== 'A') {
					target = target.parentNode;
				}
				if (target && target.hasAttribute('href')) {
					const href = target.getAttribute('href');
					if (href && (href.startsWith('/') || href.includes(window.location.host))) {
						if (!href.startsWith('tel:') && !href.startsWith('mailto:')) {
							event.preventDefault();
							window.location.replace(href);
						}
					}
				}
			}, false);

			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}

			function openSlidePage(id) {
				const el = document.getElementById(id);
				if (el) {
					el.classList.remove('translate-x-full');
					el.classList.add('translate-x-0');
				}
			}

			function closeSlidePage(id) {
				const el = document.getElementById(id);
				if (el) {
					el.classList.remove('translate-x-0');
					el.classList.add('translate-x-full');
				}
			}

			function escapeHtml(str) {
				if (!str) return '';
				return String(str)
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#039;');
			}

			async function initAuth() {
				if (!window.supabaseClient) {
					window.location.replace('/admin/mobile/login/');
					return;
				}
				const { data: { session } } = await window.supabaseClient.auth.getSession();
				if (!session) {
					window.location.replace('/admin/mobile/login/');
					return;
				}
				currentSessionUser = session.user;
				
				requestNotificationPermission();
				loadAllData();
				setupSupabaseRealtime();
			}

			const pages = ['orders', 'finance', 'products'];
			function switchPage(activePage) {
				pages.forEach(p => {
					const el = document.getElementById(`page-${p}`);
					const mobBtn = document.getElementById(`mobile-nav-${p}`);
					if (p === activePage) {
						el?.classList.remove('hidden');
						mobBtn?.classList.add('active');
					} else {
						el?.classList.add('hidden');
						mobBtn?.classList.remove('active');
					}
				});
			}

			pages.forEach(p => {
				document.getElementById(`mobile-nav-${p}`)?.addEventListener('click', () => switchPage(p));
			});

			async function handleLogout() {
				if (window.supabaseClient) await window.supabaseClient.auth.signOut();
				window.location.replace('/admin/mobile/login/');
			}

			async function refreshMobileOrders() {
				const icon = document.getElementById('refresh-icon-svg');
				if (icon) icon.classList.add('animate-spin');
				try {
					await fetchOrders();
				} catch (e) {
					console.warn('Refresh error:', e);
				} finally {
					setTimeout(() => {
						if (icon) icon.classList.remove('animate-spin');
					}, 500);
				}
			}

			document.getElementById('order-status-select')?.addEventListener('change', (e) => {
				currentOrderTab = e.target.value;
				renderOrdersList();
			});

			async function loadAllData() {
				await Promise.all([fetchOrders(), fetchProducts(), fetchLedger()]);
			}

			async function fetchOrders() {
				try {
					const { data, error } = await window.supabaseClient
						.from('service_requests')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error && data) {
						processIncomingOrders(data);
						allOrders = data;
						renderOrdersList();
					}
				} catch (err) {
					console.error('Fetch orders error:', err);
				}
			}

			function processIncomingOrders(orders) {
				if (isInitialOrdersLoad) {
					orders.forEach(o => knownOrderIds.add(o.id));
					isInitialOrdersLoad = false;
					return;
				}

				orders.forEach(o => {
					if (!knownOrderIds.has(o.id)) {
						knownOrderIds.add(o.id);
						if (o.status === 'new') {
							triggerArmenianPushNotification(o);
						}
					}
				});
			}

			function playOrderNotificationSound() {
				try {
					const AudioContext = window.AudioContext || window.webkitAudioContext;
					if (!AudioContext) return;
					const ctx = new AudioContext();
					if (ctx.state === 'suspended') {
						ctx.resume();
					}

					const now = ctx.currentTime;

					// High pleasant 2-tone chime (A5 -> E6)
					const osc1 = ctx.createOscillator();
					const gain1 = ctx.createGain();
					osc1.type = 'sine';
					osc1.frequency.setValueAtTime(880, now);
					gain1.gain.setValueAtTime(0.3, now);
					gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
					osc1.connect(gain1);
					gain1.connect(ctx.destination);
					osc1.start(now);
					osc1.stop(now + 0.3);

					const osc2 = ctx.createOscillator();
					const gain2 = ctx.createGain();
					osc2.type = 'sine';
					osc2.frequency.setValueAtTime(1320, now + 0.15);
					gain2.gain.setValueAtTime(0.4, now + 0.15);
					gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
					osc2.connect(gain2);
					gain2.connect(ctx.destination);
					osc2.start(now + 0.15);
					osc2.stop(now + 0.6);
				} catch (e) {
					console.warn('Audio play error:', e);
				}
			}

			function triggerArmenianPushNotification(order) {
				const clientName = `${order.first_name || ''} ${order.last_name || ''}`.trim() || order.name || order.customer_name || 'Հաճախորդ';
				const title = 'Նոր Պատվեր';
				const body = clientName;

				// Play audio sound on mobile
				playOrderNotificationSound();

				if (navigator.vibrate) {
					try { navigator.vibrate([200, 100, 200, 100, 200]); } catch (e) {}
				}

				if ('Notification' in window && Notification.permission === 'granted') {
					const options = {
						body: body,
						icon: '/images/icon.svg',
						badge: '/images/icon.svg',
						vibrate: [200, 100, 200],
						data: { url: '/admin/mobile/' },
						tag: 'order-' + (order.id || Date.now()),
						renotify: true
					};

					if ('serviceWorker' in navigator) {
						navigator.serviceWorker.getRegistration().then(reg => {
							if (reg && reg.showNotification) {
								reg.showNotification(title, options).catch(() => {});
							}
						}).catch(() => {});
					}
				}
			}

			function checkNotificationBannerState() {
				const banner = document.getElementById('notif-permission-banner');
				if (!banner) return;
				if ('Notification' in window && Notification.permission !== 'granted') {
					banner.classList.remove('hidden');
				} else {
					banner.classList.add('hidden');
				}
			}

			async function enableNotificationsFromBanner() {
				if ('Notification' in window) {
					try {
						const permission = await Notification.requestPermission();
						checkNotificationBannerState();
						if (permission === 'granted') {
							playOrderNotificationSound();
							triggerArmenianPushNotification({
								id: 'test-' + Date.now(),
								first_name: 'Ծանուցումները',
								last_name: 'Միացված են',
								status: 'new'
							});
						} else if (permission === 'denied') {
							alert('Ծանուցումներն արգելված են ձեր հեռախոսի կարգավորումներից։ Խնդրում ենք թույլատրել դրանք Safari/Browser/iOS Settings-ից։');
						}
					} catch (e) {
						console.warn('Notification permission request error:', e);
					}
				} else {
					alert('Ձեր դիտարկիչը չի աջակցում Web Push։ iOS-ում ավելացրեք հավելվածը Home Screen-ում (Add to Home Screen)։');
				}
			}

			async function requestNotificationPermission() {
				checkNotificationBannerState();
				if ('Notification' in window && Notification.permission === 'default') {
					try {
						await Notification.requestPermission();
						checkNotificationBannerState();
					} catch (e) {
						console.warn('Notification permission error:', e);
					}
				}
			}

			// Force prompt check on first touch/click if not already granted
			document.addEventListener('click', function promptNotifPermissionOnce() {
				checkNotificationBannerState();
			}, { once: true });
			document.addEventListener('touchstart', function promptNotifPermissionOnceTouch() {
				checkNotificationBannerState();
			}, { once: true });

			// Poll every 5 seconds so new orders trigger instantly on mobile even if WebSockets drop
			setInterval(() => {
				fetchOrders();
			}, 5000);

			function setupSupabaseRealtime() {
				if (window.supabaseClient) {
					try {
						window.supabaseClient
							.channel('public:service_requests_mobile')
							.on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'service_requests' }, payload => {
								const newOrder = payload.new;
								if (newOrder) {
									if (!knownOrderIds.has(newOrder.id)) {
										knownOrderIds.add(newOrder.id);
										triggerArmenianPushNotification(newOrder);
										fetchOrders();
									}
								}
							})
							.subscribe();
					} catch (e) {
						console.warn('Realtime subscription error:', e);
					}
				}
			}

			async function fetchProducts() {
				try {
					const { data, error } = await window.supabaseClient
						.from('products')
						.select('*')
						.order('id', { ascending: true });

					if (!error && data && data.length) {
						allProducts = data;
					} else {
						const res = await fetch('/api/products.json');
						if (res.ok) allProducts = await res.json();
					}
					renderProductsList();
				} catch (err) {
					console.error('Fetch products error:', err);
				}
			}

			async function fetchLedger() {
				try {
					const { data, error } = await window.supabaseClient
						.from('finance_ledger')
						.select('*')
						.order('created_at', { ascending: false });

					if (!error) {
						allLedger = data || [];
						renderFinancePage();
					}
				} catch (err) {
					console.error('Fetch ledger error:', err);
				}
			}

			function getStatusBadgeHTML(status) {
				const badges = {
					new: '<span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-extrabold text-amber-700 border border-amber-200">Սպասող</span>',
					in_progress: '<span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-extrabold text-blue-700 border border-blue-200">Ընթացքի մեջ</span>',
					completed: '<span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-extrabold text-emerald-700 border border-emerald-200">Ավարտված</span>',
					cancelled: '<span class="rounded-full bg-red-50 px-3 py-1 text-xs font-extrabold text-red-700 border border-red-200">Չեղարկված</span>'
				};
				return badges[status] || status;
			}

			function renderOrdersList() {
				const container = document.getElementById('orders-list-mobile');
				const filtered = allOrders.filter(o => o.status === currentOrderTab);

				if (!filtered.length) {
					container.innerHTML = `
						<div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400 text-sm bg-white font-semibold">
							Այս բաժնում պատվերներ չկան
						</div>
					`;
					return;
				}

				container.innerHTML = filtered.map(o => {
					const d = new Date(o.created_at);
					const dateStr = d.toLocaleDateString('hy-AM', { 
						year: 'numeric', month: '2-digit', day: '2-digit', 
						hour: '2-digit', minute: '2-digit', hour12: false 
					});
					const statusBadge = getStatusBadgeHTML(o.status);
					const fullName = `${escapeHtml(o.first_name || '')} ${escapeHtml(o.last_name || '')}`.trim() || 'Հաճախորդ';

					return `
						<div onclick="openOrderDetailsSlide('${o.id}')" class="group relative flex flex-col justify-between gap-3.5 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs hover:border-blue-300 transition cursor-pointer">
							<div class="flex items-center justify-between">
								<span class="text-base font-extrabold text-slate-900">${fullName}</span>
								${statusBadge}
							</div>
							<div class="flex flex-col gap-1 text-xs font-semibold text-slate-500 pt-2 border-t border-slate-100">
								<span class="text-slate-600">📅 ${dateStr}</span>
								<span class="font-mono text-blue-600 text-sm font-bold">📞 ${escapeHtml(o.phone || '')}</span>
							</div>
						</div>
					`;
				}).join('');
			}

			function openOrderDetailsSlide(orderId) {
				const o = allOrders.find(item => item.id === orderId);
				if (!o) return;

				const d = new Date(o.created_at);
				const dateStr = d.toLocaleDateString('hy-AM', {
					year: 'numeric', month: '2-digit', day: '2-digit',
					hour: '2-digit', minute: '2-digit', hour12: false
				});

				const fullName = `${o.first_name || ''} ${o.last_name || ''}`.trim() || 'Հաճախորդ';
				const cleanPhone = (o.phone || '').replace(/\s+/g, '');

				document.getElementById('detail-client-name').textContent = fullName;
				document.getElementById('detail-client-date').textContent = dateStr;
				document.getElementById('detail-client-phone').textContent = o.phone || '';
				document.getElementById('detail-problem-text').textContent = o.problem_description || 'Նկարագրություն առկա չէ';
				document.getElementById('detail-status-badge').innerHTML = getStatusBadgeHTML(o.status);

				const prodBox = document.getElementById('detail-product-box');
				if (o.product_name) {
					document.getElementById('detail-product-name').textContent = o.product_name;
					prodBox.classList.remove('hidden');
				} else {
					prodBox.classList.add('hidden');
				}

				const actionsContainer = document.getElementById('detail-drawer-actions');
				
				let continueBtnHTML = '';
				if (o.status === 'new') {
					continueBtnHTML = `<button onclick="changeOrderStatus('${o.id}', 'in_progress'); closeSlidePage('slide-page-order-details');" class="w-full rounded-2xl bg-blue-600 py-4 text-base font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>▶</span> <span>Սկսել / Շարունակել</span></button>`;
				} else if (o.status === 'in_progress') {
					continueBtnHTML = `<button onclick="closeSlidePage('slide-page-order-details'); openEarningsSlide('${o.id}');" class="w-full rounded-2xl bg-blue-600 py-4 text-base font-bold text-white shadow-md hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2"><span>✓</span> <span>Ավարտել Պատվերը</span></button>`;
				} else if (o.status === 'completed') {
					continueBtnHTML = `<button disabled class="w-full rounded-2xl bg-slate-100 py-4 text-sm font-bold text-slate-400 cursor-not-allowed">Պատվերն Ավարտված է</button>`;
				} else {
					continueBtnHTML = `<button disabled class="w-full rounded-2xl bg-slate-100 py-4 text-sm font-bold text-slate-400 cursor-not-allowed">Պատվերը Չեղարկված է</button>`;
				}

				let cancelBtnHTML = '';
				if (o.status !== 'cancelled' && o.status !== 'completed') {
					cancelBtnHTML = `<button onclick="promptConfirm('Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:', () => { changeOrderStatus('${o.id}', 'cancelled'); closeSlidePage('slide-page-order-details'); })" class="w-full rounded-2xl bg-red-50 border border-red-200 py-4 text-base font-bold text-red-600 hover:bg-red-100 active:scale-95 transition flex items-center justify-center gap-2"><span>✕</span> <span>Չեղարկել Պատվերը</span></button>`;
				} else {
					cancelBtnHTML = `<button onclick="closeSlidePage('slide-page-order-details')" class="w-full rounded-2xl bg-slate-100 py-4 text-base font-bold text-slate-700 hover:bg-slate-200 transition">Փակել</button>`;
				}

				actionsContainer.innerHTML = `
					<a href="tel:${cleanPhone}" class="w-full text-center rounded-2xl bg-emerald-600 py-4 text-base font-bold text-white shadow-md hover:bg-emerald-700 active:scale-95 transition flex items-center justify-center gap-2">
						<span>📞</span> <span>Զանգահարել Հաճախորդին</span>
					</a>
					${continueBtnHTML}
					${cancelBtnHTML}
				`;

				openSlidePage('slide-page-order-details');
			}

			function closeModal(id) {
				document.getElementById(id)?.classList.add('hidden');
			}

			async function changeOrderStatus(orderId, newStatus) {
				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.update({ status: newStatus })
						.eq('id', orderId);

					if (!error) fetchOrders();
				} catch (err) {
					console.error('Update status error:', err);
				}
			}

			function openEarningsSlide(orderId) {
				const order = allOrders.find(o => o.id === orderId);
				document.getElementById('earnings-order-id').value = orderId;
				document.getElementById('earnings-amount').value = '';
				const fullName = order ? (`${order.first_name || ''} ${order.last_name || ''}`.trim() || 'Հաճախորդ') : 'Հաճախորդ';
				document.getElementById('earnings-client-name').textContent = fullName;
				openSlidePage('slide-page-earnings');
			}

			document.getElementById('form-earnings-drawer')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const submitBtn = e.target.querySelector('button[type="submit"]');
				if (submitBtn) {
					if (submitBtn.disabled) return;
					submitBtn.disabled = true;
					submitBtn.style.opacity = '0.5';
				}

				const orderId = document.getElementById('earnings-order-id').value;
				const amount = Number(document.getElementById('earnings-amount').value);
				const order = allOrders.find(o => o.id === orderId);

				try {
					await window.supabaseClient.from('service_requests').update({ status: 'completed' }).eq('id', orderId);
					await window.supabaseClient.from('finance_ledger').insert([{
						order_id: orderId,
						amount: amount,
						client_name: order ? `${order.first_name || ''} ${order.last_name || ''}`.trim() : 'Հաճախորդ',
						notes: order ? (order.product_name || order.problem_description || '') : ''
					}]);

					closeSlidePage('slide-page-earnings');
					fetchOrders();
					fetchLedger();
				} catch (err) {
					alert('Սխալ պատվերը ավարտելիս');
				} finally {
					if (submitBtn) {
						submitBtn.disabled = false;
						submitBtn.style.opacity = '';
					}
				}
			});

			function promptConfirm(title, onConfirm) {
				document.getElementById('confirm-modal-title').textContent = title || 'Վստա՞հ եք, որ ցանկանում եք չեղարկել պատվերը:';
				confirmCallback = onConfirm;
				document.getElementById('modal-confirm').classList.remove('hidden');
			}

			document.getElementById('confirm-action-btn').addEventListener('click', () => {
				if (confirmCallback) confirmCallback();
				closeModal('modal-confirm');
			});

			// Finance Logic (NO Diagram, ONLY Big Number + Month Filter + Last Transactions)
			function renderFinancePage() {
				const range = document.getElementById('finance-range-select').value;
				const now = new Date();
				let filteredLedger = allLedger;

				if (range === 'current_month') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
					});
				} else if (range === 'last_month') {
					const lastMonthDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getMonth() === lastMonthDate.getMonth() && d.getFullYear() === lastMonthDate.getFullYear();
					});
				} else if (range === 'current_year') {
					filteredLedger = allLedger.filter(l => {
						const d = new Date(l.created_at);
						return d.getFullYear() === now.getFullYear();
					});
				}

				const total = filteredLedger.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
				document.getElementById('total-earnings-display').textContent = `${total.toLocaleString('hy-AM')} Դրամ`;

				const ledgerContainer = document.getElementById('ledger-list-mobile');
				const last10 = filteredLedger.slice(0, 10);

				if (!last10.length) {
					ledgerContainer.innerHTML = `<div class="rounded-2xl border border-dashed border-slate-200 p-8 text-center text-slate-400 text-sm font-semibold bg-white">Գործարքներ չկան</div>`;
				} else {
					ledgerContainer.innerHTML = last10.map(l => {
						const d = new Date(l.created_at);
						const dateStr = d.toLocaleDateString('hy-AM', { 
							year: 'numeric', month: '2-digit', day: '2-digit', 
							hour: '2-digit', minute: '2-digit', hour12: false 
						});
						const notesStr = l.notes ? `<p class="text-xs text-slate-500 mt-1 font-medium">${escapeHtml(l.notes)}</p>` : '';

						return `
							<div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
								<div>
									<h4 class="text-base font-bold text-slate-900">${escapeHtml(l.client_name || 'Հաճախորդ')}</h4>
									<p class="text-xs font-semibold text-slate-400 mt-0.5">📅 ${dateStr}</p>
									${notesStr}
								</div>
								<div class="text-right">
									<span class="text-base font-extrabold text-emerald-600">+${Number(l.amount).toLocaleString('hy-AM')} Դրամ</span>
								</div>
							</div>
						`;
					}).join('');
				}
			}

			document.getElementById('finance-range-select')?.addEventListener('change', renderFinancePage);

			// Products List & Slide Editing
			function renderProductsList() {
				const container = document.getElementById('products-list-mobile');
				if (!container) return;

				if (!allProducts.length) {
					container.innerHTML = `<div class="p-8 text-center text-slate-400 text-sm font-semibold">Ապրանքներ չկան</div>`;
					return;
				}

				container.innerHTML = allProducts.map(p => {
					const imgSrc = escapeHtml(p.image || (p.images && p.images[0]) || '/images/products/placeholder.jpg');
					const priceDisplay = p.price ? (p.price.includes('դրամ') ? p.price : (p.price + ' դրամ')) : '';

					return `
						<div class="flex items-center justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-xs">
							<div class="flex items-center gap-3.5">
								<img src="${imgSrc}" class="h-14 w-14 rounded-2xl object-cover border border-slate-100" />
								<div>
									<h4 class="text-base font-bold text-slate-900">${escapeHtml(p.name || '')}</h4>
									<p class="text-sm font-extrabold text-blue-600 mt-0.5">${escapeHtml(priceDisplay)}</p>
								</div>
							</div>

							<div class="flex items-center gap-1.5">
								<button onclick="openEditProductSlide(${p.id})" type="button" class="rounded-xl bg-slate-100 px-3.5 py-2 text-xs font-bold text-slate-700">Խմբագրել</button>
							</div>
						</div>
					`;
				}).join('');
			}

			function openNewProductSlide() {
				document.getElementById('prod-edit-title').textContent = 'Ավելացնել Ապրանք';
				document.getElementById('edit-prod-id').value = '';
				document.getElementById('edit-prod-name').value = '';
				document.getElementById('edit-prod-price').value = '';
				document.getElementById('edit-prod-desk').value = '';
				document.getElementById('edit-prod-description').value = '';
				document.getElementById('edit-prod-image').value = '';
				document.getElementById('edit-prod-top').checked = false;
				document.getElementById('delete-prod-btn').classList.add('hidden');
				openSlidePage('slide-page-product-edit');
			}

			function openEditProductSlide(id) {
				const p = allProducts.find(item => item.id === id);
				if (!p) return;

				document.getElementById('prod-edit-title').textContent = 'Խմբագրել Ապրանքը';
				document.getElementById('edit-prod-id').value = p.id;
				document.getElementById('edit-prod-name').value = p.name || '';
				document.getElementById('edit-prod-price').value = p.price || '';
				document.getElementById('edit-prod-desk').value = p.desk || '';
				document.getElementById('edit-prod-description').value = p.description || '';
				document.getElementById('edit-prod-image').value = p.image || (p.images && p.images[0]) || '';
				document.getElementById('edit-prod-top').checked = !!p.top;
				document.getElementById('delete-prod-btn').classList.remove('hidden');
				openSlidePage('slide-page-product-edit');
			}

			document.getElementById('form-product-edit')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const submitBtn = e.target.querySelector('button[type="submit"]');
				if (submitBtn) {
					if (submitBtn.disabled) return;
					submitBtn.disabled = true;
					submitBtn.style.opacity = '0.5';
				}

				const id = document.getElementById('edit-prod-id').value;
				const name = document.getElementById('edit-prod-name').value.trim();
				const price = document.getElementById('edit-prod-price').value.trim();
				const desk = document.getElementById('edit-prod-desk').value.trim();
				const description = document.getElementById('edit-prod-description').value.trim();
				const image = document.getElementById('edit-prod-image').value.trim();
				const top = document.getElementById('edit-prod-top').checked;

				const payload = { name, price, desk, description, image, top };

				try {
					if (id) {
						await window.supabaseClient.from('products').update(payload).eq('id', id);
					} else {
						await window.supabaseClient.from('products').insert([payload]);
					}
					closeSlidePage('slide-page-product-edit');
					fetchProducts();
				} catch (err) {
					alert('Ապրանքի պահպանման սխալ: ' + (err.message || err));
				} finally {
					if (submitBtn) {
						submitBtn.disabled = false;
						submitBtn.style.opacity = '';
					}
				}
			});

			async function deleteCurrentProduct() {
				const id = document.getElementById('edit-prod-id').value;
				if (!id) return;
				promptConfirm('Վստա՞հ եք, որ ցանկանում եք ջնջել այս ապրանքը:', async () => {
					try {
						await window.supabaseClient.from('products').delete().eq('id', id);
						closeSlidePage('slide-page-product-edit');
						fetchProducts();
					} catch (err) {
						alert('Ջնջումը ձախողվեց');
					}
				});
			}

			// Add Manual Order Drawer Action
			document.getElementById('add-order-btn')?.addEventListener('click', () => {
				const prodSelect = document.getElementById('new-order-product');
				if (prodSelect) {
					prodSelect.innerHTML = '<option value="">-- Առանց ապրանքի --</option>' +
						allProducts.map(p => `<option value="${p.id}" data-name="${escapeHtml(p.name)}">${escapeHtml(p.name)}</option>`).join('');
				}

				document.getElementById('new-order-firstname').value = '';
				document.getElementById('new-order-lastname').value = '';
				document.getElementById('new-order-phone').value = '';
				document.getElementById('new-order-problem').value = '';
				openSlidePage('slide-page-add-order');
			});

			document.getElementById('form-add-order-drawer')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const submitBtn = e.target.querySelector('button[type="submit"]');
				if (submitBtn) {
					if (submitBtn.disabled) return;
					submitBtn.disabled = true;
					submitBtn.style.opacity = '0.5';
				}

				const firstname = document.getElementById('new-order-firstname').value.trim();
				const lastname = document.getElementById('new-order-lastname').value.trim();
				const phone = document.getElementById('new-order-phone').value.trim();
				const problem = document.getElementById('new-order-problem').value.trim();

				const prodSelect = document.getElementById('new-order-product');
				const selectedOpt = prodSelect ? prodSelect.selectedOptions[0] : null;
				const productId = selectedOpt && selectedOpt.value ? Number(selectedOpt.value) : null;
				const productName = selectedOpt && selectedOpt.value ? selectedOpt.getAttribute('data-name') : null;

				try {
					const { error } = await window.supabaseClient
						.from('service_requests')
						.insert([{
							first_name: firstname,
							last_name: lastname,
							phone: phone,
							problem_description: problem,
							product_id: productId,
							product_name: productName,
							status: 'new'
						}]);

					if (error) throw error;

					alert('Պատվերը հաջողությամբ ավելացվեց։');
					closeSlidePage('slide-page-add-order');
					fetchOrders();
				} catch (err) {
					alert('Պատվերի ավելացման սխալ: ' + (err.message || err));
				} finally {
					if (submitBtn) {
						submitBtn.disabled = false;
						submitBtn.style.opacity = '';
					}
				}
			});

			initAuth();
		</script>
	</body>
</html>
