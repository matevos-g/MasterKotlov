<!DOCTYPE html>
<html lang="hy" class="h-full bg-slate-50">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<title>MasterKotlov - Mobile Admin</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Armenian:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
		<script src="/supabase-config.js"></script>
		<style>
			body { font-family: 'Inter', 'Noto Sans Armenian', sans-serif; }
		</style>
	</head>
	<body class="min-h-full flex flex-col bg-slate-50 text-slate-900 selection:bg-blue-100">
		<!-- Top Safe Area Bar with Title -->
		<header class="w-full text-center py-4" style="padding-top: max(16px, env(safe-area-inset-top));">
			<span class="text-xl font-bold tracking-tight text-slate-900">MasterKotlov</span>
			<span class="ml-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">MOBILE</span>
		</header>

		<!-- Centered Login Form (No Visible Container / Card Box) -->
		<main class="flex-1 flex items-center justify-center px-6 pb-12 w-full max-w-sm mx-auto">
			<form id="admin-login-form" class="w-full space-y-5">
				<div id="login-error" class="hidden rounded-xl bg-red-50 p-3.5 text-xs font-semibold text-red-600 border border-red-100 text-center"></div>

				<div>
					<label for="username" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Օգտանուն</label>
					<input
						id="username"
						name="username"
						type="text"
						autocomplete="username"
						required
						placeholder="admin"
						class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base text-slate-900 placeholder-slate-400 outline-none shadow-xs transition focus:border-blue-600 focus:ring-1 focus:ring-blue-600"
					/>
				</div>

				<div>
					<label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Գաղտնաբառ</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						placeholder="••••••••"
						class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base text-slate-900 placeholder-slate-400 outline-none shadow-xs transition focus:border-blue-600 focus:ring-1 focus:ring-blue-600"
					/>
				</div>

				<button
					type="submit"
					id="login-btn"
					class="w-full rounded-xl bg-blue-600 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-blue-700 active:scale-[0.98] transition"
				>
					Մուտք Գործել
				</button>
			</form>
		</main>

		<!-- Mobile Bottom Navbar is INVISIBLE on login page -->

		<script>
			async function checkSession() {
				if (window.supabaseClient) {
					const { data: { session } } = await window.supabaseClient.auth.getSession();
					if (session) {
						window.location.href = '/admin/mobile/';
					}
				}
			}
			checkSession();

			const form = document.getElementById('admin-login-form');
			const loginError = document.getElementById('login-error');
			const loginBtn = document.getElementById('login-btn');

			function getArmenianAuthErrorMessage(err) {
				if (!err) return 'Սխալ մուտքային տվյալներ։';
				const msg = String(err.message || err).toLowerCase();

				if (msg.includes('invalid login credentials') || msg.includes('invalid_credentials')) {
					return 'Սխալ օգտանուն կամ գաղտնաբառ։';
				}
				if (msg.includes('user not found')) {
					return 'Այս օգտանունով օգտատեր չի գտնվել։';
				}
				if (msg.includes('email not confirmed')) {
					return 'Էլ․ փոստը հաստատված չէ։';
				}
				if (msg.includes('too many requests') || msg.includes('rate limit')) {
					return 'Չափազանց շատ փորձեր։ Խնդրում ենք սպասել 1 րոպե։';
				}
				if (msg.includes('network') || msg.includes('fetch')) {
					return 'Կապի սխալ։ Խնդրում ենք ստուգել ինտերնետ կապը։';
				}
				return 'Սխալ մուտքային տվյալներ։ Խնդրում ենք ստուգել տվյալները։';
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				loginError.classList.add('hidden');
				let userInput = document.getElementById('username').value.trim();
				const password = document.getElementById('password').value.trim();

				let email = userInput;
				if (!email.includes('@')) {
					email = `${email.toLowerCase()}@masterkotlov.am`;
				}

				loginBtn.disabled = true;
				loginBtn.innerText = 'Ստուգվում է...';

				try {
					if (!window.supabaseClient) {
						throw new Error('Supabase-ը կարգավորված չէ։');
					}

					const { data, error } = await window.supabaseClient.auth.signInWithPassword({ email, password });
					if (error) throw error;
					
					window.location.href = '/admin/mobile/';
				} catch (err) {
					loginError.textContent = getArmenianAuthErrorMessage(err);
					loginError.classList.remove('hidden');
				} finally {
					loginBtn.disabled = false;
					loginBtn.innerText = 'Մուտք Գործել';
				}
			});
		</script>
	</body>
</html>
