<!DOCTYPE html>
<html lang="hy">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= config.brandName || 'MasterKotlov' %> - <%= config.brandSubtext || 'Կաթսաների վերանորոգում' %></title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+Armenian:wght@300;400;500;600;700&family=Noto+Serif+Armenian:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<script src="https://cdn.tailwindcss.com"></script>
		<link rel="stylesheet" href="/styles.css" />
	</head>
	<body id="main">
		<%- include('partials/navbar', { config, activePath }) %>

		<div class="mx-auto max-w-7xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
			<section class="reveal grid items-center gap-8 lg:grid-cols-2">
				<div class="panel p-6 sm:p-8">
					<h1 class="mt-4 text-3xl font-bold leading-tight text-slate-900 sm:text-4xl lg:text-5xl">
						<%= config.heroTitle || 'Կաթսաների արագ և անվտանգ վերանորոգում' %>
					</h1>
					<p class="mt-4 text-base leading-relaxed text-slate-700 sm:text-lg">
						<%= config.heroSubtitle || 'Ախտորոշում, վերանորոգում և սեզոնային սպասարկում գազային ու պինդ վառելիքի կաթսաների համար։' %>
					</p>
					<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
						<button class="btn-primary hero-btn" type="button" onclick="openServiceRequestModal()"><%= config.heroCtaText || 'Թողնել Սպասարկման Հայտ' %></button>
						<a class="btn-secondary hero-btn" href="#services"><%= config.heroSecondaryCtaText || 'Տեսնել ծառայությունները' %></a>
					</div>
				</div>
				<div class="reveal delay-1 hidden overflow-hidden rounded-[1.75rem] border border-blue-100 bg-white p-2 shadow-xl sm:block">
					<img
						class="h-[280px] w-full rounded-[1.25rem] object-cover sm:h-[360px] lg:h-[420px]"
						src="<%= config.heroImageUrl || '/parts/1/photo_2026-09-24_22-10-10.jpg' %>"
						alt="Կաթսայի սպասարկում տեղում"
					/>
				</div>
			</section>

			<section class="mt-16" id="products">
				<h2 class="reveal text-2xl font-bold text-slate-900 sm:text-3xl">Ապրանքներ</h2>
				<p class="reveal delay-1 mt-3 max-w-3xl text-slate-700">
					Ընտրված պահեստամասեր և սարքավորումներ, որոնք հաճախ օգտագործվում են սպասարկման ընթացքում։
				</p>
				<% if (topProducts && topProducts.length) { %>
					<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						<% topProducts.forEach((product, index) => { %>
							<%- include('partials/product-card', { product, index }) %>
						<% }) %>
					</div>
				<% } %>
			</section>

			<section class="mt-16" id="services">
				<h2 class="reveal text-2xl font-bold text-slate-900 sm:text-3xl"><%= config.servicesTitle || 'Ամենապահանջված ծառայությունները' %></h2>
				<p class="reveal delay-1 mt-3 max-w-3xl text-slate-700">
					<%= config.servicesSubtitle || 'Աշխատանքը կատարվում է մաքուր և հստակ փուլերով. նախ ախտորոշում, հետո համաձայնեցված վերանորոգում և վերջում փորձարկում։' %>
				</p>
				<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					<article class="service-card reveal delay-1 p-5">
						<img class="h-44 w-full rounded-2xl object-cover" src="<%= config.service1Image || '/parts/1/photo_2026-09-24_22-10-11.jpg' %>" alt="Ախտորոշում" />
						<h3 class="mt-4 text-lg font-semibold text-blue-900"><%= config.service1Title || 'Ախտորոշում և գործարկում' %></h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-700">
							<%= config.service1Desc || 'Ստուգվում է ավտոմատիկան, այրման ռեժիմը և ջերմային արդյունավետությունը, որպեսզի սարքը աշխատի կայուն։' %>
						</p>
					</article>
					<article class="service-card reveal delay-2 p-5">
						<img class="h-44 w-full rounded-2xl object-cover" src="<%= config.service2Image || '/parts/1/photo_2026-09-24_22-10-12.jpg' %>" alt="Գազային կաթսայի վերանորոգում" />
						<h3 class="mt-4 text-lg font-semibold text-blue-900"><%= config.service2Title || 'Գազային կաթսաների վերանորոգում' %></h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-700">
							<%= config.service2Desc || 'Սխալների կոդերի վերացում, հանգույցների փոխարինում և անվտանգության պարամետրերի ճշգրտում։' %>
						</p>
					</article>
					<article class="service-card reveal delay-3 p-5">
						<img class="h-44 w-full rounded-2xl object-cover" src="<%= config.service3Image || '/parts/1/photo_2026-09-24_22-10-13.jpg' %>" alt="Սեզոնային սպասարկում" />
						<h3 class="mt-4 text-lg font-semibold text-blue-900"><%= config.service3Title || 'Սեզոնային սպասարկում' %></h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-700">
							<%= config.service3Desc || 'Ջերմափոխանակիչի մաքրում, քաշի ստուգում և կանխարգելիչ աշխատանքներ մինչև սեզոնի մեկնարկ։' %>
						</p>
					</article>
				</div>
			</section>

			<section class="mt-16" id="parts">
				<h2 class="reveal text-2xl font-bold text-slate-900 sm:text-3xl">Պահեստամասեր</h2>
				<div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
					<img class="reveal delay-1 h-14 w-full rounded-xl bg-white p-3 object-contain" src="/images/brands/brand-01.webp" alt="Բրենդ 1" />
					<img class="reveal delay-2 h-14 w-full rounded-xl bg-white p-3 object-contain" src="/images/brands/brand-02.webp" alt="Բրենդ 2" />
					<img class="reveal delay-3 h-14 w-full rounded-xl bg-white p-3 object-contain" src="/images/brands/brand-03.webp" alt="Բրենդ 3" />
					<img class="reveal delay-1 h-14 w-full rounded-xl bg-white p-3 object-contain" src="/images/brands/brand-04.webp" alt="Բրենդ 4" />
					<img class="reveal delay-2 h-14 w-full rounded-xl bg-white p-3 object-contain" src="/images/brands/brand-05.webp" alt="Բրենդ 5" />
					<img class="reveal delay-3 h-14 w-full rounded-xl bg-white p-3 object-contain" src="/images/brands/brand-06.webp" alt="Բրենդ 6" />
				</div>
			</section>
		</div>

		<footer class="mt-4 bg-gradient-to-br from-slate-900 via-blue-900 to-blue-800" id="footer">
			<div class="mx-auto grid max-w-7xl gap-6 px-4 pb-12 pt-10 text-blue-50 sm:grid-cols-2 sm:px-6 lg:grid-cols-3 lg:px-8">
				<div>
					<h4 class="text-lg font-semibold"><%= config.brandName || 'MasterKotlov' %></h4>
					<p class="mt-2 text-sm leading-relaxed text-blue-100/80">
						<%= config.footerDesc || 'Գազային և էլեկտրական կաթսաների պրոֆեսիոնալ վերանորոգում և սպասարկում Երևանում և հարակից շրջաններում։' %>
					</p>
				</div>
				<div>
					<h4 class="text-lg font-semibold">Կոնտակտներ</h4>
					<p class="mt-2 text-sm text-blue-100/80">Հեռախոս: <%= config.phone %></p>
					<p class="mt-1 text-sm text-blue-100/80">Էլ. փոստ: <%= config.email %></p>
					<p class="mt-1 text-sm text-blue-100/80">Հասցե: <%= config.address %></p>
					<p class="mt-1 text-sm text-blue-100/80">Աշխատանքային ժամեր: <%= config.workingHours %></p>
				</div>
				<div>
					<h4 class="text-lg font-semibold">Ծառայություններ</h4>
					<p class="mt-2 text-sm text-blue-100/80">Ախտորոշում, վերանորոգում, սպասարկում և գործարկման կարգավորում։</p>
				</div>
			</div>
			<div class="mx-auto max-w-7xl px-4 pb-8 text-xs text-blue-100/60 sm:px-6 lg:px-8"><%= config.copyrightText || '© MasterKotlov: Բոլոր իրավունքները պաշտպանված են:' %></div>
		</footer>

		<%- include('partials/call-modal', { config }) %>
		<%- include('partials/service-request-modal') %>
		<script src="/product-carousel.js"></script>
		<script src="/site.js"></script>
	</body>
</html>
