<header class="reveal px-4 pt-6 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<nav class="nav-shell flex flex-wrap items-center justify-between gap-3 rounded-2xl px-4 py-3 sm:px-5" aria-label="Main navigation">
			<a href="/" class="order-1 text-xl font-bold tracking-wide text-slate-900 sm:order-none">BrandName</a>
			<button class="nav-toggle items-center order-2 ml-auto sm:ml-0 sm:order-none" type="button" aria-expanded="false" aria-controls="primary-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<div class="nav-menu hidden flex-col items-start gap-2 text-base sm:flex sm:flex-row sm:items-center sm:gap-2 sm:text-base" id="primary-menu">
				<a class="nav-link <%= activePath === '/' ? 'is-active' : '' %>" href="/#main">Գլխավոր</a>
				<a class="nav-link" href="/#services">Ծառայություններ</a>
				<a class="nav-link <%= activePath === '/products' ? 'is-active' : '' %>" href="/products">Ապրանքներ</a>
				<a class="nav-link" href="/#parts">Պահեստամասեր</a>
			</div>
			<div class="nav-contact hidden w-full flex-col items-center gap-3 sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-2">
				<div class="social-row flex items-center justify-center gap-2">
					<a class="social-link social-link--large" href="#" aria-label="Facebook">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M13.5 8H16V5h-2.5C10.9 5 9 6.9 9 9.5V12H7v3h2v4h3v-4h2.4l.6-3H12V9.5c0-.8.7-1.5 1.5-1.5Z" />
						</svg>
					</a>
					<a class="social-link social-link--large" href="#" aria-label="Instagram">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.8A2.7 2.7 0 0 0 4.8 7.5v9a2.7 2.7 0 0 0 2.7 2.7h9a2.7 2.7 0 0 0 2.7-2.7v-9a2.7 2.7 0 0 0-2.7-2.7h-9Zm9.7 1.4a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm0 1.8a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4Z" />
						</svg>
					</a>
					<a class="social-link social-link--large" href="#" aria-label="Telegram">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M21.2 4.8c.4-.2.8.2.7.6l-3.1 14.7c-.1.4-.6.6-.9.4l-4.6-3.4-2.5 2.4c-.3.3-.8.1-.8-.3v-3.4l8.2-7.4-10 6.1-4.1-1.3c-.5-.2-.6-.8-.1-1L21.2 4.8Z" />
						</svg>
					</a>
				</div>
				<button class="nav-phone w-full text-center text-lg font-semibold sm:ml-2 sm:w-auto sm:text-left sm:text-base" type="button" data-call-modal-open>
					<%= config.phone %>
				</button>
			</div>
		</nav>
	</div>
</header>
