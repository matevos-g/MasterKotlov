<header class="reveal px-4 pt-6 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<nav class="nav-shell flex flex-wrap items-center justify-between gap-3 rounded-2xl px-4 py-3 sm:px-5" aria-label="Main navigation">
			<a href="/" class="order-1 text-xl font-bold tracking-wide text-slate-900 sm:order-none"><%= config.brandName || 'MasterKotlov' %></a>
			<button class="nav-toggle items-center order-2 ml-auto sm:ml-0 sm:order-none" type="button" aria-expanded="false" aria-controls="primary-menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<div class="nav-menu hidden flex-col items-start gap-2 text-base sm:flex sm:flex-row sm:items-center sm:gap-2 sm:text-base" id="primary-menu">
				<a class="nav-link <%= activePath === '/' ? 'is-active' : '' %>" href="/#main"><%= config.navLink1 || 'Գլխավոր' %></a>
				<a class="nav-link" href="/#services"><%= config.navLink2 || 'Ծառայություններ' %></a>
				<a class="nav-link <%= activePath === '/products' ? 'is-active' : '' %>" href="/products"><%= config.navLink3 || 'Ապրանքներ' %></a>
				<a class="nav-link" href="/#parts"><%= config.navLink4 || 'Պահեստամասեր' %></a>
			</div>
			<div class="nav-contact hidden w-full flex-col items-center gap-2 sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-2.5">
				<!-- WhatsApp Link -->
				<a href="<%= config.whatsappUrl || 'https://wa.me/37499331516' %>" target="_blank" rel="noopener" class="w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-xl bg-emerald-50 border border-emerald-200/80 px-3.5 py-2 text-xs sm:text-sm font-bold text-emerald-700 hover:bg-emerald-100 hover:border-emerald-300 transition" aria-label="WhatsApp">
					<svg class="w-4 h-4 fill-emerald-600 shrink-0" viewBox="0 0 24 24">
						<path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.764.459 3.487 1.333 5.004L2 22l5.133-1.343c1.464.798 3.116 1.218 4.874 1.218h.005c5.505 0 9.987-4.479 9.988-9.985 0-2.667-1.037-5.176-2.922-7.062A9.924 9.924 0 0 0 12.012 2zm5.7 13.56c-.244.686-1.42 1.31-1.96 1.391-.497.074-1.144.108-1.841-.115-.425-.136-1.026-.334-1.785-.662-3.14-1.359-5.19-4.542-5.348-4.752-.158-.21-1.282-1.705-1.282-3.253 0-1.547.813-2.31 1.102-2.624.288-.314.629-.393.839-.393.21 0 .42.003.603.012.197.01.459-.074.721.555.263.629.892 2.176.97 2.333.079.158.131.342.026.552-.105.21-.158.341-.315.525-.157.184-.33.407-.472.546-.157.157-.321.328-.138.643.184.315.816 1.346 1.75 2.178 1.202 1.07 2.213 1.403 2.528 1.56.315.158.5.132.682-.078.184-.21.787-.918.997-1.233.21-.315.42-.262.708-.157.288.105 1.837.866 2.152 1.023.315.158.525.236.603.368.079.132.079.763-.165 1.449z"/>
					</svg>
					<span>WhatsApp</span>
				</a>
				<!-- Phone Link -->
				<a href="tel:<%= (config.phone || '+374 99 331516').replace(/\s+/g, '') %>" class="w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-xl bg-slate-100 border border-slate-200 px-3.5 py-2 text-xs sm:text-sm font-bold text-slate-800 hover:bg-slate-200 transition" aria-label="Phone">
					<svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
					</svg>
					<span><%= config.phone || '+374 99 331516' %></span>
				</a>
				<!-- Book Button -->
				<button class="w-full sm:w-auto rounded-xl bg-blue-600 px-4 py-2 text-xs sm:text-sm font-bold text-white shadow-sm hover:bg-blue-700 active:scale-95 transition flex items-center justify-center gap-2" type="button" onclick="if(typeof openServiceRequestModal === 'function'){ openServiceRequestModal(); } else { document.querySelector('[data-call-modal-open]')?.click(); }">
					<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span><%= config.bookButtonText || 'Ամրագրել' %></span>
				</button>
			</div>
		</nav>
	</div>
</header>
