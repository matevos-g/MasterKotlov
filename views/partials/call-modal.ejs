<div class="call-modal" data-call-modal aria-hidden="true">
	<div class="call-modal__backdrop" data-call-modal-close></div>
	<section class="call-modal__panel" role="dialog" aria-modal="true" aria-labelledby="call-modal-title" tabindex="-1">
		<button class="call-modal__close" type="button" aria-label="Փակել" data-call-modal-close>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12 19 6.4 17.6 5 12 10.6 6.4 5Z" />
			</svg>
		</button>
		<p class="text-sm font-semibold uppercase tracking-wide text-blue-700" id="call-modal-title">Զանգահարեք</p>
		<a href="tel:<%= (config.phone || '+374 99 331516').replace(/\s+/g, '') %>" class="mt-3 block text-2xl font-extrabold text-blue-600 hover:text-blue-700 transition"><%= config.phone || '+374 99 331516' %></a>
	</section>
</div>
